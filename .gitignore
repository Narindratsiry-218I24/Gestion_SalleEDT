# .NET Core
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio
.vs/
*.vsp
*.vspx
*.sln
*.csproj.user

# Database files
*.mdf
*.ldf
*.sdf

# Connection strings
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json

# Entity Framework
Migrations/*.sql
Migrations/*.sql??
*.db
*.sqlite
*.sqlite3

# User secrets
secrets.json
*.secrets.json

# Environment files
.env
.env.*
!.env.example

# Node.js / npm
node_modules/
npm-debug.log
package-lock.json
yarn.lock

# Logs
*.log
logs/
LogFiles/

# Publishing
*.nupkg
*.snupkg
*.nuget.*

# Publish profiles
*.pubxml
*.pubxml.user
[pP]ublish/

# Backup files
*.bak
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
*.code-workspace

# Azure Functions
local.settings.json

# Report files
*.rdlc
*.rdl.data
*.rdl.config