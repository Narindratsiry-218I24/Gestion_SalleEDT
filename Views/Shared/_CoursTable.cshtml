@model IEnumerable<Gestion_SalleClasseEDT.Models.Cours>

<div class="bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-300">
            <thead class="text-xs uppercase bg-white/5 text-gray-400">
                <tr>
                    <th scope="col" class="px-6 py-4">Cours / Matière</th>
                    <th scope="col" class="px-6 py-4">Professeur</th>
                    <th scope="col" class="px-6 py-4">Classe</th>
                    <th scope="col" class="px-6 py-4">Progrès & Séances</th>
                    <th scope="col" class="px-6 py-4">Statut</th>
                    <th scope="col" class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var cours in Model)
                {
                    <tr class="border-b border-white/10 hover:bg-white/5 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="font-medium text-white mb-1">@(cours.Matiere?.NomMatiere ?? "N/A")</div>
                            <div class="text-xs text-gray-400 flex items-center gap-1">
                                <span class="px-1.5 py-0.5 rounded-sm bg-white/10 text-gray-300">@cours.TypeCours</span>
                                <span class="px-1.5 py-0.5 rounded-sm bg-blue-500/10 text-blue-300">@cours.Mode</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-full bg-[#17203A] flex items-center justify-center text-xs font-bold text-blue-400">
                                    @(cours.Professeur?.Nom?.FirstOrDefault().ToString() ?? "?")
                                </div>
                                <span>@(cours.Professeur?.Nom ?? "N/A") @(cours.Professeur?.Prenom)</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="font-medium text-gray-200">@(cours.Classe?.NomClasse ?? "N/A")</span>
                                <span class="text-xs text-gray-500">@(cours.Classe?.Filiere?.NomFiliere ?? "")</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col gap-2">
                                <div class="w-full bg-gray-700 rounded-full h-2.5">
                                    <div class="bg-blue-600 h-2.5 rounded-full" style="width: @Math.Round(cours.Progression)%"></div>
                                </div>
                                <span class="text-xs text-gray-400">@cours.RealizedHours h / @cours.VolumeHours h (@Math.Round(cours.Progression)%)</span>
                                
                                @if(cours.NextSeance != null)
                                {
                                    <div class="text-xs text-blue-300 mt-1">
                                        <i data-lucide="calendar" class="w-3 h-3 inline"></i> 
                                        Prochaine: @cours.NextSeance.Date.ToShortDateString() @cours.NextSeance.StartTime.ToString(@"hh\:mm")
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            @{
                                var bgStatut = cours.Statut == "Planifie" || cours.Statut == "EnCours" ? "bg-emerald-500/20 text-emerald-400 border-emerald-500/20" : 
                                              (cours.Statut == "Cree" || cours.Statut == "EnAttente" ? "bg-blue-500/20 text-blue-400 border-blue-500/20" : "bg-gray-500/20 text-gray-400 border-gray-500/20");
                            }
                            <span class="px-2.5 py-1 rounded-full text-xs font-medium border @bgStatut">
                                @cours.Statut
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                <a href="/Home/CourseDetails/@cours.IdCours" class="p-1.5 text-blue-400 hover:text-blue-300 hover:bg-blue-400/10 rounded transition-colors" title="Détails">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </a>
                                <button class="p-1.5 text-blue-400 hover:text-blue-300 hover:bg-blue-400/10 rounded transition-colors" title="Modifier">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                </button>
                                <button class="p-1.5 text-red-400 hover:text-red-300 hover:bg-red-400/10 rounded transition-colors" title="Supprimer">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>