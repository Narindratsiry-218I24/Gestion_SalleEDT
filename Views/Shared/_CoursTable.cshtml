@model Gestion_SalleClasseEDT.Models.ViewModels.CoursListViewModel

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex-1 flex flex-col">
    <div class="overflow-x-auto flex-1">
        <table class="w-full text-sm text-left text-gray-600">
            <thead class="text-xs uppercase bg-gray-50 text-gray-500 sticky top-0">
                <tr>
                    <th scope="col" class="px-6 py-4 font-bold">Matière</th>
                    <th scope="col" class="px-6 py-4 font-bold">Enseignant</th>
                    <th scope="col" class="px-6 py-4 font-bold">Classe / Parcours</th>
                    <th scope="col" class="px-6 py-4 font-bold">Progression</th>
                    <th scope="col" class="px-6 py-4 font-bold">Statut</th>
                    <th scope="col" class="px-6 py-4 font-bold">Planification</th>
                    <th scope="col" class="px-6 py-4 font-bold text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model?.Cours?.Any() == true)
                {
                    @foreach(var cours in Model.Cours)
                    {
                        var progression = Math.Round(cours.Progression);
                        var badgeStatut = cours.Statut switch
                        {
                            "Planifie" or "EnCours" => "bg-emerald-500/20 text-emerald-600 border-emerald-500/20",
                            "Cree" or "EnAttente" => "bg-blue-500/20 text-blue-600 border-blue-500/20",
                            "Suspendu" => "bg-amber-500/20 text-amber-600 border-amber-500/20",
                            "Termine" or "Archive" => "bg-gray-500/20 text-gray-600 border-gray-500/20",
                            _ => "bg-gray-500/20 text-gray-600 border-gray-500/20"
                        };
                        
                        var isPlanifie = cours.Seances?.Any() == true;
                        var nextSeance = cours.NextSeance;

                        <tr class="hover:bg-gray-50/50 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="font-medium text-[#17203A] mb-0.5">@(cours.Matiere?.NomMatiere ?? "N/A")</div>
                                <div class="text-xs text-gray-400">@(cours.Matiere?.CodeMatiere ?? "")</div>
                            </td>
                            <td class="px-6 py-4">
                                @if (cours.Professeur != null)
                                {
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-[#17203A] flex items-center justify-center text-xs font-bold text-white">
                                            @(cours.Professeur.Nom?.FirstOrDefault().ToString() ?? "?")
                                        </div>
                                        <span>@cours.Professeur.Prenom @cours.Professeur.Nom</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-sm italic">Non assigné</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="font-medium text-gray-700">@(cours.Classe?.NomClasse ?? "Non assignée")</span>
                                    <span class="text-xs text-gray-400">@(cours.Classe?.Filiere?.CodeFiliere ?? "")</span>
                                    @if (!string.IsNullOrEmpty(cours.Groupe))
                                    {
                                        <span class="text-xs text-blue-600">Groupe: @cours.Groupe</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-1.5 min-w-[120px]">
                                    <div class="w-full bg-gray-200 rounded-full h-2.5">
                                        <div class="h-2.5 rounded-full transition-all duration-500 @(progression >= 80 ? "bg-emerald-500" : progression >= 50 ? "bg-blue-500" : "bg-amber-500")" 
                                             style="width: @progression%"></div>
                                    </div>
                                    <div class="flex justify-between text-xs text-gray-500">
                                        <span>@cours.RealizedHours h</span>
                                        <span>/ @cours.VolumeHours h</span>
                                        <span class="font-medium text-[#17203A]">@progression%</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 rounded-full text-xs font-medium border @badgeStatut">
                                    @cours.Statut
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                @if (isPlanifie)
                                {
                                    <div class="flex flex-col gap-1">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-600 border-emerald-500/20 inline-flex items-center gap-1">
                                            <i data-lucide="check-circle" class="w-3 h-3"></i> Planifié
                                        </span>
                                        @if (nextSeance != null)
                                        {
                                            <span class="text-xs text-gray-500">
                                                <i data-lucide="calendar" class="w-3 h-3 inline"></i>
                                                @nextSeance.Date.ToShortDateString() @nextSeance.StartTime.ToString(@"hh\:mm")
                                            </span>
                                            <span class="text-xs text-gray-400">@(nextSeance.Salle?.NomSalle ?? "Salle N/A")</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-600 border-amber-500/20 inline-flex items-center gap-1">
                                        <i data-lucide="clock" class="w-3 h-3"></i> Non planifié
                                    </span>
                                    <div class="mt-1">
                                        <button onclick="openPlanificationModal(@cours.IdCours)" 
                                                class="text-xs text-blue-600 hover:text-blue-800 font-medium transition-colors">
                                            📅 Planifier
                                        </button>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a href="@Url.Action("CourseDetails", new { id = cours.IdCours })" 
                                       class="p-1.5 text-blue-600 hover:bg-blue-50 rounded transition-colors" 
                                       title="Détails">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                    @if (!isPlanifie)
                                    {
                                        <button onclick="openPlanificationModal(@cours.IdCours)" 
                                                class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded transition-colors" 
                                                title="Planifier">
                                            <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                                        </button>
                                    }
                                    <button class="p-1.5 text-red-600 hover:bg-red-50 rounded transition-colors" 
                                            onclick="if(confirm('Supprimer ce cours ?')) deleteCours(@cours.IdCours)" 
                                            title="Supprimer">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-12 text-gray-500">
                            <div class="flex flex-col items-center gap-3">
                                <i data-lucide="inbox" class="w-12 h-12 text-gray-300"></i>
                                <span>Aucun cours trouvé</span>
                                <span class="text-sm text-gray-400">Ajustez vos filtres ou créez un nouveau cours</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model != null && Model.TotalItems > 0)
    {
        <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-gray-50/50">
            <div class="text-sm text-gray-500">
                Affichage de <span class="font-medium">@Math.Min((Model.CurrentPage - 1) * Model.PageSize + 1, Model.TotalItems)</span> 
                à <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)</span> 
                sur <span class="font-medium">@Model.TotalItems</span> cours
            </div>
            <div class="flex items-center gap-2">
                <a href="@Url.Action("Cours", new { 
                    mention = Model.FilterMention, 
                    niveau = Model.FilterNiveau,
                    parcours = Model.FilterParcours,
                    search = Model.SearchTerm,
                    statut = Model.FilterStatut,
                    page = Model.CurrentPage - 1,
                    pageSize = Model.PageSize
                })" 
                   class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-medium @(Model.HasPreviousPage ? "text-gray-700 hover:bg-gray-50" : "text-gray-300 cursor-not-allowed") transition-colors"
                   onclick="@(Model.HasPreviousPage ? "" : "return false;")">
                    <i data-lucide="chevron-left" class="w-4 h-4 inline"></i> Précédent
                </a>
                <span class="text-sm font-medium text-gray-700">Page @Model.CurrentPage / @Model.TotalPages</span>
                <a href="@Url.Action("Cours", new { 
                    mention = Model.FilterMention, 
                    niveau = Model.FilterNiveau,
                    parcours = Model.FilterParcours,
                    search = Model.SearchTerm,
                    statut = Model.FilterStatut,
                    page = Model.CurrentPage + 1,
                    pageSize = Model.PageSize
                })" 
                   class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-medium @(Model.HasNextPage ? "text-gray-700 hover:bg-gray-50" : "text-gray-300 cursor-not-allowed") transition-colors"
                   onclick="@(Model.HasNextPage ? "" : "return false;")">
                    Suivant <i data-lucide="chevron-right" class="w-4 h-4 inline"></i>
                </a>
                <select onchange="location.href='@Url.Action("Cours")?pageSize=' + this.value + '&mention=@Model.FilterMention&niveau=@Model.FilterNiveau&parcours=@Model.FilterParcours&search=@Model.SearchTerm&statut=@Model.FilterStatut'" 
                        class="border border-gray-300 rounded-md text-sm h-9 px-2 bg-white focus:outline-none focus:ring-2 focus:ring-[#17203A]/20">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
            </div>
        </div>
    }
</div>

<!-- Modal de planification -->
<div id="planificationModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm">
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 z-10 flex items-center justify-between p-4 border-b bg-white rounded-t-xl">
                <h3 class="text-xl font-bold text-[#17203A]">
                    <i data-lucide="calendar-plus" class="w-5 h-5 inline mr-2 text-indigo-600"></i> Planifier le cours
                </h3>
                <button onclick="closePlanificationModal()" class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="p-6">
                <form id="planificationForm" class="space-y-4">
                    <input type="hidden" id="planCoursId" value="" />
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-500">*</span></label>
                        <input type="date" id="planDate" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Heure début <span class="text-red-500">*</span></label>
                            <input type="time" id="planStartTime" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Heure fin <span class="text-red-500">*</span></label>
                            <input type="time" id="planEndTime" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Salle</label>
                        <select id="planSalleId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            <option value="">Aucune salle</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Enseignant</label>
                        <select id="planProfesseurId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            <option value="">Non assigné</option>
                        </select>
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t">
                        <button type="button" onclick="closePlanificationModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                            Annuler
                        </button>
                        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
                            <i data-lucide="check" class="w-4 h-4 inline mr-1"></i> Planifier
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // --- Planification ---
    let currentCoursId = null;

    async function openPlanificationModal(coursId) {
        currentCoursId = coursId;
        document.getElementById('planCoursId').value = coursId;
        document.getElementById('planificationModal').classList.remove('hidden');
        
        // Charger les salles et professeurs
        await loadPlanificationData();
        
        // Date par défaut : aujourd'hui + 1 jour
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('planDate').value = tomorrow.toISOString().split('T')[0];
    }

    function closePlanificationModal() {
        document.getElementById('planificationModal').classList.add('hidden');
        document.getElementById('planificationForm').reset();
        currentCoursId = null;
    }

    async function loadPlanificationData() {
        try {
            const [salles, professeurs] = await Promise.all([
                fetch('/api/Salle').then(r => r.json()),
                fetch('/api/Professeur').then(r => r.json())
            ]);

            const salleSelect = document.getElementById('planSalleId');
            salleSelect.innerHTML = '<option value="">Aucune salle</option>';
            salles.forEach(s => {
                salleSelect.innerHTML += `<option value="${s.IdSalle}">${s.NomSalle} (Cap: ${s.Capacite})</option>`;
            });

            const profSelect = document.getElementById('planProfesseurId');
            profSelect.innerHTML = '<option value="">Non assigné</option>';
            professeurs.forEach(p => {
                profSelect.innerHTML += `<option value="${p.IdProfesseur}">${p.Prenom} ${p.Nom}</option>`;
            });
        } catch (e) {
            console.error('Erreur chargement données planification:', e);
        }
    }

    // --- Soumission de la planification ---
    document.getElementById('planificationForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const coursId = parseInt(document.getElementById('planCoursId').value);
        const payload = {
            Date: document.getElementById('planDate').value,
            StartTime: document.getElementById('planStartTime').value + ':00',
            EndTime: document.getElementById('planEndTime').value + ':00',
            SalleId: document.getElementById('planSalleId').value ? parseInt(document.getElementById('planSalleId').value) : null,
            ProfesseurId: document.getElementById('planProfesseurId').value ? parseInt(document.getElementById('planProfesseurId').value) : null
        };

        const btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin inline mr-1"></i> Planification...';

        try {
            const response = await fetch(`/Home/PlanifierSeance/${coursId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (response.ok) {
                alert(' Séance planifiée avec succès !');
                window.location.reload();
            } else {
                alert('' + (result.Message || 'Erreur lors de la planification'));
            }
        } catch (err) {
            alert(' Erreur réseau: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="check" class="w-4 h-4 inline mr-1"></i> Planifier';
        }
    });

    // --- Suppression de cours ---
    async function deleteCours(id) {
        try {
            const response = await fetch(`/api/Cours/${id}`, { method: 'DELETE' });
            if (response.ok) {
                window.location.reload();
            } else {
                alert('Erreur lors de la suppression');
            }
        } catch (err) {
            alert('Erreur: ' + err.message);
        }
    }

    // --- Initialisation des icônes ---
    document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>