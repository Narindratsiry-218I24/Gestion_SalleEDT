@{
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var isPublicPage = controller == "home" && (action == "index" || action == "connexion" || action == "inscription");
    var title = ViewBag.Title ?? ViewData["Title"] ?? "Portail Académique";
    var activeAction = action;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - EMIT</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gestion_SalleClasseEDT.styles.css" asp-append-version="true" />
    <script>
        (function () {
            const isPublicPage = @isPublicPage.ToString().ToLowerInvariant();
            if (!isPublicPage && !localStorage.getItem("user")) {
                window.location.replace("/Home/Connexion");
            }
        })();
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="antialiased">
    @if (isPublicPage)
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <div id="dashboardShell" class="min-h-screen bg-[#f8fafc] lg:flex" x-cloak>
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-white/10 bg-[#17203A] text-white transition-transform duration-200 lg:static lg:translate-x-0">
                <div class="mb-4 p-6">
                    <a asp-controller="Home" asp-action="Dashboard" class="flex items-center gap-3 no-underline">
                        <div class="flex h-12 w-20 items-center justify-center rounded-lg bg-white p-2">
                            <img src="~/images/emit-logo.png" asp-append-version="true" alt="EMIT" class="max-h-full max-w-full object-contain" />
                        </div>
                        <div>
                            <h1 class="m-0 text-lg font-bold leading-tight text-white">EMIT</h1>
                            <p class="m-0 text-[10px] uppercase tracking-wider text-white/60">University Management</p>
                        </div>
                    </a>
                </div>

                <nav id="navAdmin" class="flex-1 space-y-1 px-4 hidden">
                    <a asp-controller="Home" asp-action="Dashboard" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "dashboard" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="layout-dashboard" class="h-5 w-5"></i><span>Tableau de bord</span>
                    </a>
                    <a asp-controller="Home" asp-action="EDT" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "edt" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="calendar" class="h-5 w-5"></i><span>Emplois du temps</span>
                    </a>
                    <a asp-controller="Planification" asp-action="Index" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "planification" || activeAction == "planification" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="layout-dashboard" class="h-5 w-5"></i><span>Planification</span>
                    </a>
                    <a asp-controller="Home" asp-action="Salles" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "salles" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="door-open" class="h-5 w-5"></i><span>Salles de classe</span>
                    </a>
                    <a asp-controller="Professeurs" asp-action="Index" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurs" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="users" class="h-5 w-5"></i><span>Enseignants</span>
                    </a>
                    <a asp-controller="Home" asp-action="Structures" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "structures" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="network" class="h-5 w-5"></i><span>Structures</span>
                    </a>
                    <a asp-controller="Home" asp-action="Matieres" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "matieres" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="book-open" class="h-5 w-5"></i><span>Matières</span>
                    </a>
                    <a asp-controller="Home" asp-action="Cours" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "cours" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="clipboard-list" class="h-5 w-5"></i><span>Cours</span>
                    </a>
                    <a asp-controller="Home" asp-action="Requetes" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "requetes" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="clipboard-list" class="h-5 w-5"></i><span>Requêtes</span>
                    </a>
                    <a asp-controller="Home" asp-action="Validation" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "validation" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="check-square" class="h-5 w-5"></i><span>Validation</span>
                    </a>
                </nav>

                <nav id="navProfesseur" class="flex-1 space-y-1 px-4 hidden">
                    <a asp-controller="ProfesseurDashboard" asp-action="Index" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "index" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="layout-dashboard" class="h-5 w-5"></i><span>Espace Enseignant</span>
                    </a>
                    <a asp-controller="ProfesseurDashboard" asp-action="Agenda" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "agenda" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="calendar-range" class="h-5 w-5"></i><span>Mon Agenda</span>
                    </a>
                    <a asp-controller="ProfesseurDashboard" asp-action="MesCours" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "mescours" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="graduation-cap" class="h-5 w-5"></i><span>Mes Cours</span>
                    </a>
                    <a asp-controller="ProfesseurDashboard" asp-action="Calendrier" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "calendrier" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="calendar" class="h-5 w-5"></i><span>Calendrier</span>
                    </a>
                    <a asp-controller="ProfesseurDashboard" asp-action="Disponibilites" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "disponibilites" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="clock-4" class="h-5 w-5"></i><span>Mes Disponibilités</span>
                    </a>
                    <a asp-controller="ProfesseurDashboard" asp-action="MesDemandes" class="nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(controller == "professeurdashboard" && action == "mesdemandes" ? "bg-[#5C8ABF] font-medium text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                        <i data-lucide="list-checks" class="h-5 w-5"></i><span>Mes Demandes</span>
                    </a>
                </nav>

                <div class="space-y-4 px-4 py-6">
                    <a id="newRequestCta" asp-controller="Home" asp-action="Requetes" class="flex w-full items-center justify-start gap-3 rounded-lg bg-[#5C8ABF] px-4 py-3 text-sm font-semibold text-white no-underline transition hover:bg-[#4d7daf]">
                        <i data-lucide="plus" class="h-5 w-5"></i><span id="newRequestCtaText">Nouvelle Requête</span>
                    </a>

                    <div class="space-y-1 border-t border-white/10 pt-4">
                        <a asp-controller="Home" asp-action="Parametres" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-all @(activeAction == "parametres" ? "bg-white/5 text-white" : "text-white/70 hover:bg-white/5 hover:text-white")">
                            <i data-lucide="settings" class="h-5 w-5"></i><span>Paramètres</span>
                        </a>
                        <button id="logoutButton" type="button" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm text-red-400 transition-all hover:bg-red-500/10 hover:text-red-300">
                            <i data-lucide="log-out" class="h-5 w-5"></i><span>Se déconnecter</span>
                        </button>
                    </div>
                </div>
            </aside>

            <div id="sidebarBackdrop" class="fixed inset-0 z-40 hidden bg-slate-900/40 lg:hidden"></div>

            <div class="flex min-h-screen flex-1 flex-col lg:h-screen lg:overflow-hidden">
                <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-gray-200 bg-white px-4 lg:px-8">
                    <div class="flex min-w-0 flex-1 items-center gap-4 lg:gap-8">
                        <button id="menuButton" type="button" class="rounded-lg p-2 text-[#17203A] hover:bg-gray-100 lg:hidden">
                            <i data-lucide="menu" class="h-5 w-5"></i>
                        </button>
                        <h2 class="truncate text-lg font-bold text-[#17203A] lg:text-xl">@title</h2>
                    </div>

                    <div class="flex items-center gap-2 lg:gap-4">
                        <div class="flex items-center gap-2 pl-3 relative">
                            <button id="notifButton" type="button" class="relative rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-[#17203A]">
                                <i data-lucide="bell" class="h-5 w-5"></i>
                                <span id="notifBadge" class="absolute top-1 right-1 hidden h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white"></span>
                            </button>
                            
                            <!-- Dropdown Notifications -->
                            <div id="notifDropdown" class="absolute right-0 top-12 mt-2 w-80 sm:w-96 rounded-xl bg-white shadow-lg ring-1 ring-black ring-opacity-5 hidden z-50 overflow-hidden flex flex-col max-h-[80vh]">
                                <div class="bg-gray-50 px-4 py-3 border-b border-gray-100 flex justify-between items-center">
                                    <h3 class="text-sm font-semibold text-gray-800">Notifications</h3>
                                    <button id="markAllReadBtn" class="text-xs text-[#5C8ABF] hover:text-[#4d7daf] font-medium hidden">Tout marquer comme lu</button>
                                </div>
                                <div id="notifList" class="overflow-y-auto flex-1 p-0">
                                    <div class="p-6 text-center text-gray-500 text-sm">
                                        Chargement...
                                    </div>
                                </div>
                                <div class="bg-gray-50 px-4 py-2 border-t border-gray-100 text-center">
                                    <a href="#" id="viewAllNotifsBtn" class="text-xs font-semibold text-gray-600 hover:text-[#5C8ABF]">Voir toutes les notifications</a>
                                </div>
                            </div>

                            <button type="button" class="hidden rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-[#17203A] sm:block"><i data-lucide="help-circle" class="h-5 w-5"></i></button>
                            <a asp-controller="Home" asp-action="Parametres" class="flex items-center gap-3 rounded-full p-1 no-underline hover:bg-gray-100">
                                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#17203A] text-white">
                                    <i data-lucide="user" class="h-5 w-5"></i>
                                </div>
                                <div class="hidden text-left xl:block">
                                    <p id="userNameLabel" class="m-0 text-sm font-bold text-[#17203A]">Utilisateur</p>
                                    <p id="userEmailLabel" class="m-0 text-xs text-gray-500">connecté</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </header>

                <main class="flex-1 overflow-y-auto p-4 lg:p-8">
                    <div class="mx-auto max-w-7xl space-y-8">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/scroll-animations.js" asp-append-version="true"></script>
    <script src="~/js/scroll-animations.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const shell = document.getElementById("dashboardShell");
            const sidebar = document.getElementById("sidebar");
            const backdrop = document.getElementById("sidebarBackdrop");
            const menuButton = document.getElementById("menuButton");
            const logoutButton = document.getElementById("logoutButton");
            const userRaw = localStorage.getItem("user");

             if (shell) {
                if (!userRaw) {
                    window.location.replace("/Home/Connexion");
                    return;
                }

                try {
                    const user = JSON.parse(userRaw);
                    const fullName = [user.Prenom || user.prenom, user.Nom || user.nom].filter(Boolean).join(" ") || user.Email || user.email || "Utilisateur";
                    const email = user.Email || user.email || "connecté";
                    const role = (user.Role || user.role || "Role").toLowerCase();
                    const userNameLabel = document.getElementById("userNameLabel");
                    if (userNameLabel) userNameLabel.textContent = fullName;
                    const userEmailLabel = document.getElementById("userEmailLabel");
                    if (userEmailLabel) userEmailLabel.textContent = email;
                    const userRoleLabel = document.getElementById("userRoleLabel");
                    if (userRoleLabel) userRoleLabel.textContent = role;

                    if (role === "professeur") {
                        document.getElementById("navProfesseur")?.classList.remove("hidden");
                        document.getElementById("navAdmin")?.classList.add("hidden");
                        
                        const reqLink = document.getElementById("newRequestCta");
                        if (reqLink) {
                            reqLink.setAttribute("href", "/ProfesseurDashboard/NouvelleDemande?email=" + encodeURIComponent(email));
                        }
                        const reqText = document.getElementById("newRequestCtaText");
                        if (reqText) {
                            reqText.textContent = "Nouvelle Demande";
                        }
                        
                        document.querySelectorAll("#navProfesseur a").forEach(link => {
                            const href = link.getAttribute("href");
                            if (href && !href.includes("email=")) {
                                const separator = href.includes("?") ? "&" : "?";
                                link.setAttribute("href", href + separator + "email=" + encodeURIComponent(email));
                            }
                        });
                    } else {
                        document.getElementById("navAdmin")?.classList.remove("hidden");
                        document.getElementById("navProfesseur")?.classList.add("hidden");
                    }
                } catch (e) {
                    console.error("Error parsing user role:", e);
                    localStorage.removeItem("user");
                    window.location.replace("/Home/Connexion");
                    return;
                }

                shell.removeAttribute("x-cloak");
            }

            function closeSidebar() {
                sidebar?.classList.add("-translate-x-full");
                backdrop?.classList.add("hidden");
            }

            menuButton?.addEventListener("click", function () {
                sidebar?.classList.remove("-translate-x-full");
                backdrop?.classList.remove("hidden");
            });
            backdrop?.addEventListener("click", closeSidebar);
            logoutButton?.addEventListener("click", function () {
                localStorage.removeItem("user");
                window.location.href = "/Home/Connexion";
            });

            if (window.lucide) {
                lucide.createIcons();
            }

            // Système de notifications
            if (userRaw && shell && document.getElementById('notifButton')) {
                const user = JSON.parse(userRaw);
                const email = user.Email || user.email;
                if (email && (user.Role || user.role || "").toLowerCase() === "professeur") {
                    
                    const notifBtn = document.getElementById('notifButton');
                    const dropdown = document.getElementById('notifDropdown');
                    const list = document.getElementById('notifList');
                    const badge = document.getElementById('notifBadge');
                    const markAllBtn = document.getElementById('markAllReadBtn');
                    
                    document.getElementById('viewAllNotifsBtn').setAttribute('href', `/ProfesseurDashboard/Notifications?email=${encodeURIComponent(email)}`);

                    // Toggle dropdown
                    notifBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        dropdown.classList.toggle('hidden');
                        if (!dropdown.classList.contains('hidden')) {
                            loadNotifications();
                        }
                    });

                    document.addEventListener('click', (e) => {
                        if (!dropdown.contains(e.target) && !notifBtn.contains(e.target)) {
                            dropdown.classList.add('hidden');
                        }
                    });

                    markAllBtn.addEventListener('click', async (e) => {
                        e.preventDefault();
                        try {
                            await fetch(`/api/Notification/mark-all-read?email=${encodeURIComponent(email)}`, { method: 'POST' });
                            loadNotifications();
                        } catch(err) { console.error(err); }
                    });

                    async function loadNotifications() {
                        try {
                            const res = await fetch(`/api/Notification/unread?email=${encodeURIComponent(email)}`);
                            if (!res.ok) return;
                            const notifs = await res.json();
                            
                            if (notifs.length > 0) {
                                badge.classList.remove('hidden');
                                markAllBtn.classList.remove('hidden');
                            } else {
                                badge.classList.add('hidden');
                                markAllBtn.classList.add('hidden');
                            }

                            if (notifs.length === 0) {
                                list.innerHTML = `<div class="p-6 text-center text-gray-500 text-sm flex flex-col items-center gap-2">
                                    <i data-lucide="check-circle-2" class="w-8 h-8 text-green-400"></i>
                                    Aucune notification
                                </div>`;
                                lucide.createIcons({ root: list });
                                return;
                            }

                            list.innerHTML = '';
                            notifs.forEach(n => {
                                let icon = 'info';
                                let colorClass = 'text-blue-500 bg-blue-50';
                                const t = (n.type || '').toLowerCase();
                                if (t === 'success' || t === 'succes') { icon = 'check-circle'; colorClass = 'text-green-500 bg-green-50'; }
                                else if (t === 'warning') { icon = 'alert-triangle'; colorClass = 'text-orange-500 bg-orange-50'; }
                                else if (t === 'danger' || t === 'erreur') { icon = 'alert-circle'; colorClass = 'text-red-500 bg-red-50'; }

                                const dateStr = new Date(n.dateCreation).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });

                                list.innerHTML += `
                                    <div class="px-4 py-3 border-b border-gray-50 hover:bg-gray-50 transition-colors flex gap-3 relative group">
                                        <div class="mt-1 flex-shrink-0 w-8 h-8 rounded-full ${colorClass} flex items-center justify-center">
                                            <i data-lucide="${icon}" class="w-4 h-4"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-semibold text-gray-800 truncate">${n.titre}</p>
                                            <p class="text-xs text-gray-500 line-clamp-2 mt-0.5">${n.message}</p>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-[10px] text-gray-400 font-medium">${dateStr}</span>
                                                ${n.lien ? `<a href="${n.lien}" class="text-[10px] text-[#5C8ABF] hover:underline font-semibold">Voir le lien</a>` : ''}
                                            </div>
                                        </div>
                                        <button onclick="markNotifRead(${n.idNotification}, event)" class="absolute right-2 top-2 p-1.5 text-gray-400 hover:text-[#5C8ABF] hover:bg-blue-50 rounded opacity-0 group-hover:opacity-100 transition-all" title="Marquer lu">
                                            <i data-lucide="check" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                `;
                            });
                            lucide.createIcons({ root: list });
                        } catch (err) { console.error(err); }
                    }

                    window.markNotifRead = async function(id, event) {
                        event.stopPropagation();
                        try {
                            await fetch(`/api/Notification/mark-read/${id}`, { method: 'POST' });
                            loadNotifications();
                        } catch(err) { console.error(err); }
                    };

                    // Polling toutes les 30 secondes
                    loadNotifications();
                    setInterval(loadNotifications, 30000);
                }
            }
        });
    </script>
    @if (IsSectionDefined("Scripts"))
    {
        @await RenderSectionAsync("Scripts", required: false)
    }
    else if (IsSectionDefined("scripts"))
    {
        @await RenderSectionAsync("scripts", required: false)
    }
</body>
</html>
