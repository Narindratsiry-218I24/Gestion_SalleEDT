@* Partial View pour le formulaire de Matière *@
<form id="matiereForm" class="space-y-3" onsubmit="submitMatiereForm(event)">
    <input type="hidden" id="idMatiere" name="idMatiere" value="0" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Code de la matière -->
        <div>
            <label for="codeMatiere" class="block text-sm font-medium text-gray-700">Code Matière <span class="text-red-500">*</span></label>
            <input type="text" id="codeMatiere" name="codeMatiere" required 
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                   placeholder="Ex: INFO101">
        </div>

        <!-- Nom de la matière -->
        <div>
            <label for="nomMatiere" class="block text-sm font-medium text-gray-700">Nom de la Matière <span class="text-red-500">*</span></label>
            <input type="text" id="nomMatiere" name="nomMatiere" required 
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                   placeholder="Ex: Algorithmique">
        </div>

        <!-- Mention -->
        <div>
            <label for="mentionStatic" class="block text-sm font-medium text-gray-700">Mention <span class="text-red-500">*</span></label>
            <select id="mentionStatic" required 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                    onchange="updateParcoursOptions()">
                <option value="">Sélectionnez une mention</option>
                <option value="Informatique">Informatique</option>
                <option value="Management">Management</option>
                <option value="Multimédia">Multimédia</option>
            </select>
        </div>

        <!-- Niveau -->
        <div>
            <label for="niveauStatic" class="block text-sm font-medium text-gray-700">Niveau <span class="text-red-500">*</span></label>
            <select id="niveauStatic" required 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                    onchange="updateParcoursOptions()">
                <option value="">Sélectionnez un niveau</option>
                <option value="Licence 1">Licence 1</option>
                <option value="Licence 2">Licence 2</option>
                <option value="Licence 3">Licence 3</option>
                <option value="Master 1">Master 1</option>
                <option value="Master 2">Master 2</option>
            </select>
        </div>

        <!-- Parcours (Filière) -->
        <div>
            <label for="idFiliere" class="block text-sm font-medium text-gray-700">Parcours <span class="text-red-500">*</span></label>
            <select id="idFiliere" name="idFiliere" required 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white">
                <option value="">Sélectionnez un parcours</option>
            </select>
        </div>

        <!-- Semestre -->
        <div>
            <label for="idRefSemestre" class="block text-sm font-medium text-gray-700">Semestre <span class="text-red-500">*</span></label>
            <select id="idRefSemestre" name="idRefSemestre" required 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white">
                <option value="">Sélectionnez un semestre</option>
            </select>
        </div>

        <!-- Crédits -->
        <div>
            <label for="credit" class="block text-sm font-medium text-gray-700">Crédits (ECTS) <span class="text-red-500">*</span></label>
            <input type="number" id="credit" name="credit" required min="1" max="30" 
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                   placeholder="Ex: 5">
        </div>

        <!-- Volume Horaire -->
        <div>
            <label for="volumeHoraire" class="block text-sm font-medium text-gray-700">Volume Horaire <span class="text-red-500">*</span></label>
            <input type="number" id="volumeHoraire" name="volumeHoraire" required min="1" 
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white" 
                   placeholder="Ex: 40">
        </div>

        <!-- Professeur Responsable -->
        <div class="md:col-span-2">
            <label for="idProfesseurResponsable" class="block text-sm font-medium text-gray-700">Enseignant Responsable</label>
            <select id="idProfesseurResponsable" name="idProfesseurResponsable" 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-9 px-3 border bg-white">
                <option value="">Sélectionnez un professeur</option>
            </select>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-3 pt-3 mt-3 border-t border-gray-100">
        <button type="button" 
                class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" 
                onclick="closeMatiereModal()">
            Annuler
        </button>
        <button type="submit" 
                class="bg-blue-600 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Enregistrer
        </button>
    </div>
</form>

<script>
    // Configuration des parcours par mention et cycle
    const parcoursConfig = {
        "Informatique": { "Licence": ["DA2I"], "Master": ["M2I", "SDIA", "SIGD"] },
        "Management": { "Licence": ["AES"], "Master": ["AE", "MEAS"] },
        "Multimédia": { "Licence": ["ICM"], "Master": ["RPO", "RCPO"] }
    };

    let filieresList = [];
    let niveauxList = [];
    let semestresList = [];
    let profsList = [];

    async function loadMatiereFormData() {
        try {
            const [filieres, niveaux, semestres, profs] = await Promise.all([
                fetch('/api/Filiere').then(r => r.json()),
                fetch('/api/Niveau').then(r => r.json()),
                fetch('/api/RefSemestre').then(r => r.json()),
                fetch('/api/Professeur').then(r => r.json())
            ]);
            
            filieresList = filieres || [];
            niveauxList = niveaux || [];
            semestresList = semestres || [];
            profsList = profs || [];
            
            // Remplir la liste des professeurs
            const profSelect = document.getElementById('idProfesseurResponsable');
            if (profSelect) {
                profSelect.innerHTML = '<option value="">Sélectionnez un professeur</option>';
                profsList.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.IdProfesseur || p.idProfesseur;
                    const nom = (p.nom || p.NomProfesseur || '');
                    const prenom = (p.prenom || p.PrenomProfesseur || '');
                    opt.textContent = `${prenom} ${nom}`.trim() || 'Professeur';
                    profSelect.appendChild(opt);
                });
            }
        } catch (err) {
            console.warn('Erreur chargement données formulaire:', err);
        }
    }

    function updateParcoursOptions() {
        const mention = document.getElementById('mentionStatic')?.value;
        const niveauVal = document.getElementById('niveauStatic')?.value;
        const selectParcours = document.getElementById('idFiliere');
        const selectSemestre = document.getElementById('idRefSemestre');
        
        if (!selectParcours || !selectSemestre) return;
        
        // Reset Parcours
        selectParcours.innerHTML = '<option value="">Sélectionnez un parcours</option>';
        // Reset Semestre
        selectSemestre.innerHTML = '<option value="">Sélectionnez un semestre</option>';

        if (!mention || !niveauVal) return;

        const cycle = niveauVal.startsWith("Licence") ? "Licence" : "Master";
        const allowedParcours = parcoursConfig[mention] ? parcoursConfig[mention][cycle] || [] : [];

        // Filtrer les filières basées sur allowedParcours
        const allowedParcoursLower = allowedParcours.map(p => p.toLowerCase());
        const filteredFilieres = filieresList.filter(f => {
            const code = (f.codeFiliere || f.CodeFiliere || "").trim().toLowerCase();
            return allowedParcoursLower.includes(code);
        });

        filteredFilieres.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.idFiliere || item.IdFiliere;
            const codeFiliere = item.codeFiliere || item.CodeFiliere || "";
            const nomFiliere = item.nomFiliere || item.NomFiliere || "";
            opt.textContent = `${codeFiliere} - ${nomFiliere}`;
            selectParcours.appendChild(opt);
        });

        // Filtrer semestres basés sur le niveau
        let codeNiveauCherche = "";
        if (niveauVal === "Licence 1") codeNiveauCherche = "L1";
        else if (niveauVal === "Licence 2") codeNiveauCherche = "L2";
        else if (niveauVal === "Licence 3") codeNiveauCherche = "L3";
        else if (niveauVal === "Master 1") codeNiveauCherche = "M1";
        else if (niveauVal === "Master 2") codeNiveauCherche = "M2";

        const niveauObj = niveauxList.find(n => (n.codeNiveau || n.CodeNiveau || "").trim().toUpperCase() === codeNiveauCherche);
        if (niveauObj) {
            const idNiveau = niveauObj.idNiveau || niveauObj.IdNiveau;
            const filteredSemestres = semestresList.filter(s => (s.idNiveau || s.IdNiveau) == idNiveau);
            
            filteredSemestres.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.idRefSemestre || item.IdRefSemestre;
                opt.textContent = item.codeSemestre || item.CodeSemestre || "";
                selectSemestre.appendChild(opt);
            });
        }
    }

    async function submitMatiereForm(event) {
        event.preventDefault();
        
        const formData = {
            IdMatiere: parseInt(document.getElementById('idMatiere').value) || 0,
            CodeMatiere: document.getElementById('codeMatiere').value.trim(),
            NomMatiere: document.getElementById('nomMatiere').value.trim(),
            IdFiliere: parseInt(document.getElementById('idFiliere').value),
            IdRefSemestre: parseInt(document.getElementById('idRefSemestre').value),
            Credit: parseInt(document.getElementById('credit').value) || 0,
            VolumeHoraire: parseInt(document.getElementById('volumeHoraire').value) || 0,
            IdProfesseurResponsable: document.getElementById('idProfesseurResponsable').value ? parseInt(document.getElementById('idProfesseurResponsable').value) : null
        };

        // Validation basique
        if (!formData.CodeMatiere || !formData.NomMatiere || !formData.IdFiliere || !formData.IdRefSemestre) {
            alert('Veuillez remplir tous les champs obligatoires.');
            return;
        }

        try {
            const btn = document.querySelector('#matiereForm button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Enregistrement...';
            }

            let url = '/api/Matiere';
            let method = 'POST';
            
            if (formData.IdMatiere !== 0) {
                url = `/api/Matiere/${formData.IdMatiere}`;
                method = 'PUT';
            }

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            if (response.ok) {
                if (typeof onMatiereSaved === 'function') {
                    onMatiereSaved(await response.json());
                }
                closeMatiereModal();
                // Recharger la liste
                if (typeof loadMatieres === 'function') {
                    loadMatieres();
                }
            } else {
                const error = await response.text();
                alert('Erreur: ' + error);
            }
        } catch (error) {
            alert("Erreur lors de l'enregistrement de la matière : " + error.message);
        } finally {
            const btn = document.querySelector('#matiereForm button[type="submit"]');
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Enregistrer';
            }
        }
    }

    // Initialisation automatique au chargement de la page
    document.addEventListener('DOMContentLoaded', function() {
        loadMatiereFormData();
    });
</script>