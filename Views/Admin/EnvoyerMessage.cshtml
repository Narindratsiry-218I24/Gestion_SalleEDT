@{
    ViewData["Title"] = "Envoyer un message aux professeurs";
    var professeurs = ViewBag.Professeurs as List<Gestion_SalleClasseEDT.Models.Professeur>;
}

<div class="px-4 py-6 max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-[#17203A]">Envoyer une Notification</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded-md">
            <div class="flex items-center">
                <i data-lucide="check-circle" class="text-green-500 w-5 h-5 mr-3"></i>
                <p class="text-green-700">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-md">
            <div class="flex items-center">
                <i data-lucide="alert-circle" class="text-red-500 w-5 h-5 mr-3"></i>
                <p class="text-red-700">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <form asp-action="EnvoyerMessage" method="post" class="p-6">
            <div class="space-y-6">
                
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Destinataires (Professeurs)</label>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 max-h-60 overflow-y-auto">
                        <div class="flex items-center mb-3 pb-2 border-b border-gray-200">
                            <input type="checkbox" id="selectAllProfs" class="rounded text-[#5C8ABF] focus:ring-[#5C8ABF]" />
                            <label for="selectAllProfs" class="ml-2 text-sm font-bold text-gray-800 cursor-pointer">Sélectionner tout</label>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            @if(professeurs != null)
                            {
                                foreach(var prof in professeurs)
                                {
                                    <div class="flex items-center">
                                        <input type="checkbox" name="idsProfesseurs" value="@prof.IdProfesseur" id="prof_@prof.IdProfesseur" class="prof-checkbox rounded text-[#5C8ABF] focus:ring-[#5C8ABF]" />
                                        <label for="prof_@prof.IdProfesseur" class="ml-2 text-sm text-gray-700 cursor-pointer">@prof.Nom @prof.Prenom</label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div>
                    <label for="titre" class="block text-sm font-semibold text-gray-700 mb-2">Titre</label>
                    <input type="text" id="titre" name="titre" required class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#5C8ABF] focus:ring focus:ring-[#5C8ABF] focus:ring-opacity-50" placeholder="Objet du message" />
                </div>

                <div>
                    <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Message</label>
                    <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#5C8ABF] focus:ring focus:ring-[#5C8ABF] focus:ring-opacity-50" placeholder="Saisissez votre message ici..."></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="type" class="block text-sm font-semibold text-gray-700 mb-2">Type d'importance</label>
                        <select id="type" name="type" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#5C8ABF] focus:ring focus:ring-[#5C8ABF] focus:ring-opacity-50">
                            <option value="info">Information (Bleu)</option>
                            <option value="success">Succès (Vert)</option>
                            <option value="warning">Avertissement (Orange)</option>
                            <option value="danger">Urgent / Erreur (Rouge)</option>
                        </select>
                    </div>

                    <div>
                        <label for="lien" class="block text-sm font-semibold text-gray-700 mb-2">Lien (optionnel)</label>
                        <input type="url" id="lien" name="lien" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#5C8ABF] focus:ring focus:ring-[#5C8ABF] focus:ring-opacity-50" placeholder="https://..." />
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="bg-[#5C8ABF] text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-[#4d7daf] transition-colors flex items-center gap-2">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        Envoyer le message
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.lucide) {
                lucide.createIcons();
            }

            const selectAll = document.getElementById('selectAllProfs');
            const checkboxes = document.querySelectorAll('.prof-checkbox');

            selectAll.addEventListener('change', function() {
                checkboxes.forEach(cb => {
                    cb.checked = selectAll.checked;
                });
            });

            checkboxes.forEach(cb => {
                cb.addEventListener('change', function() {
                    const allChecked = Array.from(checkboxes).every(c => c.checked);
                    const someChecked = Array.from(checkboxes).some(c => c.checked);
                    selectAll.checked = allChecked;
                    selectAll.indeterminate = someChecked && !allChecked;
                });
            });
        });
    </script>
}