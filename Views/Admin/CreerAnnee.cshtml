@{
    ViewData["Title"] = "Créer une Année Académique";
}

<div class="container mx-auto p-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-bold text-gray-800">Nouvelle Année Académique (LMD Automatique)</h2>
            <p class="text-sm text-gray-500 mt-1">Génère automatiquement les semestres S1 à S10 et les classes L1, L2, L3, M1, M2 associées aux filières.</p>
        </div>
        
        <div class="p-6">
            <form id="createAnneeForm" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Libellé de l'année <span class="text-red-500">*</span></label>
                        <input type="text" id="libelle" name="libelle" placeholder="ex: 2025-2026" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div class="flex items-end">
                        <div class="flex items-center h-10">
                            <input type="checkbox" id="estActive" name="estActive" checked class="h-5 w-5 text-blue-600 rounded border-gray-300">
                            <label for="estActive" class="ml-3 text-sm font-medium text-gray-700">Définir comme année active</label>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Date de début <span class="text-red-500">*</span></label>
                        <input type="date" id="dateDebut" name="dateDebut" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Date de fin <span class="text-red-500">*</span></label>
                        <input type="date" id="dateFin" name="dateFin" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                </div>

                <div class="bg-blue-50 rounded-lg p-4 border border-blue-100">
                    <h4 class="font-medium text-blue-800 mb-2 flex items-center gap-2">
                        <i data-lucide="info" class="w-5 h-5"></i> Ce qui sera généré :
                    </h4>
                    <ul class="list-disc pl-5 text-sm text-blue-700 space-y-1">
                        <li><strong>10 Semestres</strong> : S1 à S10</li>
                        <li><strong>Classes Licence</strong> : L1, L2, L3 pour les filières Licence (S1 à S6)</li>
                        <li><strong>Classes Master</strong> : M1, M2 pour les filières Master (S7 à S10)</li>
                        <li>Toutes les combinaisons existantes Mention/Filière/Niveau seront créées.</li>
                    </ul>
                </div>

                <div class="flex justify-end pt-4">
                    <button type="button" onclick="history.back()" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 font-medium mr-4 hover:bg-gray-50">Annuler</button>
                    <button type="submit" id="btnSubmit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium shadow-sm transition-colors flex items-center gap-2">
                        <i data-lucide="play" class="w-4 h-4"></i> Générer l'année et les classes
                    </button>
                </div>
            </form>
        </div>
        
        <div id="resultContainer" class="hidden border-t border-gray-200 bg-gray-50 p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Résultat de la génération</h3>
            <div id="resultContent" class="bg-white p-4 rounded-lg border border-gray-200">
                <!-- Result injected here -->
            </div>
            <div class="mt-4 flex justify-end">
                <a href="/Admin/AnneeAcademique" class="px-6 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-900 transition-colors">Retour à la liste</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('createAnneeForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const btnSubmit = document.getElementById('btnSubmit');
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<span class="animate-spin mr-2">⏳</span> Création en cours...';

        const data = {
            Libelle: document.getElementById('libelle').value,
            DateDebut: document.getElementById('dateDebut').value,
            DateFin: document.getElementById('dateFin').value,
            EstActive: document.getElementById('estActive').checked
        };

        try {
            const response = await fetch('/api/AnneeAcademique/CreerComplete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            
            if (response.ok) {
                document.getElementById('createAnneeForm').classList.add('hidden');
                document.getElementById('resultContainer').classList.remove('hidden');
                
                document.getElementById('resultContent').innerHTML = `
                    <div class="flex items-center gap-3 text-green-600 mb-4">
                        <i data-lucide="check-circle" class="w-6 h-6"></i>
                        <span class="font-bold">Opération réussie !</span>
                    </div>
                    <p class="mb-2">${result.message}</p>
                    <div class="grid grid-cols-2 gap-4 mt-4">
                        <div class="bg-gray-100 p-3 rounded text-center">
                            <div class="text-2xl font-bold text-gray-800">${result.semestresCount}</div>
                            <div class="text-xs text-gray-500 uppercase">Semestres</div>
                        </div>
                        <div class="bg-gray-100 p-3 rounded text-center">
                            <div class="text-2xl font-bold text-gray-800">${result.classesCount}</div>
                            <div class="text-xs text-gray-500 uppercase">Classes créées</div>
                        </div>
                    </div>
                `;
                lucide.createIcons();
            } else {
                alert(result || 'Erreur lors de la création');
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i data-lucide="play" class="w-4 h-4 mr-2"></i> Générer l\'année et les classes';
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Erreur serveur');
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i data-lucide="play" class="w-4 h-4 mr-2"></i> Générer l\'année et les classes';
        }
    });
</script>
}