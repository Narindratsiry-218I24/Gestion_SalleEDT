@using System.Text.Json
@model IEnumerable<Gestion_SalleClasseEDT.Models.Professeur>

@{
    ViewData["Title"] = "Liste des professeurs";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-4 flex items-start gap-3 rounded-xl bg-green-50 border border-green-200 px-5 py-4" id="successAlert">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-600 mt-0.5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="text-sm font-semibold text-green-800">Succès</p>
            <p class="text-sm text-green-700">@TempData["SuccessMessage"]</p>
        </div>
        <button onclick="this.closest('#successAlert').remove()" class="text-green-400 hover:text-green-600"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>
}
@if (TempData["EmailError"] != null)
{
    <div class="mb-4 flex items-start gap-3 rounded-xl bg-yellow-50 border border-yellow-200 px-5 py-4" id="emailAlert">
        <i data-lucide="alert-triangle" class="h-5 w-5 text-yellow-600 mt-0.5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="text-sm font-semibold text-yellow-800">Avertissement email</p>
            <p class="text-sm text-yellow-700">@TempData["EmailError"]</p>
        </div>
        <button onclick="this.closest('#emailAlert').remove()" class="text-yellow-400 hover:text-yellow-600"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>
}

<div class="max-w-7xl mx-auto py-8">
    @{
        var profsWithJson = Model.Select(p => new {
            Prof = p,
            JsonData = JsonSerializer.Serialize(new {
                p.IdProfesseur,
                p.Matricule,
                p.Nom,
                p.Prenom,
                p.Email,
                p.Telephone,
                p.TelephonePortable,
                p.Grade,
                p.Specialite,
                p.Statut,
                p.PhotoUrl,
                p.Biographie,
                p.CvUrl,
                Titre = p.Titre,
                DateEmbauche = p.DateEmbauche?.ToString("dd/MM/yyyy"),
                CapaciteHoraireMax = p.CapaciteHoraireMax,
                HeuresEffectuees = p.HeuresEffectuees,
                StatutCompte = p.Utilisateur?.StatutCompte ?? "Aucun compte",
                IdUtilisateur = p.IdUtilisateur
            })
        }).ToList();
    }
    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-[#17203A]">Gestion des Professeurs</h1>
            <p class="text-gray-500 mt-1">Consultez, recherchez et gÃ©rez tous les professeurs de l'Ã©tablissement.</p>
        </div>
        <div class="flex w-full flex-wrap items-center gap-3">
            <div class="relative flex-shrink-0">
                <label for="searchInput" class="sr-only">Rechercher (Nom, Email ou Matricule)</label>
                <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"></i>
                <input type="text" id="searchInput" placeholder="Nom, Email ou Matricule" class="h-10 rounded-md border border-gray-300 pl-10 pr-4 text-sm focus:border-blue-500 focus:ring-blue-500 w-full lg:w-[360px]" />
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
                <label for="specialiteFilter" class="sr-only">Filtrer par spécialité</label>
                <select id="specialiteFilter" class="h-10 rounded-md border border-gray-300 bg-white px-3 text-sm text-gray-700 w-48">
                    <option value="">Toutes les spécialités</option>
                    @foreach (var s in Model.Select(m => m.Specialite).Where(x => !string.IsNullOrEmpty(x)).Distinct()) { <option>@s</option> }
                </select>
                <label for="gradeFilter" class="sr-only">Filtrer par grade</label>
                <select id="gradeFilter" class="h-10 rounded-md border border-gray-300 bg-white px-3 text-sm text-gray-700 w-48">
                    <option value="">Tous les grades</option>
                    @foreach (var g in Model.Select(m => m.Grade).Where(x => !string.IsNullOrEmpty(x)).Distinct()) { <option>@g</option> }
                </select>
                <label for="statusFilter" class="sr-only">Filtrer par statut</label>
                <select id="statusFilter" class="h-10 rounded-md border border-gray-300 bg-white px-3 text-sm text-gray-700 w-48">
                    <option value="">Tous les statuts</option>
                    <option>Actif</option>
                    <option>En congé</option>
                    <option>Inactif</option>
                </select>
            </div>

            <div class="ml-auto flex items-center gap-2">
                <div class="inline-flex overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm" role="tablist" aria-label="View toggle">
                    <button type="button" onclick="toggleView('table')" class="h-10 px-4 text-sm font-medium text-blue-600 bg-blue-50 flex items-center gap-2" id="tableViewBtn" title="Vue Tableau">
                        <i data-lucide="table" class="h-4 w-4"></i> Tableau
                    </button>
                    <button type="button" onclick="toggleView('cards')" class="h-10 px-4 text-sm font-medium text-gray-500 hover:bg-gray-50 flex items-center gap-2" id="cardViewBtn" title="Vue Cartes">
                        <i data-lucide="layout-grid" class="h-4 w-4"></i> Cartes
                    </button>
                </div>

                <button type="button" onclick="applyFilters()" class="h-10 inline-flex items-center justify-center rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" title="Rechercher">
                    <i data-lucide="search" class="h-4 w-4"></i>
                </button>
                <button type="button" onclick="resetFilters()" class="h-10 inline-flex items-center justify-center rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" title="RÃ©initialiser">
                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
                </button>
                <button type="button" onclick="exportCSV()" class="h-10 inline-flex items-center justify-center rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" title="Exporter CSV">
                    <i data-lucide="download" class="h-4 w-4"></i>
                </button>
                <button type="button" onclick="app.exportTablePdf('Professeurs')" class="h-10 inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-red-600 shadow-sm hover:bg-red-50" title="Exporter PDF">
                    <i data-lucide="file-text" class="h-4 w-4"></i> PDF
                </button>
                <button type="button" onclick="app.exportTableExcel('Professeurs')" class="h-10 inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-green-600 shadow-sm hover:bg-green-50" title="Exporter Excel">
                    <i data-lucide="file-spreadsheet" class="h-4 w-4"></i> Excel
                </button>

                <a asp-action="Create" class="h-10 inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-4 text-sm font-medium text-white shadow-sm hover:bg-blue-700" title="Ajouter un professeur">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                </a>
            </div>
        </div>
    </div>

    <div id="noResultsMessage" class="hidden rounded-xl border border-yellow-200 bg-yellow-50 p-6 text-center text-sm text-yellow-700">
        Aucune correspondance trouvÃ©e. Ajustez votre recherche ou vos filtres.
    </div>

    <!-- TABLE VIEW -->
    <div id="tableView" class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 table-fixed">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:80px;">Photo</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:12%;">Matricule</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:22%;">Nom Complet</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:12%;">Grade</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:20%;">SpÃ©cialitÃ©</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:8%;">Statut Prof.</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500" style="width:8%;">Compte</th>
                    <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500" style="width:80px;">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white" id="tableBody">
                @foreach (var p in Model)
                {
                    var profData = JsonSerializer.Serialize(new {
                        p.IdProfesseur,
                        p.Matricule,
                        p.Nom,
                        p.Prenom,
                        p.Email,
                        p.Telephone,
                        p.TelephonePortable,
                        p.Grade,
                                                p.Specialite,
                        p.Statut,
                        p.PhotoUrl,
                        p.Biographie,
                        p.CvUrl,
                        Titre = p.Titre,
                        DateEmbauche = p.DateEmbauche?.ToString("dd/MM/yyyy"),
                        CapaciteHoraireMax = p.CapaciteHoraireMax,
                        HeuresEffectuees = p.HeuresEffectuees,
                        StatutCompte = p.Utilisateur?.StatutCompte ?? "Aucun compte",
                        IdUtilisateur = p.IdUtilisateur
                    });

                    var statusClass = p.Statut == "Actif" ? "bg-green-100 text-green-800" :
                                      p.Statut == "En congÃ©" ? "bg-yellow-100 text-yellow-800" :
                                      "bg-red-100 text-red-800";
                    var statusIcon = p.Statut == "Actif" ? "âœ…" :
                                     p.Statut == "En congÃ©" ? "âš ï¸" :
                                     "âŒ";

                    <tr class="prof-item" data-prof-id="@p.IdProfesseur" data-grade="@(p.Grade?.ToLower() ?? "")" data-status="@(p.Statut?.ToLower() ?? "")" data-specialite="@(p.Specialite ?? "")" data-prof-json='@Html.Raw(profData)' data-search="@(p.Nom + " " + p.Prenom + " " + p.Matricule + " " + p.Email + " " + p.Specialite + " " + p.Grade)">
                        <td class="px-4 py-4 whitespace-nowrap">
                            @if (!string.IsNullOrEmpty(p.PhotoUrl))
                            {
                                <img src="@p.PhotoUrl" alt="Profil de @p.Nom @p.Prenom" class="h-10 w-10 rounded-full object-cover shadow-sm" />
                            }
                            else
                            {
                                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-600">
                                    @(p.Nom.Length > 0 ? p.Nom.Substring(0,1) : "")
                                </div>
                            }
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@p.Matricule</td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-700 truncate">@p.Nom @p.Prenom</td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-700">@p.Grade</td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-700 truncate">@p.Specialite</td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm">
                            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium @statusClass">
                                @statusIcon @p.Statut
                            </span>
                        </td>
                        @{
                            var statutCompte = p.Utilisateur?.StatutCompte ?? "Aucun compte";
                            var compteClass = statutCompte == "Actif" ? "bg-emerald-100 text-emerald-800" :
                                             statutCompte == "EnAttente" ? "bg-blue-100 text-blue-800" :
                                             statutCompte == "Suspendu" ? "bg-orange-100 text-orange-800" :
                                             statutCompte == "Desactive" ? "bg-red-100 text-red-800" :
                                             "bg-gray-100 text-gray-500";
                            var compteIcon = statutCompte == "Actif" ? "âœ…" :
                                            statutCompte == "EnAttente" ? "â³" :
                                            statutCompte == "Suspendu" ? "â›”" :
                                            statutCompte == "Desactive" ? "ðŸš«" : "â€”";
                            var compteLabel = statutCompte == "EnAttente" ? "En attente" : statutCompte;
                        }
                        <td class="px-4 py-4 whitespace-nowrap text-sm">
                            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium @compteClass">
                                @compteIcon @compteLabel
                            </span>
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex justify-end items-center gap-2">
                                <button type="button" onclick="openDetailModal(@p.IdProfesseur)" class="h-8 w-8 flex items-center justify-center rounded-md text-blue-600 hover:bg-blue-50" title="DÃ©tails">
                                    <i data-lucide="eye" class="h-4 w-4" aria-hidden="true"></i>
                                </button>
                                <a asp-action="Edit" asp-route-id="@p.IdProfesseur" class="h-8 w-8 flex items-center justify-center rounded-md text-yellow-600 hover:bg-yellow-50" title="Modifier">
                                    <i data-lucide="edit" class="h-4 w-4" aria-hidden="true"></i>
                                </a>
                                @if (p.Utilisateur != null && statutCompte == "EnAttente")
                                {
                                    <button type="button" onclick="renvoyerEmail(@p.IdProfesseur)" class="h-8 w-8 flex items-center justify-center rounded-md text-indigo-600 hover:bg-indigo-50" title="Renvoyer l'email d'activation">
                                        <i data-lucide="send" class="h-4 w-4" aria-hidden="true"></i>
                                    </button>
                                }
                                @if (p.Utilisateur != null && statutCompte == "Actif")
                                {
                                    <button type="button" onclick="changerStatut(@p.IdProfesseur, 'Suspendu')" class="h-8 w-8 flex items-center justify-center rounded-md text-orange-600 hover:bg-orange-50" title="Suspendre le compte">
                                        <i data-lucide="pause-circle" class="h-4 w-4" aria-hidden="true"></i>
                                    </button>
                                }
                                @if (p.Utilisateur != null && (statutCompte == "Suspendu" || statutCompte == "Desactive"))
                                {
                                    <button type="button" onclick="changerStatut(@p.IdProfesseur, 'Actif')" class="h-8 w-8 flex items-center justify-center rounded-md text-green-600 hover:bg-green-50" title="RÃ©activer le compte">
                                        <i data-lucide="play-circle" class="h-4 w-4" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button" onclick="confirmDelete(@p.IdProfesseur)" class="h-8 w-8 flex items-center justify-center rounded-md text-red-600 hover:bg-red-50" title="Supprimer">
                                    <i data-lucide="trash-2" class="h-4 w-4" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- CARD VIEW -->
    <div id="cardView" class="hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mt-6">
        @foreach (var p in Model)
        {
            var profData = JsonSerializer.Serialize(new {
                p.IdProfesseur, p.Matricule, p.Nom, p.Prenom, p.Email, p.Telephone, p.TelephonePortable,
                p.Grade,  p.Specialite, p.Statut, p.PhotoUrl, p.Biographie, p.CvUrl,
                Titre = p.Titre, DateEmbauche = p.DateEmbauche?.ToString("dd/MM/yyyy"),
                CapaciteHoraireMax = p.CapaciteHoraireMax, HeuresEffectuees = p.HeuresEffectuees
            });

            var statusIcon = p.Statut == "Actif" ? "âœ…" : p.Statut == "En congÃ©" ? "âš ï¸" : "âŒ";

            <div class="prof-card group relative flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:shadow-md" data-prof-id="@p.IdProfesseur" data-grade="@(p.Grade?.ToLower() ?? "")" data-status="@(p.Statut?.ToLower() ?? "")" data-specialite="@(p.Specialite ?? "")" data-prof-json='@Html.Raw(profData)' data-search="@(p.Nom + " " + p.Prenom + " " + p.Matricule + " " + p.Email + " " + p.Specialite + " " + p.Grade)">
                <div class="mb-4 flex items-start justify-between">
                    <div class="relative h-16 w-16 overflow-hidden rounded-full border-2 border-gray-100 bg-gray-50">
                        @if (!string.IsNullOrEmpty(p.PhotoUrl))
                        {
                            <img src="@p.PhotoUrl" alt="" class="h-full w-full object-cover" />
                        }
                        else
                        {
                            <div class="flex h-full w-full items-center justify-center text-xl font-bold text-blue-600 bg-blue-50">
                                @(p.Nom.Length > 0 ? p.Nom.Substring(0,1) : "")
                            </div>
                        }
                    </div>
                    <span class="inline-flex items-center rounded-full bg-gray-50 px-2.5 py-0.5 text-xs font-medium text-gray-600 border border-gray-200">
                        @statusIcon @p.Statut
                    </span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">@p.Nom @p.Prenom</h3>
                    <p class="text-sm font-medium text-blue-600">@p.Titre @p.Grade</p>
                    <p class="mt-1 text-sm text-gray-500">@p.Specialite</p>
                </div>
                <div class="mt-4 flex-1">
                    <p class="text-xs text-gray-400">Matricule: <span class="font-medium text-gray-700">@p.Matricule</span></p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
                    <button type="button" onclick="openDetailModal(@p.IdProfesseur)" class="h-9 inline-flex items-center gap-2 rounded-md border border-gray-200 bg-white px-3 text-sm font-medium text-blue-600 shadow-sm hover:bg-gray-50">
                        <i data-lucide="eye" class="h-4 w-4"></i> DÃ©tails
                    </button>
                    <div class="flex items-center gap-2">
                        <a asp-action="Edit" asp-route-id="@p.IdProfesseur" class="h-9 inline-flex items-center justify-center rounded-md border border-gray-200 bg-white px-3 text-sm text-yellow-600 shadow-sm hover:bg-gray-50" title="Modifier">
                            <i data-lucide="edit" class="h-4 w-4"></i>
                        </a>
                        <button type="button" onclick="confirmDelete(@p.IdProfesseur)" class="h-9 inline-flex items-center justify-center rounded-md border border-gray-200 bg-white px-3 text-sm text-red-600 shadow-sm hover:bg-red-50" title="Supprimer">
                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- DETAIL MODAL -->
<div id="detailModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900/50 p-4 backdrop-blur-sm transition-opacity">
    <div class="flex w-full max-w-5xl max-h-[90vh] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-6 py-4">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                <i data-lucide="user" class="h-5 w-5 text-blue-600"></i> Profil du Professeur
            </h2>
            <button type="button" onclick="closeDetailModal()" class="rounded-full p-2 text-gray-400 hover:bg-gray-200 hover:text-gray-600 transition">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>
        
        <div class="flex-1 overflow-y-auto p-6">
            <div class="grid gap-8 lg:grid-cols-[300px_1fr]">
