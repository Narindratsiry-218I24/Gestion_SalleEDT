<!-- Formulaire cachÃ© pour la suppression -->
<form id="deleteForm" method="post" action="/Professeurs/Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        let currentView = 'table';

        function toggleView(view) {
            currentView = view;
            document.getElementById('tableView').classList.toggle('hidden', view !== 'table');
            document.getElementById('cardView').classList.toggle('hidden', view !== 'cards');
            document.getElementById('tableViewBtn').classList.toggle('bg-blue-50', view === 'table');
            document.getElementById('tableViewBtn').classList.toggle('text-blue-600', view === 'table');
            document.getElementById('cardViewBtn').classList.toggle('bg-blue-50', view === 'cards');
            document.getElementById('cardViewBtn').classList.toggle('text-blue-600', view === 'cards');
            applyFilters();
        }

        function applyFilters() {
            const query = (document.getElementById('searchInput').value || '').toLowerCase();
            const grade = (document.getElementById('gradeFilter').value || '').toLowerCase();
            const status = (document.getElementById('statusFilter').value || '').toLowerCase();
            const spec = (document.getElementById('specialiteFilter').value || '').toLowerCase();

            const tableRows = Array.from(document.querySelectorAll('#tableBody .prof-item'));
            const cards = Array.from(document.querySelectorAll('#cardView .prof-card'));

            function matches(el) {
                const searchData = (el.dataset.search || '').toLowerCase();
                const rowGrade = (el.dataset.grade || '').toLowerCase();
                const rowStatus = (el.dataset.status || '').toLowerCase();
                const rowSpec = (el.dataset.specialite || '').toLowerCase();
                return (!query || searchData.includes(query)) && (!grade || rowGrade === grade) && (!status || rowStatus === status) && (!spec || rowSpec === spec);
            }

            tableRows.forEach(row => row.style.display = matches(row) ? '' : 'none');
            cards.forEach(card => card.style.display = matches(card) ? '' : 'none');

            const visibleCount = (currentView === 'table' ? tableRows : cards).filter(el => el.style.display !== 'none').length;
            document.getElementById('noResultsMessage').classList.toggle('hidden', visibleCount > 0);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('gradeFilter').selectedIndex = 0;
            document.getElementById('statusFilter').selectedIndex = 0;
            document.getElementById('specialiteFilter').selectedIndex = 0;
            applyFilters();
        }

        function openDetailModal(id) {
            const element = Array.from(document.querySelectorAll('[data-prof-id]')).find(el => el.dataset.profId === id.toString());
            if (!element) return;
            const detail = JSON.parse(element.dataset.profJson);

            document.getElementById('modalPhotoContainer').innerHTML = detail.PhotoUrl ? `<img src="${detail.PhotoUrl}" class="h-full w-full object-cover" />` : `<div class="flex h-full w-full items-center justify-center text-4xl font-bold text-blue-600 bg-blue-50">${(detail.Nom || 'P').charAt(0)}</div>`;
            document.getElementById('modalFullNameTitle').textContent = `${detail.Nom || ''} ${detail.Prenom || ''}`.trim();
            document.getElementById('modalFullName').textContent = `${detail.Nom || ''} ${detail.Prenom || ''}`.trim();
            document.getElementById('modalGradeTitle').textContent = `${detail.Titre || ''} ${detail.Grade || ''}`.trim();
            document.getElementById('modalTitre').textContent = detail.Titre || '-';
            document.getElementById('modalMatricule').textContent = detail.Matricule || '-';
            document.getElementById('modalSpecialite').textContent = detail.Specialite || '-';
            document.getElementById('modalEmbauche').textContent = detail.DateEmbauche || '-';
            document.getElementById('modalEmail').textContent = detail.Email || '-';
            document.getElementById('modalTelFixe').textContent = detail.Telephone || '-';
            document.getElementById('modalTelPort').textContent = detail.TelephonePortable || '-';
            document.getElementById('modalBio').textContent = detail.Biographie || 'Aucune biographie renseignée.';
            document.getElementById('modalHeures').textContent = detail.HeuresEffectuees || 0;
            document.getElementById('modalCapacite').textContent = detail.CapaciteHoraireMax || 20;

            const badge = document.getElementById('modalStatusBadge');
            if (detail.Statut === 'Actif') {
                badge.className = 'inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-green-100 text-green-800';
                badge.textContent = '✅ Actif';
            } else if (detail.Statut === 'En congé') {
                badge.className = 'inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-yellow-100 text-yellow-800';
                badge.textContent = '⚠️ En congé';
            } else {
                badge.className = 'inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-red-100 text-red-800';
                badge.textContent = '❌ Inactif';
            }

            const percent = detail.CapaciteHoraireMax > 0 ? Math.min(100, Math.round(((detail.HeuresEffectuees || 0) / detail.CapaciteHoraireMax) * 100)) : 0;
            const progress = document.getElementById('modalProgress');
            progress.style.width = percent + '%';
            progress.style.background = percent > 100 ? '#dc2626' : '#3b82f6';

            document.getElementById('modalCvContainer').innerHTML = detail.CvUrl ? `<a href="${detail.CvUrl}" target="_blank" class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 hover:bg-gray-50 transition"><div class="rounded bg-blue-100 p-2 text-blue-600"><i data-lucide="file-text" class="h-4 w-4"></i></div><div class="flex-1"><p class="text-sm font-medium text-gray-900">Curriculum Vitae</p><p class="text-xs text-gray-500">PDF Document</p></div><i data-lucide="download" class="h-4 w-4 text-gray-400"></i></a>` : `<p class="text-sm text-gray-500 italic">Aucun document joint</p>`;
            document.getElementById('modalEditLink').href = `/Professeurs/Edit/${detail.IdProfesseur}`;
            document.getElementById('modalDeleteBtn').onclick = () => confirmDelete(detail.IdProfesseur);
            document.getElementById('detailModal').classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function confirmDelete(id) {
            if (confirm('Êtes-vous sûr de vouloir supprimer ce professeur ? Cette action est irréversible.')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        function exportCSV() {
            const rows = Array.from(document.querySelectorAll(currentView === 'table' ? '#tableBody .prof-item' : '#cardView .prof-card'))
                .filter(el => el.style.display !== 'none')
                .map(el => JSON.parse(el.dataset.profJson));
            if (rows.length === 0) {
                alert('Aucun professeur à exporter.');
                return;
            }
            const headers = ['Matricule','Nom','Prénom','Email','Téléphone','Grade','Spécialité','Statut','Date d\'embauche'];
            const csv = [headers.join(',')].concat(rows.map(r => [r.Matricule || '', r.Nom || '', r.Prenom || '', r.Email || '', r.Telephone || '', r.Grade || '', r.Specialite || '', r.Statut || '', r.DateEmbauche || ''].map(v => '"' + String(v).replace(/"/g, '""') + '"').join(',')));
            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'professeurs_export.csv';
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggleView('table');
            applyFilters();
            document.getElementById('detailModal')?.addEventListener('click', function (e) { if (e.target === this) closeDetailModal(); });
            if (window.lucide) lucide.createIcons();
        });
    </script>
}
