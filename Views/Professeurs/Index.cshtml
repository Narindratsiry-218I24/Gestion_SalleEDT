                            <span id="modalStatusBadge" class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold"></span>
                        </div>
                    </div>
                </div>
                
                <!-- DROITE -->
                <div class="space-y-6">
                    <div class="grid gap-6 md:grid-cols-2">
                        <!-- IdentitÃ© -->
                        <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
                            <h4 class="mb-4 flex items-center gap-2 text-sm font-bold text-gray-900 border-b pb-2">
                                <i data-lucide="contact" class="h-4 w-4 text-gray-400"></i> IdentitÃ©
                            </h4>
                            <dl class="space-y-2 text-sm">
                                <div class="grid grid-cols-3"><dt class="text-gray-500">Nom Complet</dt><dd class="col-span-2 font-medium text-gray-900" id="modalFullName"></dd></div>
                                <div class="grid grid-cols-3"><dt class="text-gray-500">Titre</dt><dd class="col-span-2 font-medium text-gray-900" id="modalTitre"></dd></div>
                            </dl>
                        </div>
                        
                        <!-- Pro -->
