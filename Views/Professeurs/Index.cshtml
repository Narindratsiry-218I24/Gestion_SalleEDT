                        <!-- Photo injectÃ©e ici -->
                    </div>
                    <h3 id="modalFullNameTitle" class="mt-4 text-xl font-bold text-gray-900 text-center">Profil du professeur</h3>
                    <p id="modalGradeTitle" class="text-sm font-medium text-blue-600"></p>
                    
                    <div class="mt-6 w-full space-y-4 rounded-xl bg-gray-50 p-4">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">Statistiques</h4>
                        
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Heures effectuÃ©es</span>
                                <span class="font-medium text-gray-900"><span id="modalHeures">0</span> / <span id="modalCapacite">20</span>h</span>
                            </div>
                            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                                <div id="modalProgress" class="h-full bg-blue-500 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        
                        <div class="flex justify-between items-center py-2 border-t border-gray-200">
