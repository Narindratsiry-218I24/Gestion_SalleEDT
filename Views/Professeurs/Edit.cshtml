@model Gestion_SalleClasseEDT.Models.Professeur

@{
    ViewData["Title"] = "Modifier un Professeur";
}

<div class="max-w-7xl mx-auto py-8">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-[#17203A]">Modifier le professeur</h1>
            <p class="text-gray-500 mt-1">Mettez à jour les informations de @Model.Prenom @Model.Nom</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 rounded-md bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Retour à la liste
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" method="post" class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <input type="hidden" asp-for="IdProfesseur" />
        <input type="hidden" asp-for="PhotoUrl" />
        <input type="hidden" asp-for="CvUrl" />
        <input type="hidden" asp-for="DateCreation" />
        <input type="hidden" asp-for="HeuresEffectuees" />
        <input type="hidden" asp-for="IdUtilisateur" />

        <div class="grid lg:grid-cols-12">
            
            <!-- COLONNE GAUCHE (Photo & CV) -->
            <div class="lg:col-span-4 bg-gray-50 p-8 border-b lg:border-b-0 lg:border-r border-gray-200 flex flex-col items-center">
                <!-- Photo Upload -->
                <div class="relative mb-6">
                    <div class="h-40 w-40 rounded-full overflow-hidden border-4 border-white shadow-lg bg-gray-200 flex items-center justify-center relative" id="photoPreviewContainer">
                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <img id="photoPreview" src="@Model.PhotoUrl" alt="Profil" class="absolute inset-0 w-full h-full object-cover" />
                        }
                        else
                        {
                            <i data-lucide="user" class="h-16 w-16 text-gray-400"></i>
                            <img id="photoPreview" alt="Aperçu" class="hidden absolute inset-0 w-full h-full object-cover" />
                        }
                    </div>
                    <label for="photoInput" class="absolute bottom-2 right-2 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-blue-600 text-white shadow-md hover:bg-blue-700 transition" title="Changer la photo">
                        <span class="sr-only">Changer la photo</span>
                        <i data-lucide="upload" class="h-5 w-5"></i>
                        <input type="file" asp-for="photoFile" id="photoInput" class="hidden" accept="image/*" aria-label="Uploader une photo" onchange="previewImage(this)" />
                    </label>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Photo de profil</h3>
                <p class="text-xs text-gray-500 mb-8 text-center">Format carré recommandé. Max 2MB.</p>

                <!-- CV Upload -->
                <div class="w-full">
                    <p class="block text-sm font-medium text-gray-700 mb-2">Curriculum Vitae</p>
                    
                    @if (!string.IsNullOrEmpty(Model.CvUrl))
                    {
                        <div class="mb-4 rounded-lg border border-gray-200 bg-white p-3 flex items-center justify-between">
                            <div class="flex items-center gap-2 overflow-hidden">
                                <i data-lucide="file-text" class="h-5 w-5 text-blue-500 flex-shrink-0"></i>
                                <a href="@Model.CvUrl" target="_blank" class="truncate text-sm font-medium text-gray-900 hover:text-blue-600 hover:underline">Voir le CV actuel</a>
                            </div>
                        </div>
                    }

                    <button id="cvDropZone" type="button" class="mt-1 w-full flex justify-center rounded-xl border-2 border-dashed border-gray-300 px-6 py-8 hover:bg-gray-50 transition cursor-pointer text-left" onclick="document.getElementById('cvInput').click()" onkeydown="if(event.key==='Enter'||event.key===' ') { event.preventDefault(); document.getElementById('cvInput').click(); }">
                        <div class="text-center">
                            <i data-lucide="upload-cloud" class="mx-auto h-10 w-10 text-gray-400"></i>
                            <div class="mt-4 flex text-sm text-gray-600 justify-center">
                                <span class="relative cursor-pointer rounded-md bg-transparent font-medium text-blue-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-blue-500 hover:text-blue-500">
                                    <span>Remplacer le fichier</span>
                                    <input type="file" asp-for="cvFile" id="cvInput" class="sr-only" accept=".pdf,.doc,.docx" aria-label="Uploader un CV" onchange="updateCvLabel(this)" />
                                </span>
                            </div>
                            <p class="text-xs text-gray-500 mt-2" id="cvLabel">PDF, DOCX jusqu'à 10MB</p>
                        </div>
                    </button>
                </div>
            </div>

            <!-- COLONNE DROITE (Formulaire) -->
            <div class="lg:col-span-8 p-8 space-y-8">
                @await Html.PartialAsync("_Form", Model)

                <!-- BOUTONS -->
                <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-100">
                    <a asp-action="Index" class="inline-flex justify-center rounded-md border border-gray-300 bg-white px-6 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
                        Annuler
                    </a>
                    <button type="submit" class="inline-flex justify-center rounded-md bg-blue-600 px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700">
                        Enregistrer les modifications
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('photoPreview');
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function updateCvLabel(input) {
            if (input.files && input.files[0]) {
                document.getElementById('cvLabel').textContent = input.files[0].name;
                document.getElementById('cvLabel').classList.replace('text-gray-500', 'text-blue-600');
                document.getElementById('cvLabel').classList.add('font-semibold');
            }
        }
    </script>
}
