@{
    ViewData["Title"] = "Activation de votre compte";
    Layout = null; // Page autonome sans sidebar
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activation de compte – EMIT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0f172a 100%);
            padding: 24px;
        }
        .card {
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            padding: 48px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 32px 64px rgba(0,0,0,0.4);
        }
        .logo-area { text-align: center; margin-bottom: 32px; }
        .logo-area .icon {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border-radius: 20px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 8px 32px rgba(37,99,235,0.4);
        }
        .logo-area .icon svg { width: 36px; height: 36px; color: white; }
        h1 { font-size: 24px; font-weight: 800; color: #fff; text-align: center; margin-bottom: 6px; }
        .subtitle { color: rgba(255,255,255,0.5); font-size: 14px; text-align: center; margin-bottom: 32px; }
        .welcome-box {
            background: rgba(37,99,235,0.12);
            border: 1px solid rgba(37,99,235,0.25);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 28px;
        }
        .welcome-box p { color: rgba(255,255,255,0.8); font-size: 14px; line-height: 1.6; }
        .welcome-box strong { color: #60a5fa; }
        .form-group { margin-bottom: 20px; }
        label { display: block; color: rgba(255,255,255,0.6); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
        .input-wrap { position: relative; }
        .input-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: rgba(255,255,255,0.3); }
        input[type="password"], input[type="text"] {
            width: 100%;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 12px;
            padding: 12px 42px 12px 42px;
            color: #fff;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: border-color 0.2s, background 0.2s;
            outline: none;
        }
        input:focus {
            border-color: rgba(59,130,246,0.6);
            background: rgba(255,255,255,0.09);
        }
        .toggle-pw {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            cursor: pointer; color: rgba(255,255,255,0.3);
            background: none; border: none; padding: 4px;
        }
        .toggle-pw:hover { color: rgba(255,255,255,0.7); }
        .strength-bar { height: 4px; background: rgba(255,255,255,0.1); border-radius: 4px; margin-top: 8px; overflow: hidden; }
        .strength-fill { height: 100%; width: 0; border-radius: 4px; transition: width 0.3s, background 0.3s; }
        .strength-label { font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 4px; }
        .rules { background: rgba(255,255,255,0.04); border-radius: 10px; padding: 12px 16px; margin-top: 12px; }
        .rules .rule { display: flex; align-items: center; gap: 8px; font-size: 12px; color: rgba(255,255,255,0.5); padding: 3px 0; transition: color 0.2s; }
        .rules .rule.ok { color: #4ade80; }
        .rules .rule svg { width: 14px; height: 14px; flex-shrink: 0; }
        .alert-error {
            background: rgba(239,68,68,0.12);
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 10px;
            padding: 12px 16px;
            color: #fca5a5;
            font-size: 13px;
            margin-bottom: 20px;
        }
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border: none; border-radius: 12px;
            color: #fff; font-size: 15px; font-weight: 700;
            cursor: pointer; font-family: 'Inter', sans-serif;
            box-shadow: 0 4px 16px rgba(37,99,235,0.35);
            transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
            margin-top: 8px;
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(37,99,235,0.45); }
        .btn-primary:active { transform: translateY(0); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .footer-note { text-align: center; color: rgba(255,255,255,0.3); font-size: 12px; margin-top: 24px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo-area">
            <div class="icon">
                <i data-lucide="key-round" style="width:36px;height:36px;color:white;"></i>
            </div>
            <h1>Activation du compte</h1>
            <p class="subtitle">Définissez votre mot de passe personnel pour accéder au portail EMIT</p>
        </div>

        <div class="welcome-box">
            <p>Bonjour <strong>@ViewBag.Nom</strong> ! Créez un mot de passe sécurisé pour activer votre compte enseignant.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@err.ErrorMessage</p>
                }
            </div>
        }

        <form method="post" action="/Professeurs/ActivationCompte" id="activationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="form-group">
                <label>Nouveau mot de passe</label>
                <div class="input-wrap">
                    <i data-lucide="lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:rgba(255,255,255,0.3);"></i>
                    <input type="password" name="nouveauMotDePasse" id="pwd" placeholder="Minimum 8 caractères" autocomplete="new-password" oninput="checkStrength(this.value)" required />
                    <button type="button" class="toggle-pw" onclick="togglePw('pwd', this)" title="Afficher/masquer">
                        <i data-lucide="eye" style="width:16px;height:16px;"></i>
                    </button>
                </div>
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <p class="strength-label" id="strengthLabel">Entrez un mot de passe</p>
                <div class="rules">
                    <div class="rule" id="ruleLen"><i data-lucide="circle" style="width:14px;height:14px;"></i> Minimum 8 caractères</div>
                    <div class="rule" id="ruleUp"><i data-lucide="circle" style="width:14px;height:14px;"></i> Une lettre majuscule</div>
                    <div class="rule" id="ruleNum"><i data-lucide="circle" style="width:14px;height:14px;"></i> Un chiffre</div>
                    <div class="rule" id="ruleSpec"><i data-lucide="circle" style="width:14px;height:14px;"></i> Un caractère spécial (@@, #, !...)</div>
                </div>
            </div>

            <div class="form-group">
                <label>Confirmer le mot de passe</label>
                <div class="input-wrap">
                    <i data-lucide="lock-keyhole" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:rgba(255,255,255,0.3);"></i>
                    <input type="password" name="confirmationMotDePasse" id="pwd2" placeholder="Répétez le mot de passe" autocomplete="new-password" oninput="checkMatch()" required />
                    <button type="button" class="toggle-pw" onclick="togglePw('pwd2', this)" title="Afficher/masquer">
                        <i data-lucide="eye" style="width:16px;height:16px;"></i>
                    </button>
                </div>
                <p class="strength-label" id="matchLabel" style="margin-top:6px;"></p>
            </div>

            <button type="submit" class="btn-primary" id="submitBtn" disabled>
                <i data-lucide="check-circle" style="width:16px;height:16px;display:inline;vertical-align:middle;margin-right:6px;"></i>
                Activer mon compte
            </button>
        </form>

        <p class="footer-note">EMIT – Portail Académique &bull; Lien sécurisé (48h)</p>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();
        });

        function togglePw(id, btn) {
            const el = document.getElementById(id);
            if (el.type === 'password') {
                el.type = 'text';
                btn.innerHTML = '<i data-lucide="eye-off" style="width:16px;height:16px;"></i>';
            } else {
                el.type = 'password';
                btn.innerHTML = '<i data-lucide="eye" style="width:16px;height:16px;"></i>';
            }
            if (window.lucide) lucide.createIcons();
        }

        function setRule(id, ok) {
            const el = document.getElementById(id);
            if (ok) {
                el.classList.add('ok');
                el.querySelector('i').setAttribute('data-lucide', 'check-circle');
            } else {
                el.classList.remove('ok');
                el.querySelector('i').setAttribute('data-lucide', 'circle');
            }
            if (window.lucide) lucide.createIcons();
        }

        let pwOk = false;
        function checkStrength(val) {
            const len   = val.length >= 8;
            const upper = /[A-Z]/.test(val);
            const num   = /\d/.test(val);
            const spec  = /[\x40#!$%^&*]/.test(val);

            setRule('ruleLen',  len);
            setRule('ruleUp',   upper);
            setRule('ruleNum',  num);
            setRule('ruleSpec', spec);

            const score = [len, upper, num, spec].filter(Boolean).length;
            const fill  = document.getElementById('strengthFill');
            const label = document.getElementById('strengthLabel');

            const configs = [
                { w: '0%',   bg: 'transparent', txt: '' },
                { w: '25%',  bg: '#ef4444',      txt: 'Très faible' },
                { w: '50%',  bg: '#f97316',      txt: 'Faible' },
                { w: '75%',  bg: '#eab308',      txt: 'Moyen' },
                { w: '100%', bg: '#22c55e',      txt: 'Fort ✓' },
            ];
            const cfg = configs[score] || configs[0];
            fill.style.width      = cfg.w;
            fill.style.background = cfg.bg;
            label.textContent     = cfg.txt;
            label.style.color     = cfg.bg;

            pwOk = score === 4;
            checkSubmit();
        }

        let matchOk = false;
        function checkMatch() {
            const p1 = document.getElementById('pwd').value;
            const p2 = document.getElementById('pwd2').value;
            const lbl = document.getElementById('matchLabel');
            if (!p2) { lbl.textContent = ''; matchOk = false; }
            else if (p1 === p2) { lbl.textContent = '✓ Les mots de passe correspondent'; lbl.style.color = '#4ade80'; matchOk = true; }
            else { lbl.textContent = '✗ Les mots de passe ne correspondent pas'; lbl.style.color = '#f87171'; matchOk = false; }
            checkSubmit();
        }

        function checkSubmit() {
            document.getElementById('submitBtn').disabled = !(pwOk && matchOk);
        }
    </script>
</body>
</html>
