        // ================= ACTIONS & MODALS =================

        function toggleCopySelection() {
            const mode = document.getElementById('anneeModeCreation').value;
            const container = document.getElementById('copyYearContainer');
            if (mode === 'copy') {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        // Année Académique Modals
        function openAnneeModal() {
            document.getElementById('formAnnee').reset();
            toggleCopySelection();
            document.getElementById('anneeModal').classList.remove('hidden');
            document.getElementById('anneeModal').classList.add('flex');
        }
        function closeAnneeModal() {
            document.getElementById('anneeModal').classList.add('hidden');
            document.getElementById('anneeModal').classList.remove('flex');
        }

        async function saveAnnee(e) {
            e.preventDefault();
            const libelle = document.getElementById('anneeLibelle').value;
            const dateDebut = document.getElementById('anneeDateDebut').value;
            const dateFin = document.getElementById('anneeDateFin').value;
            const estActive = document.getElementById('anneeEstActive').checked;
            const mode = document.getElementById('anneeModeCreation').value;

            try {
                if (mode === 'auto') {
                    // Create year, semestres and auto-generate classes based on filiere+level
                    await app.apiPost('/api/AnneeAcademique/CreerComplete', {
                        Libelle: libelle,
                        DateDebut: dateDebut,
                        DateFin: dateFin,
                        EstActive: estActive
                    });
                } else {
                    // Create year, copy structure from selected sourceId
                    const sourceId = document.getElementById('anneeSourceId').value;
                    const res = await app.apiPost('/api/AnneeAcademique/CreerAvecSemestres', {
                        Libelle: libelle,
                        DateDebut: dateDebut,
                        DateFin: dateFin,
                        EstActive: estActive
                    });
                    const newId = res.Annee ? prop(res.Annee, 'IdAnnee') : res.idAnnee;
                    if (newId && sourceId) {
                        await app.apiPost(`/api/AnneeAcademique/${newId}/CopierReglages/${sourceId}`, {});
                    }
                }
                closeAnneeModal();
                loadAllData();
            } catch (err) {
                alert("Erreur lors de la création: " + err.message);
            }
        }

        async function archiveAnnee(id) {
            if (confirm("Voulez-vous archiver cette année académique ?")) {
                try {
                    await app.apiPost(`/api/AnneeAcademique/${id}/Archiver`, {});
                    loadAllData();
                } catch (err) {
                    alert("Erreur d'archivage: " + err.message);
