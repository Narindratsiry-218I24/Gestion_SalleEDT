@{
    ViewBag.Title = "Structures";
}

<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Configuration Académique</h1>
            <p class="text-gray-500 mt-1">Gérez les mentions, niveaux, et filières de l'établissement.</p>
        </div>
        <button onclick="openAddFiliereModal()" class="bg-blue-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition flex items-center gap-2">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Ajouter un Parcours/Filière
        </button>
    </div>

    <!-- Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <i data-lucide="award" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Mentions</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statMentions">--</h4>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Filières</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statFilieres">--</h4>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                <i data-lucide="users" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Classes</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statClasses">--</h4>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex-1 flex flex-col">
        <div class="p-6 border-b border-gray-50 flex justify-between items-center">
            <h3 class="font-bold text-lg text-[#17203A] m-0">Hiérarchie Académique</h3>
            <div class="relative w-[300px]">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                <input type="text" id="searchStructures" oninput="filterStructures()" placeholder="Rechercher une mention, filière..." class="w-full pl-9 pr-3 h-10 bg-gray-50 border border-gray-200 text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-[#17203A]/20" />
            </div>
        </div>
        <div class="p-0">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100">
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Mention</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Code</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Niveaux</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Filières associées</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100" id="structuresTableBody">
                    <tr><td colspan="4" class="text-center py-4 text-gray-500">Chargement...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Add Parcours/Filière -->
<div id="addFiliereModal" class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden transform scale-95 opacity-0 transition-all duration-200" id="addFiliereModalContent">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <h3 class="font-bold text-[#17203A] text-lg">Ajouter un Parcours/Filière</h3>
            <button onclick="closeAddFiliereModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6">
            <form id="addFiliereForm" class="space-y-4" onsubmit="submitFiliereForm(event)">
                <!-- Mention -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Mention <span class="text-red-500">*</span></label>
                    <select id="modalMentionName" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-10 px-3 border bg-white">
                        <option value="">Sélectionnez une mention</option>
                        <option value="Informatique">Informatique</option>
                        <option value="Management">Management</option>
                        <option value="Multimédia">Multimédia</option>
                    </select>
                </div>
                <!-- Niveau -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Niveau <span class="text-red-500">*</span></label>
                    <select id="modalNiveau" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-10 px-3 border bg-white">
                        <option value="">Sélectionnez un niveau</option>
                        <option value="Licence 1">Licence 1</option>
                        <option value="Licence 2">Licence 2</option>
                        <option value="Licence 3">Licence 3</option>
                        <option value="Master 1">Master 1</option>
                        <option value="Master 2">Master 2</option>
                    </select>
                </div>
                <!-- Parcours suggéré -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Parcours (Filière) <span class="text-red-500">*</span></label>
                    <input type="text" id="modalParcoursCode" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-10 px-3 border" placeholder="Ex: DA2I" />
                </div>
                <!-- Nom Complet (Optionnel) -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nom Complet de la Filière</label>
                    <input type="text" id="modalParcoursNom" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-10 px-3 border" placeholder="Ex: Développement d'Applications..." />
                </div>
                <div class="flex justify-end pt-4 mt-4 border-t border-gray-100">
                    <button type="button" class="mr-3 bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none" onclick="closeAddFiliereModal()">
                        Annuler
                    </button>
                    <button type="submit" class="bg-blue-600 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allMentions = [];
        let allFilieres = [];
        let allNiveaux = [];
        let allClasses = [];

        function openAddFiliereModal() {
            const modal = document.getElementById('addFiliereModal');
            const content = document.getElementById('addFiliereModalContent');
            
            document.getElementById('addFiliereForm').reset();

            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeAddFiliereModal() {
            const modal = document.getElementById('addFiliereModal');
            const content = document.getElementById('addFiliereModalContent');
            
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        async function submitFiliereForm(e) {
            e.preventDefault();
            
            const mentionName = document.getElementById('modalMentionName').value;
            const parcoursCode = document.getElementById('modalParcoursCode').value;
            let parcoursNom = document.getElementById('modalParcoursNom').value;
            
            if(!parcoursNom) {
                parcoursNom = parcoursCode;
            }
            
            let mentionId = 0;
            const normalize = str => str ? str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase() : "";
            const search = normalize(mentionName);

            let mentionObj = allMentions.find(m => {
                const n = normalize(app.readProp(m, "NomMention"));
                const c = normalize(app.readProp(m, "CodeMention"));
                return (n && (n.includes(search) || search.includes(n))) || 
                       (c && (c.includes(search) || search.includes(c)));
            });

            if(mentionObj) {
                mentionId = app.readProp(mentionObj, "IdMention");
            } else {
                // Auto-create mention if not found
                try {
                    let maxMId = 0;
                    if(allMentions.length > 0) maxMId = Math.max(...allMentions.map(m => app.readProp(m, "IdMention") || 0));
                    const newMId = maxMId + 1;
                    const mentionCode = mentionName.substring(0, 4).toUpperCase();
                    await app.apiPost('/api/Mention', { IdMention: newMId, NomMention: mentionName, CodeMention: mentionCode });
                    mentionId = newMId;
                } catch(err) {
                    alert("Erreur lors de la création automatique de la mention : " + err.message);
                    return;
                }
            }

            // Generate ID logic depending on how your backend handles it. If auto-increment, send 0
            // Find max id to avoid conflict if backend doesn't auto-increment properly (workaround)
            let maxId = 0;
            if(allFilieres.length > 0) {
                maxId = Math.max(...allFilieres.map(f => app.readProp(f, "IdFiliere") || 0));
            }
            const newId = maxId + 1;

            const payload = {
                IdFiliere: newId,
                IdMention: parseInt(mentionId),
                CodeFiliere: parcoursCode,
                NomFiliere: parcoursNom
            };

            try {
                await app.apiPost('/api/Filiere', payload);
                closeAddFiliereModal();
                loadStructures(); // reload
            } catch (error) {
                alert("Erreur lors de l'ajout du parcours : " + error.message);
            }
        }

        async function loadStructures() {
            const tbody = document.getElementById("structuresTableBody");
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-gray-500"><div class="flex justify-center items-center gap-2"><i data-lucide="loader-2" class="w-4 h-4 animate-spin text-blue-500"></i> Chargement...</div></td></tr>';
            if (window.lucide) lucide.createIcons();

            try {
                const [mentions, filieres, niveaux, classes] = await Promise.all([
                    app.apiGet('/api/Mention'),
                    app.apiGet('/api/Filiere'),
                    app.apiGet('/api/Niveau'),
                    app.apiGet('/api/Classe')
                ]);
                allMentions = mentions || [];
                allFilieres = filieres || [];
                allNiveaux = niveaux || [];
                allClasses = classes || [];

                document.getElementById("statMentions").textContent = allMentions.length;
                document.getElementById("statFilieres").textContent = allFilieres.length;
                document.getElementById("statClasses").textContent = allClasses.length;

                renderStructures(allMentions);
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-8 text-red-600 font-bold">Erreur: ${app.escapeHtml(err.message)}</td></tr>`;
            }
        }

        function renderStructures(mentions) {
            const tbody = document.getElementById("structuresTableBody");
            tbody.innerHTML = "";

            if (mentions.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-gray-500">Aucune structure trouvée.</td></tr>';
                return;
            }

            mentions.forEach(function(m) {
                const id = app.readProp(m, "IdMention");
                const nom = app.escapeHtml(app.readProp(m, "NomMention") || "");
                const code = app.escapeHtml(app.readProp(m, "CodeMention") || "N/A");

                // Get niveaux for this mention
                const mentionNiveaux = allNiveaux.filter(n => app.readProp(n, "IdMention") == id);
                const niveauxStr = mentionNiveaux.map(n => app.escapeHtml(app.readProp(n, "CodeNiveau") || "")).join(", ") || "Aucun";

                // Get filieres for this mention
                const mentionFilieres = allFilieres.filter(f => {
                    // Check if Filiere belongs to Mention. Depending on API response, IdMention might be on Filiere or Mention property.
                    const fIdMention = app.readProp(f, "IdMention");
                    if (fIdMention) return fIdMention == id;
                    const fMention = app.readProp(f, "Mention");
                    return fMention && app.readProp(fMention, "IdMention") == id;
                });
                const filieresHtml = mentionFilieres.length > 0
                    ? mentionFilieres.map(f => {
                        const fname = app.escapeHtml(app.readProp(f, "CodeFiliere") || app.readProp(f, "NomFiliere") || "");
                        return `<div class="inline-flex items-center bg-purple-50 text-purple-700 px-2 py-0.5 rounded text-xs font-bold mr-1 mb-1">
                            <span>${fname}</span>
                        </div>`;
                    }).join("")
                    : '<span class="text-gray-400 text-xs italic">Aucune</span>';

                const tr = document.createElement("tr");
                tr.className = "hover:bg-gray-50/50 transition-colors";
                tr.innerHTML = `
                    <td class="py-4 px-6 font-semibold text-[#17203A]">
                        <div class="flex items-center gap-2">
                            <i data-lucide="award" class="w-4 h-4 text-blue-500"></i>
                            ${nom}
                        </div>
                    </td>
                    <td class="py-4 px-6"><span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider">${code}</span></td>
                    <td class="py-4 px-6 text-gray-600 font-medium">${niveauxStr}</td>
                    <td class="py-4 px-6">${filieresHtml}</td>
                    <td class="py-4 px-6">
                        <div class="flex items-center gap-2">
                            <button onclick="detailsMention(${id})" class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors" title="Détails">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button onclick="editMention(${id})" class="p-1.5 text-gray-500 hover:text-orange-600 hover:bg-orange-50 rounded transition-colors" title="Modifier">
                                <i data-lucide="edit" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteMention(${id})" class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded transition-colors" title="Supprimer">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            if (window.lucide) lucide.createIcons();
        }

        function filterStructures() {
            const query = document.getElementById("searchStructures").value.toLowerCase().trim();
            if (!query) { renderStructures(allMentions); return; }
            const filtered = allMentions.filter(m => {
                const nom = (app.readProp(m, "NomMention") || "").toLowerCase();
                const code = (app.readProp(m, "CodeMention") || "").toLowerCase();
                return nom.includes(query) || code.includes(query);
            });
            renderStructures(filtered);
        }

        
        // --- Actions for Mention ---
        window.detailsMention = async function(id) {
            try {
                const res = await fetch(`/api/Mention/${id}`);
                if (!res.ok) throw new Error("Impossible de récupérer les détails");
                const m = await res.json();
                
                const nom = app.readProp(m, "NomMention") || "";
                const code = app.readProp(m, "CodeMention") || "";
                const nivCount = app.readProp(m, "NiveauCount") || 0;
                const filCount = app.readProp(m, "FiliereCount") || 0;

                Swal.fire({
                    title: `Mention : ${nom} (${code})`,
                    html: `
                        <div class="text-left mt-4 space-y-2">
                            <p><strong>Code :</strong> ${code}</p>
                            <p><strong>Niveaux rattachés :</strong> ${nivCount}</p>
                            <p><strong>Filières rattachées :</strong> ${filCount}</p>
                        </div>
                    `,
                    icon: 'info',
                    confirmButtonText: 'Fermer',
                    confirmButtonColor: '#3085d6'
                });
            } catch (e) {
                Swal.fire('Erreur', e.message, 'error');
            }
        };

        window.editMention = async function(id) {
            const mention = allMentions.find(m => app.readProp(m, "IdMention") == id);
            if (!mention) return;

            const { value: formValues } = await Swal.fire({
                title: 'Modifier la mention',
                html:
                    `<input id="swal-input-nom" class="swal2-input" placeholder="Nom de la mention" value="${app.readProp(mention, "NomMention") || ''}">` +
                    `<input id="swal-input-code" class="swal2-input" placeholder="Code (ex: INFO)" value="${app.readProp(mention, "CodeMention") || ''}">`,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Enregistrer',
                cancelButtonText: 'Annuler',
                preConfirm: () => {
                    return {
                        NomMention: document.getElementById('swal-input-nom').value,
                        CodeMention: document.getElementById('swal-input-code').value
                    }
                }
            });

            if (formValues) {
                try {
                    const payload = { IdMention: id, NomMention: formValues.NomMention, CodeMention: formValues.CodeMention };
                    const res = await fetch(`/api/Mention/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (res.ok) {
                        Swal.fire('Succès', 'Mention modifiée avec succès', 'success');
                        loadStructures();
                    } else {
                        const err = await res.text();
                        Swal.fire('Erreur', err, 'error');
                    }
                } catch (e) {
                    Swal.fire('Erreur', e.message, 'error');
                }
            }
        };

        window.deleteMention = async function(id) {
            const result = await Swal.fire({
                title: 'Êtes-vous sûr ?',
                text: "Vous ne pourrez pas revenir en arrière !",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Oui, supprimer',
                cancelButtonText: 'Annuler'
            });

            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/api/Mention/${id}`, { method: 'DELETE' });
                    if (res.ok) {
                        Swal.fire('Supprimé!', 'La mention a été supprimée.', 'success');
                        loadStructures();
                    } else {
                        const data = await res.json().catch(() => null);
                        Swal.fire('Erreur', data?.message || 'Erreur lors de la suppression', 'error');
                    }
                } catch (e) {
                    Swal.fire('Erreur', e.message, 'error');
                }
            }
        };

        // --- Actions for Filiere ---
        window.editFiliere = async function(id) {
            const filiere = allFilieres.find(f => app.readProp(f, "IdFiliere") == id || app.readProp(f, "idFiliere") == id);
            if (!filiere) return;

            const idMention = app.readProp(filiere, "IdMention") || app.readProp(filiere, "idMention");
            
            // Build options for Mentions
            let optionsHtml = allMentions.map(m => {
                const mId = app.readProp(m, "IdMention");
                const selected = (mId == idMention) ? "selected" : "";
                return `<option value="${mId}" ${selected}>${app.readProp(m, "NomMention")}</option>`;
            }).join("");

            const { value: formValues } = await Swal.fire({
                title: 'Modifier le parcours',
                html:
                    `<select id="swal-input-mention" class="swal2-select w-full max-w-full m-0 mt-4 h-10 text-sm border-gray-300 rounded-md">
                        <option value="">Sélectionnez une mention</option>
                        ${optionsHtml}
                     </select>` +
                    `<input id="swal-input-code" class="swal2-input" placeholder="Code (ex: DA2I)" value="${app.readProp(filiere, "CodeFiliere") || app.readProp(filiere, "codeFiliere") || ''}">` +
                    `<input id="swal-input-nom" class="swal2-input" placeholder="Nom complet" value="${app.readProp(filiere, "NomFiliere") || app.readProp(filiere, "nomFiliere") || ''}">`,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Enregistrer',
                cancelButtonText: 'Annuler',
                preConfirm: () => {
                    const selectedMention = document.getElementById('swal-input-mention').value;
                    if (!selectedMention) {
                        Swal.showValidationMessage('Veuillez sélectionner une mention');
                        return false;
                    }
                    return {
                        IdMention: parseInt(selectedMention),
                        CodeFiliere: document.getElementById('swal-input-code').value,
                        NomFiliere: document.getElementById('swal-input-nom').value
                    }
                }
            });

            if (formValues) {
                try {
                    const payload = { IdFiliere: id, IdMention: formValues.IdMention, CodeFiliere: formValues.CodeFiliere, NomFiliere: formValues.NomFiliere };
                    const res = await fetch(`/api/Filiere/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (res.ok) {
                        Swal.fire('Succès', 'Parcours modifié avec succès', 'success');
                        loadStructures();
                    } else {
                        const err = await res.text();
                        Swal.fire('Erreur', err, 'error');
                    }
                } catch (e) {
                    Swal.fire('Erreur', e.message, 'error');
                }
            }
        };

        window.deleteFiliere = async function(id) {
            const result = await Swal.fire({
                title: 'Êtes-vous sûr ?',
                text: "Vous ne pourrez pas revenir en arrière !",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Oui, supprimer',
                cancelButtonText: 'Annuler'
            });

            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/api/Filiere/${id}`, { method: 'DELETE' });
                    if (res.ok) {
                        Swal.fire('Supprimée!', 'La filière a été supprimée.', 'success');
                        loadStructures();
                    } else {
                        const data = await res.json().catch(() => null);
                        Swal.fire('Erreur', data?.message || 'Erreur lors de la suppression', 'error');
                    }
                } catch (e) {
                    Swal.fire('Erreur', e.message, 'error');
                }
            }
        };

        document.addEventListener("DOMContentLoaded", function() {
            loadStructures();
        });
    </script>
}