@{
    ViewBag.Title = "Configuration Académique";
}

<div class="space-y-6 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Configuration Académique</h1>
            <p class="text-gray-500 mt-1">Gérez le cycle de vie des années scolaires, les mentions, les filières et les niveaux d'enseignement.</p>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-gray-200">
        <button onclick="switchTab('anneesTab')" id="btn-anneesTab" class="tab-btn px-6 py-3 font-bold text-sm border-b-2 border-blue-600 text-blue-600 transition-all focus:outline-none">
            <span class="flex items-center gap-2">
                <i data-lucide="calendar" class="w-4 h-4"></i> Années Académiques
            </span>
        </button>
        <button onclick="switchTab('structuresTab')" id="btn-structuresTab" class="tab-btn px-6 py-3 font-bold text-sm border-b-2 border-transparent text-gray-500 hover:text-[#17203A] transition-all focus:outline-none">
            <span class="flex items-center gap-2">
                <i data-lucide="award" class="w-4 h-4"></i> Mentions & Filières
            </span>
        </button>
        <button onclick="switchTab('niveauxTab')" id="btn-niveauxTab" class="tab-btn px-6 py-3 font-bold text-sm border-b-2 border-transparent text-gray-500 hover:text-[#17203A] transition-all focus:outline-none">
            <span class="flex items-center gap-2">
                <i data-lucide="layers" class="w-4 h-4"></i> Niveaux d'Étude
            </span>
        </button>
    </div>

    <!-- TAB 1: Années Académiques -->
    <div id="pane-anneesTab" class="tab-pane space-y-6">
        <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-gray-100 shadow-sm">
            <div>
                <h3 class="font-bold text-gray-700 m-0">Cycle des Années Scolaires</h3>
                <p class="text-xs text-gray-400 m-0">Créez une année avec duplication de structure ou génération automatisée de classes.</p>
            </div>
            <button onclick="openAnneeModal()" class="h-10 px-4 bg-[#17203A] text-white hover:bg-[#12192B] rounded-md font-bold text-xs flex items-center gap-2 border-none">
                <i data-lucide="calendar-plus" class="w-4 h-4"></i> Nouvelle Année
            </button>
        </div>

        <div class="grid grid-cols-1 gap-6" id="anneesGrid">
            <!-- Loaded dynamically -->
            <div class="text-center py-8 text-gray-500">Chargement des années...</div>
        </div>
    </div>

    <!-- TAB 2: Mentions & Filières -->
    <div id="pane-structuresTab" class="tab-pane hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Mentions List (Left) -->
            <div class="lg:col-span-5 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-4 border-b border-gray-50 flex justify-between items-center bg-gray-50/50">
                    <h3 class="font-bold text-sm text-[#17203A] uppercase tracking-wider m-0">Mentions</h3>
                    <button onclick="openMentionModal()" class="h-8 px-3 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded font-bold text-xs flex items-center gap-1 border-none">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Ajouter
                    </button>
                </div>
                <div class="p-0 overflow-y-auto max-h-[500px] divide-y divide-gray-100" id="mentionsList">
                    <!-- Loaded dynamically -->
                </div>
            </div>

            <!-- Filières List (Right) -->
            <div class="lg:col-span-7 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-4 border-b border-gray-50 flex justify-between items-center bg-gray-50/50">
                    <h3 class="font-bold text-sm text-[#17203A] uppercase tracking-wider m-0">Filières (Parcours)</h3>
                    <button onclick="openFiliereModal()" class="h-8 px-3 bg-purple-50 text-purple-600 hover:bg-purple-100 rounded font-bold text-xs flex items-center gap-1 border-none">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Ajouter
                    </button>
                </div>
                <div class="p-0 overflow-y-auto max-h-[500px]">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/50 border-b border-gray-100 text-xs font-bold uppercase text-gray-400">
                                <th class="py-3 px-4">Code</th>
                                <th class="py-3 px-4">Nom de la Filière</th>
                                <th class="py-3 px-4">Mention</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm" id="filieresTableBody">
                            <!-- Loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- TAB 3: Niveaux d'Étude -->
    <div id="pane-niveauxTab" class="tab-pane hidden space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-4xl">
            <div class="p-4 border-b border-gray-50 flex justify-between items-center bg-gray-50/50">
                <h3 class="font-bold text-sm text-[#17203A] uppercase tracking-wider m-0">Niveaux d'Enseignement</h3>
                <button onclick="openNiveauModal()" class="h-8 px-3 bg-green-50 text-green-600 hover:bg-green-100 rounded font-bold text-xs flex items-center gap-1 border-none">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> Ajouter Niveau
                </button>
            </div>
            <div class="p-0">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100 text-xs font-bold uppercase text-gray-400">
                            <th class="py-3 px-4">Niveau</th>
                            <th class="py-3 px-4">Mention Associée</th>
                            <th class="py-3 px-4">Ordre d'affichage</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm" id="niveauxTableBody">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Modal Année Académique -->
<div id="anneeModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50 transition-opacity" onclick="closeAnneeModal()"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6">
            <h2 class="text-lg font-bold text-[#17203A] mb-4">Créer une Année Académique</h2>
            <form id="formAnnee" onsubmit="saveAnnee(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Libellé de l'année</label>
                    <input type="text" id="anneeLibelle" required class="w-full h-10 px-3 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-[#17203A]/20" placeholder="ex: 2026-2027" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Date Début</label>
                        <input type="date" id="anneeDateDebut" required class="w-full h-10 px-3 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-[#17203A]/20" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Date Fin</label>
                        <input type="date" id="anneeDateFin" required class="w-full h-10 px-3 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-[#17203A]/20" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="anneeEstActive" checked class="rounded text-blue-600 focus:ring-blue-500 h-4 w-4" />
                    <label for="anneeEstActive" class="text-sm font-semibold text-gray-700">Définir comme année active</label>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Mode de Création & Structure</label>
                    <select id="anneeModeCreation" onchange="toggleCopySelection()" class="w-full h-10 px-3 border border-gray-200 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#17203A]/20">
                        <option value="auto">Génération automatique des classes (Filière + Niveau)</option>
                        <option value="copy">Copier la structure d'une année existante</option>
                    </select>
                </div>
                <div id="copyYearContainer" class="hidden">
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Année Source à Copier</label>
                    <select id="anneeSourceId" class="w-full h-10 px-3 border border-gray-200 rounded-md bg-white focus:outline-none">
                        <!-- Loaded dynamically -->
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" class="px-4 py-2 border border-gray-200 rounded-md text-gray-700 bg-white hover:bg-gray-50 font-semibold text-sm" onclick="closeAnneeModal()">Annuler</button>
                    <button type="submit" class="px-4 py-2 bg-[#17203A] text-white rounded-md hover:bg-[#12192b] font-semibold text-sm">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Mention -->
<div id="mentionModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50 transition-opacity" onclick="closeMentionModal()"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
            <h2 class="text-lg font-bold text-[#17203A] mb-4" id="mentionModalTitle">Ajouter une Mention</h2>
            <form id="formMention" onsubmit="saveMention(event)" class="space-y-4">
                <input type="hidden" id="mentionId" value="0" />
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Code Mention</label>
                    <input type="text" id="mentionCode" required class="w-full h-10 px-3 border border-gray-200 rounded-md uppercase" placeholder="ex: INF" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nom Mention</label>
                    <input type="text" id="mentionNom" required class="w-full h-10 px-3 border border-gray-200 rounded-md" placeholder="ex: Informatique" />
                </div>
                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" class="px-4 py-2 border border-gray-200 rounded-md text-gray-700 bg-white hover:bg-gray-50 font-semibold text-sm" onclick="closeMentionModal()">Annuler</button>
                    <button type="submit" class="px-4 py-2 bg-[#17203A] text-white rounded-md hover:bg-[#12192b] font-semibold text-sm">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Filière -->
<div id="filiereModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50 transition-opacity" onclick="closeFiliereModal()"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
            <h2 class="text-lg font-bold text-[#17203A] mb-4" id="filiereModalTitle">Ajouter une Filière</h2>
            <form id="formFiliere" onsubmit="saveFiliere(event)" class="space-y-4">
                <input type="hidden" id="filiereId" value="0" />
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Mention Parentee</label>
                    <select id="filiereMentionId" required class="w-full h-10 px-3 border border-gray-200 rounded-md bg-white">
                        <!-- Loaded dynamically -->
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Code Filière</label>
                    <input type="text" id="filiereCode" required class="w-full h-10 px-3 border border-gray-200 rounded-md uppercase" placeholder="ex: DA2I" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nom Filière</label>
                    <input type="text" id="filiereNom" required class="w-full h-10 px-3 border border-gray-200 rounded-md" placeholder="ex: Dével. d'Applications Internet et Mobiles" />
                </div>
                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" class="px-4 py-2 border border-gray-200 rounded-md text-gray-700 bg-white hover:bg-gray-50 font-semibold text-sm" onclick="closeFiliereModal()">Annuler</button>
                    <button type="submit" class="px-4 py-2 bg-[#17203A] text-white rounded-md hover:bg-[#12192b] font-semibold text-sm">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Niveau -->
<div id="niveauModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50 transition-opacity" onclick="closeNiveauModal()"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
            <h2 class="text-lg font-bold text-[#17203A] mb-4" id="niveauModalTitle">Ajouter un Niveau</h2>
            <form id="formNiveau" onsubmit="saveNiveau(event)" class="space-y-4">
                <input type="hidden" id="niveauId" value="0" />
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Mention Parentee</label>
                    <select id="niveauMentionId" required class="w-full h-10 px-3 border border-gray-200 rounded-md bg-white">
                        <!-- Loaded dynamically -->
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Code Niveau</label>
                    <input type="text" id="niveauCode" required class="w-full h-10 px-3 border border-gray-200 rounded-md uppercase" placeholder="ex: L1, M2" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Ordre d'affichage</label>
                    <input type="number" id="niveauOrdre" required class="w-full h-10 px-3 border border-gray-200 rounded-md" placeholder="ex: 1 (pour L1), 4 (pour M1)" />
                </div>
                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" class="px-4 py-2 border border-gray-200 rounded-md text-gray-700 bg-white hover:bg-gray-50 font-semibold text-sm" onclick="closeNiveauModal()">Annuler</button>
                    <button type="submit" class="px-4 py-2 bg-[#17203A] text-white rounded-md hover:bg-[#12192b] font-semibold text-sm">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allMentions = [];
        let allFilieres = [];
        let allNiveaux = [];
        let allAnnees = [];

        const prop = (o, n) => app.readProp(o, n);
        const esc = v => app.escapeHtml(v ?? "");

        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-blue-600', 'text-blue-600');
                btn.classList.add('border-transparent', 'text-gray-500');
            });
            document.querySelectorAll('.tab-pane').forEach(pane => {
                pane.classList.add('hidden');
            });

            document.getElementById('btn-' + tabId).classList.add('border-blue-600', 'text-blue-600');
            document.getElementById('btn-' + tabId).classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('pane-' + tabId).classList.remove('hidden');
            
            if (window.lucide) lucide.createIcons();
        }

        async function loadAllData() {
            try {
                const [mentions, filieres, niveaux, annees] = await Promise.all([
                    app.apiGet('/api/Mention'),
                    app.apiGet('/api/Filiere'),
                    app.apiGet('/api/Niveau'),
                    app.apiGet('/api/AnneeAcademique')
                ]);

                allMentions = mentions || [];
                allFilieres = filieres || [];
                allNiveaux = niveaux || [];
                allAnnees = annees.Items || annees || [];

                // Bind dropdowns
                fillSelect('filiereMentionId', allMentions, 'IdMention', m => prop(m, 'NomMention'));
                fillSelect('niveauMentionId', allMentions, 'IdMention', m => prop(m, 'NomMention'));
                fillSelect('anneeSourceId', allAnnees, 'IdAnnee', a => prop(a, 'Libelle'));

                renderAnnees();
                renderMentionsAndFilieres();
                renderNiveaux();
            } catch (err) {
                console.error("Error loading configuration data:", err);
            }
        }

        function fillSelect(id, items, valueName, textFn) {
            const select = document.getElementById(id);
            if (!select) return;
            select.innerHTML = (items || []).map(item => `<option value="${prop(item, valueName)}">${esc(textFn(item))}</option>`).join('');
        }

        // ================= RENDERING =================

        function renderAnnees() {
            const container = document.getElementById('anneesGrid');
            if (allAnnees.length === 0) {
                container.innerHTML = `<div class="bg-white p-8 text-center text-gray-500 border border-gray-100 rounded-xl">Aucune année académique configurée.</div>`;
                return;
            }

            container.innerHTML = allAnnees.map(a => {
                const id = prop(a, 'IdAnnee');
                const libelle = esc(prop(a, 'Libelle'));
                const isActive = prop(a, 'EstActive');
                const isArchived = prop(a, 'EstArchivee');
                const dateDebut = new Date(prop(a, 'DateDebutAnnee')).toLocaleDateString();
                const dateFin = new Date(prop(a, 'DateFinAnnee')).toLocaleDateString();
                const classesCount = a.Classes ? a.Classes.length : 0;
                const profsCount = prop(a, 'ProfesseursCount') || 0;

                let badge = `<span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-xs font-bold">À Venir</span>`;
                if (isArchived) {
                    badge = `<span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs font-bold">Archivée</span>`;
                } else if (isActive) {
                    badge = `<span class="bg-green-50 text-green-700 px-2 py-0.5 rounded text-xs font-bold">Active</span>`;
                }

                return `
                    <div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden flex flex-col md:flex-row justify-between p-6 items-center gap-6">
                        <div class="flex items-center gap-4 flex-1">
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                                <i data-lucide="calendar" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-lg font-black text-[#17203A] m-0">${libelle}</h4>
                                    ${badge}
                                </div>
                                <p class="text-xs text-gray-500 m-0 mt-1">Période: ${dateDebut} au ${dateFin}</p>
                            </div>
                        </div>

                        <div class="flex gap-8 text-center">
                            <div>
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest m-0">Classes</p>
                                <p class="text-base font-black text-gray-700 m-0 mt-1">${classesCount}</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest m-0">Profs Assignés</p>
                                <p class="text-base font-black text-gray-700 m-0 mt-1">${profsCount}</p>
                            </div>
                        </div>

                        <div class="flex gap-2 shrink-0">
                            ${!isArchived ? `
                                <button onclick="archiveAnnee(${id})" class="h-9 px-3 border border-gray-200 hover:bg-gray-50 rounded text-xs font-semibold text-gray-600 flex items-center gap-1.5 bg-white">
                                    <i data-lucide="archive" class="w-4 h-4"></i> Archiver
                                </button>
                            ` : `
                                <button onclick="restoreAnnee(${id})" class="h-9 px-3 border border-gray-200 hover:bg-gray-50 rounded text-xs font-semibold text-gray-600 flex items-center gap-1.5 bg-white">
                                    <i data-lucide="refresh-cw" class="w-4 h-4"></i> Restaurer
                                </button>
                            `}
                            <button onclick="genererClassesPourAnnee(${id})" class="h-9 px-3 bg-[#5C8ABF] text-white hover:bg-[#4d7daf] rounded text-xs font-semibold flex items-center gap-1.5 border-none">
                                <i data-lucide="layers" class="w-4 h-4"></i> Générer Classes
                            </button>
                            <button onclick="genererEdtPourAnnee(${id})" class="h-9 px-3 bg-[#17203A] text-white hover:bg-[#12192B] rounded text-xs font-semibold flex items-center gap-1.5 border-none">
                                <i data-lucide="play" class="w-4 h-4"></i> Générer EDT
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
            if (window.lucide) lucide.createIcons();
        }

        function renderMentionsAndFilieres() {
            // Render Mentions
            const mentionsContainer = document.getElementById('mentionsList');
            if (allMentions.length === 0) {
                mentionsContainer.innerHTML = `<div class="p-6 text-center text-sm text-gray-500">Aucune mention configurée.</div>`;
            } else {
                mentionsContainer.innerHTML = allMentions.map(m => {
                    const id = prop(m, 'IdMention');
                    const code = esc(prop(m, 'CodeMention'));
                    const nom = esc(prop(m, 'NomMention'));
                    return `
                        <div class="p-4 flex items-center justify-between hover:bg-gray-50 transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider">${code}</span>
                                <span class="font-semibold text-gray-700">${nom}</span>
                            </div>
                            <div class="flex gap-1">
                                <button onclick="editMention(${id}, '${code}', '${nom}')" class="p-1.5 text-gray-400 hover:text-[#17203A] hover:bg-gray-100 rounded-md border-none bg-transparent cursor-pointer transition">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteMention(${id})" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-md border-none bg-transparent cursor-pointer transition">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Render Filières
            const filieresContainer = document.getElementById('filieresTableBody');
            if (allFilieres.length === 0) {
                filieresContainer.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-gray-500">Aucune filière configurée.</td></tr>`;
            } else {
                filieresContainer.innerHTML = allFilieres.map(f => {
                    const id = prop(f, 'IdFiliere');
                    const code = esc(prop(f, 'CodeFiliere'));
                    const nom = esc(prop(f, 'NomFiliere'));
                    const mentionName = f.Mention ? esc(prop(f.Mention, 'NomMention')) : 'N/A';
                    const mentionId = f.Mention ? prop(f.Mention, 'IdMention') : 0;
                    return `
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="py-3 px-4 font-bold text-purple-700">${code}</td>
                            <td class="py-3 px-4 font-medium text-gray-700">${nom}</td>
                            <td class="py-3 px-4 text-xs text-gray-500 font-semibold">${mentionName}</td>
