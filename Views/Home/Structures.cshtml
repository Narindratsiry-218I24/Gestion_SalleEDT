        function renderNiveaux() {
            const container = document.getElementById('niveauxTableBody');
            if (allNiveaux.length === 0) {
                container.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-gray-500">Aucun niveau configuré.</td></tr>`;
                return;
            }

            container.innerHTML = allNiveaux.map(n => {
                const id = prop(n, 'IdNiveau');
                const code = esc(prop(n, 'CodeNiveau'));
                const ordre = prop(n, 'Ordre');
                const mentionName = n.Mention ? esc(prop(n.Mention, 'NomMention')) : 'N/A';
                const mentionId = n.Mention ? prop(n.Mention, 'IdMention') : 0;
                return `
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="py-3 px-4 font-bold text-green-700">${code}</td>
                        <td class="py-3 px-4 font-semibold text-gray-500 text-xs">${mentionName}</td>
                        <td class="py-3 px-4 font-medium text-gray-600">${ordre}</td>
                        <td class="py-3 px-4 text-right">
                            <div class="flex justify-end gap-1">
                                <button onclick="editNiveau(${id}, ${mentionId}, '${code}', ${ordre})" class="p-1.5 text-gray-400 hover:text-[#17203A] hover:bg-gray-100 rounded-md border-none bg-transparent cursor-pointer transition">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteNiveau(${id})" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-md border-none bg-transparent cursor-pointer transition">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
