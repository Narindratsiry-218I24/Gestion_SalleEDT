@model dynamic
@{
    ViewData["Title"] = "Validation des Requêtes";
}
<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Validation des Requêtes</h1>
            <p class="text-gray-500 mt-1">Gérez et validez les demandes d'emploi du temps des enseignants.</p>
        </div>
    </div>

    <!-- Overview KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Total Demandes</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statTotal">--</h4>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-yellow-50 text-yellow-600 flex items-center justify-center">
                <i data-lucide="clock" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">En attente</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statAttente">--</h4>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Approuvées</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statAcceptees">--</h4>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                <i data-lucide="x-circle" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider m-0">Refusées</p>
                <h4 class="text-2xl font-black text-[#17203A] m-0" id="statRefusees">--</h4>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex-1 flex flex-col">
        <div class="flex border-b border-gray-100 bg-gray-50/50">
            <button id="btnTabAttente" class="px-6 py-4 text-sm font-semibold text-[#5C8ABF] border-b-2 border-[#5C8ABF] transition-all" onclick="switchTab('attente')">
                Demandes en attente <span id="badgeAttente" class="ml-2 bg-yellow-100 text-yellow-800 text-xs px-2 py-0.5 rounded-full hidden">0</span>
            </button>
            <button id="btnTabHistorique" class="px-6 py-4 text-sm font-semibold text-gray-500 hover:text-gray-700 transition-all border-b-2 border-transparent" onclick="switchTab('historique')">
                Historique des validations
            </button>
        </div>

        <div class="p-6 h-full min-h-[400px]">
            <div id="demandes-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Rempli en JS -->
            </div>
            
            <!-- Empty State -->
            <div id="emptyState" class="hidden flex flex-col items-center justify-center h-full text-center space-y-4 text-gray-400 py-12">
                <i data-lucide="inbox" class="w-16 h-16 text-gray-300"></i>
                <div>
                    <h3 class="text-lg font-bold text-gray-700">Aucune demande trouvée</h3>
                    <p class="text-sm">Il n'y a aucune requête correspondante pour le moment.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let toutesLesDemandes = [];

    function chargerDemandes() {
        fetch('/api/DemandeEDT')
            .then(res => res.json())
            .then(data => {
                toutesLesDemandes = data;
                mettreAJourKPI();
                afficherDemandes('attente');
            });
    }

    function mettreAJourKPI() {
        const total = toutesLesDemandes.length;
        const attente = toutesLesDemandes.filter(d => ['en_attente_admin', 'proposee_prof', 'contre_proposition_prof', 'en_attente'].includes(d.statut.toLowerCase())).length;
        const acceptees = toutesLesDemandes.filter(d => d.statut.toLowerCase() === 'acceptee').length;
        const refusees = toutesLesDemandes.filter(d => d.statut.toLowerCase() === 'refusee').length;

        document.getElementById('statTotal').textContent = total;
        document.getElementById('statAttente').textContent = attente;
        document.getElementById('statAcceptees').textContent = acceptees;
        document.getElementById('statRefusees').textContent = refusees;

        const badge = document.getElementById('badgeAttente');
        if (attente > 0) {
            badge.textContent = attente;
            badge.classList.remove('hidden');
        } else {
            badge.classList.add('hidden');
        }
    }

    function afficherDemandes(type) {
        const container = document.getElementById('demandes-list');
        const emptyState = document.getElementById('emptyState');
        container.innerHTML = '';

        const filtre = type === 'attente' 
            ? d => ['en_attente_admin', 'proposee_prof', 'contre_proposition_prof', 'en_attente'].includes(d.statut.toLowerCase())
            : d => ['acceptee', 'refusee'].includes(d.statut.toLowerCase());

        const demandesFiltrees = toutesLesDemandes.filter(filtre);

        if (demandesFiltrees.length === 0) {
            container.classList.add('hidden');
            emptyState.classList.remove('hidden');
            emptyState.classList.add('flex');
        } else {
            container.classList.remove('hidden');
            emptyState.classList.add('hidden');
            emptyState.classList.remove('flex');
        }

        demandesFiltrees.forEach(d => {
            const date = new Date(d.dateSouhaitee).toLocaleDateString();
            const badgeColor = type === 'attente' ? 'bg-yellow-50 text-yellow-700' : (d.statut.toLowerCase() === 'acceptee' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700');
            const borderColor = type === 'attente' ? 'border-yellow-400' : (d.statut.toLowerCase() === 'acceptee' ? 'border-green-400' : 'border-red-400');
            
            container.innerHTML += `
                <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow border-l-4 ${borderColor} flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-bold text-gray-800 line-clamp-1" title="${d.matiere ? d.matiere.nomMatiere : 'Nouvelle Demande'}">${d.matiere ? d.matiere.nomMatiere : 'Nouvelle Demande'}</h3>
                            <span class="text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider ${badgeColor}">${d.statut.replace(/_/g, ' ')}</span>
                        </div>
                        <div class="text-sm text-gray-600 mb-4 space-y-1">
                            <div class="flex items-center gap-2"><i data-lucide="calendar" class="w-4 h-4 text-gray-400"></i> ${date}</div>
                            <div class="flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4 text-gray-400"></i> ${d.heureDebutSouhaitee} - ${d.heureFinSouhaitee}</div>
                        </div>
                        <div class="text-xs bg-gray-50/80 p-3 rounded-lg mb-4 text-gray-600 italic">
                            ${d.justification ? `"${d.justification}"` : 'Aucune justification fournie'}
                        </div>
                    </div>
                    ${type === 'attente' ? `
                    <div class="flex space-x-2 mt-4 pt-4 border-t border-gray-50">
                        <button onclick="validerDemande(${d.idDemande}, this)" class="flex-1 bg-green-50 hover:bg-green-100 text-green-700 font-semibold py-2 rounded-lg transition-colors flex justify-center items-center gap-2 text-sm">
                            <i data-lucide="check" class="w-4 h-4"></i> Valider
                        </button>
                        <button onclick="refuserDemande(${d.idDemande}, this)" class="flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2 rounded-lg transition-colors flex justify-center items-center gap-2 text-sm">
                            <i data-lucide="x" class="w-4 h-4"></i> Refuser
                        </button>
                    </div>
                    ` : ''}
                </div>
            `;
        });
        
        if (window.lucide) lucide.createIcons();
    }

    function validerDemande(id, btn) {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>';
        btn.disabled = true;
        if (window.lucide) lucide.createIcons();

        fetch(`/api/DemandeEDT/${id}/Valider`, { method: 'POST' })
            .then(async res => {
                if(res.ok) {
                    Swal.fire('Succès', 'Demande validée.', 'success');
                    chargerDemandes();
                } else {
                    const text = await res.text();
                    Swal.fire('Conflit détecté', text, 'error');
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                    if (window.lucide) lucide.createIcons();
                }
            })
            .catch(err => {
                Swal.fire('Erreur système', 'Impossible de valider.', 'error');
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            });
    }

    function refuserDemande(id, btn) {
        fetch(`/api/DemandeEDT/${id}/Refuser`, { method: 'POST' })
            .then(() => {
                Swal.fire('Refusée', 'La demande a été rejetée.', 'info');
                chargerDemandes();
            });
    }

    function switchTab(type) {
        const btnAttente = document.getElementById('btnTabAttente');
        const btnHistorique = document.getElementById('btnTabHistorique');
        
        if(type === 'attente') {
            btnAttente.className = "px-6 py-4 text-sm font-semibold text-[#5C8ABF] border-b-2 border-[#5C8ABF] transition-all";
            btnHistorique.className = "px-6 py-4 text-sm font-semibold text-gray-500 hover:text-gray-700 transition-all border-b-2 border-transparent";
        } else {
            btnHistorique.className = "px-6 py-4 text-sm font-semibold text-[#5C8ABF] border-b-2 border-[#5C8ABF] transition-all";
            btnAttente.className = "px-6 py-4 text-sm font-semibold text-gray-500 hover:text-gray-700 transition-all border-b-2 border-transparent";
        }
        
        afficherDemandes(type);
    }

    document.addEventListener('DOMContentLoaded', chargerDemandes);
</script>