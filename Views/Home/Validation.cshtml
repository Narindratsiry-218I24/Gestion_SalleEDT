@{
    ViewBag.Title = "Validation";
}

<div class="space-y-8 animate-in fade-in duration-500 mt-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Portail de Validation</h1>
            <p class="text-gray-500 mt-1">Gérez les demandes d'emploi du temps et les réservations de salles en attente.</p>
        </div>
    </div>

    <div id="app-validation-root">
        <div class="flex justify-center items-center py-24 bg-white rounded-xl shadow-sm border border-gray-100">
            <i data-lucide="loader-2" class="w-8 h-8 text-[#17203A] animate-spin"></i>
            <span class="ml-2 text-gray-500 font-bold">Chargement du panneau...</span>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>

    <script type="text/babel">
        const { useState, useEffect } = React;
        const API_BASE = '/api';

        function ValidationApp() {
            const [demandes, setDemandes] = useState([]);
            const [rooms, setRooms] = useState([]);
            const [loading, setLoading] = useState(true);

            // Fetch
            const fetchData = () => {
                setLoading(true);
                Promise.all([
                    fetch(API_BASE + '/DemandeEDT').then(r => r.json()),
                    fetch(API_BASE + '/Salle').then(r => r.json())
                ]).then(([demandesData, roomsData]) => {
                    const actives = demandesData.filter(d => ['en_attente_admin', 'proposee_prof', 'modif_acceptee_prof', 'contre_proposition_prof'].includes(d.Statut?.toLowerCase()));
                    setDemandes(actives);
                    setRooms(roomsData);
                    setLoading(false);
                });
            };

            useEffect(() => { fetchData(); }, []);

            const handleApprove = (id) => {
                fetch(API_BASE + '/DemandeEDT/' + id + '/Valider', { method: 'POST' })
                    .then(res => { if(res.ok) { alert('Demande Validée avec succès!'); fetchData(); } else { alert('Erreur de validation'); } });
            };

            const handleReject = (id) => {
                fetch(API_BASE + '/DemandeEDT/' + id + '/Refuser', { method: 'POST' })
                    .then(res => { if(res.ok) { alert('Demande Refusée.'); fetchData(); } });
            };

            const formatDate = (ds) => ds ? new Date(ds).toLocaleDateString('fr-FR') : '';
            const formatTime = (ts) => ts ? ts.substring(0, 5) : '';

            if (loading) return <div className="text-center font-bold text-gray-500 py-12">Chargement des requêtes...</div>;

            return (
                <div className="space-y-6">
                    <div className="flex items-center justify-between mb-4">
                        <h3 className="text-xl font-bold text-[#17203A] m-0">Demandes de Planification Actives</h3>
                        <span className="bg-[#17203A] text-white px-4 py-1 rounded-full font-bold text-sm shadow-sm">{demandes.length} Active(s)</span>
                    </div>

                    {demandes.length === 0 ? (
                        <div className="bg-white p-8 rounded-xl text-center text-gray-500 shadow-sm border border-gray-100 font-medium">Aucune demande en attente pour le moment.</div>
                    ) : (
                        demandes.map(req => (
                            <div key={req.IdDemande} className="bg-white p-6 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-[#5C8ABF] mb-6 hover:shadow-md transition-shadow">
                                <div className="flex justify-between items-start mb-4 border-b border-gray-50 pb-4">
                                    <h4 className="font-extrabold text-lg text-[#17203A] m-0">REQ-{req.IdDemande} : {req.TypeDemande}</h4>
                                    <span className="bg-amber-100 text-amber-700 px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider">{req.Statut}</span>
                                </div>
                                <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                                    <div className="bg-gray-50 p-4 rounded-lg border border-gray-100">
                                        <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 m-0">Justification</p>
                                        <p className="text-sm text-gray-700 m-0 leading-relaxed">{req.Justification || 'Aucune justification fournie.'}</p>
                                    </div>
                                    <div className="bg-[#f0f4f8] p-4 rounded-lg border border-[#e1e9f2]">
                                        <p className="text-xs font-bold text-[#5C8ABF] uppercase tracking-wider mb-2 m-0">Détails de la demande</p>
                                        <div className="space-y-1 mt-2">
                                            <p className="text-sm text-gray-800 m-0"><strong className="text-[#17203A]">Classe:</strong> {req.Classe?.NomClasse || 'N/A'}</p>
                                            <p className="text-sm text-gray-800 m-0"><strong className="text-[#17203A]">Matière:</strong> {req.Matiere?.NomMatiere || 'N/A'}</p>
                                            <p className="text-sm text-gray-800 m-0"><strong className="text-[#17203A]">Date:</strong> {formatDate(req.DateSouhaitee)}</p>
                                            <p className="text-sm text-gray-800 m-0"><strong className="text-[#17203A]">Heure:</strong> {formatTime(req.HeureDebutSouhaitee)} - {formatTime(req.HeureFinSouhaitee)}</p>
                                            <p className="text-sm text-gray-800 m-0"><strong className="text-[#17203A]">Salle souhaitée:</strong> {req.Salle?.NomSalle || 'N/A'}</p>
                                        </div>
                                    </div>
                                </div>
                                <div className="flex justify-end gap-3 mt-4 border-t border-gray-50 pt-4">
                                    <button onClick={() => handleApprove(req.IdDemande)} className="bg-green-600 hover:bg-green-700 transition-colors text-white font-bold px-6 py-2.5 rounded-lg text-sm border-none cursor-pointer flex items-center gap-2">
                                        <i data-lucide="check-circle" className="w-4 h-4"></i> Valider (Approuver)
                                    </button>
                                    <button onClick={() => handleReject(req.IdDemande)} className="bg-red-50 hover:bg-red-100 transition-colors text-red-600 border border-red-200 font-bold px-6 py-2.5 rounded-lg text-sm cursor-pointer flex items-center gap-2">
                                        <i data-lucide="x-circle" className="w-4 h-4"></i> Refuser
                                    </button>
                                </div>
                            </div>
                        ))
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('app-validation-root'));
        root.render(<ValidationApp />);
    </script>
}