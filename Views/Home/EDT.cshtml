@model dynamic
@{
    ViewData["Title"] = "Emploi du Temps";
}
<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Emploi du Temps</h1>
            <p class="text-gray-500 mt-1">Consultez et planifiez l'emploi du temps de l'établissement.</p>
        </div>
        <div class="flex space-x-3">
            <button onclick="exportEDT('pdf')" class="bg-red-50 text-red-600 hover:bg-red-100 font-semibold py-2 px-4 rounded-lg flex items-center transition-colors text-sm">
                <i data-lucide="file-text" class="w-4 h-4 mr-2"></i> PDF
            </button>
            <button onclick="exportEDT('excel')" class="bg-emerald-50 text-emerald-600 hover:bg-emerald-100 font-semibold py-2 px-4 rounded-lg flex items-center transition-colors text-sm">
                <i data-lucide="sheet" class="w-4 h-4 mr-2"></i> Excel
            </button>
        </div>
    </div>
    
    <!-- Filtres dynamiques -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Classe</label>
            <select id="classeFilter" class="w-full border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm h-10 px-3 bg-gray-50" onchange="loadEDT()">
                <option value="">Toutes les classes</option>
            </select>
        </div>
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Enseignant</label>
            <select id="profFilter" class="w-full border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm h-10 px-3 bg-gray-50" onchange="loadEDT()">
                <option value="">Tous les enseignants</option>
            </select>
        </div>
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Salle</label>
            <select id="salleFilter" class="w-full border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 sm:text-sm h-10 px-3 bg-gray-50" onchange="loadEDT()">
                <option value="">Toutes les salles</option>
            </select>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6 flex-1 items-start">
        <!-- Main Calendar Section -->
        <div class="w-full lg:w-3/4 flex flex-col h-full">
            <!-- Contrôle du Calendrier -->
            <div class="flex items-center justify-between bg-white px-4 py-3 rounded-t-xl border border-gray-100 border-b-0">
                <button onclick="changeWeek(-1)" class="p-2 hover:bg-gray-100 rounded-lg text-gray-600 transition-colors">
                    <i data-lucide="chevron-left" class="w-5 h-5"></i>
                </button>
                <h2 id="currentWeekDisplay" class="font-bold text-lg text-[#17203A]">Semaine du ...</h2>
                <button onclick="changeWeek(1)" class="p-2 hover:bg-gray-100 rounded-lg text-gray-600 transition-colors">
                    <i data-lucide="chevron-right" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Calendrier Hebdomadaire -->
            <div class="bg-white rounded-b-xl shadow-sm border border-gray-100 overflow-x-auto relative">
                <div class="flex justify-center my-8 absolute inset-0 bg-white/80 backdrop-blur-sm z-10 flex-col items-center hidden" id="loader">
                    <i data-lucide="loader-2" class="w-8 h-8 animate-spin text-blue-500 mb-2"></i>
                    <span class="text-sm text-gray-500 font-medium">Chargement du calendrier...</span>
                </div>

                <div class="min-w-[800px]">
                    <!-- En-tête des jours -->
                    <div class="grid grid-cols-7 border-b border-gray-200 bg-gray-50/50">
                        <div class="p-3 text-center border-r border-gray-200 text-xs font-bold text-gray-400 uppercase tracking-wider w-20">Heure</div>
                        <div class="p-3 text-center border-r border-gray-200"><span class="font-bold text-[#17203A]">Lundi</span><br><span id="date-lundi" class="text-xs text-gray-500"></span></div>
                        <div class="p-3 text-center border-r border-gray-200"><span class="font-bold text-[#17203A]">Mardi</span><br><span id="date-mardi" class="text-xs text-gray-500"></span></div>
                        <div class="p-3 text-center border-r border-gray-200"><span class="font-bold text-[#17203A]">Mercredi</span><br><span id="date-mercredi" class="text-xs text-gray-500"></span></div>
                        <div class="p-3 text-center border-r border-gray-200"><span class="font-bold text-[#17203A]">Jeudi</span><br><span id="date-jeudi" class="text-xs text-gray-500"></span></div>
                        <div class="p-3 text-center border-r border-gray-200"><span class="font-bold text-[#17203A]">Vendredi</span><br><span id="date-vendredi" class="text-xs text-gray-500"></span></div>
                        <div class="p-3 text-center"><span class="font-bold text-[#17203A]">Samedi</span><br><span id="date-samedi" class="text-xs text-gray-500"></span></div>
                    </div>

                    <!-- Grille Heures x Jours -->
                    <div class="relative bg-white" style="height: 600px;" id="calendar-grid">
                        <!-- Lignes horizontales pour les heures -->
                        <div class="absolute inset-0 grid grid-rows-10 pointer-events-none">
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">08:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">09:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">10:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">11:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">12:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">13:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">14:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">15:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">16:00</div></div>
                            <div class="border-b border-gray-100 flex"><div class="w-20 text-xs text-gray-400 text-center -mt-2 bg-white pr-2">17:00</div></div>
                        </div>
                        <!-- Colonnes verticales pour les jours -->
                        <div class="absolute inset-0 grid grid-cols-7 ml-20 pointer-events-none">
                            <div class="border-r border-gray-100"></div>
                            <div class="border-r border-gray-100"></div>
                            <div class="border-r border-gray-100"></div>
                            <div class="border-r border-gray-100"></div>
                            <div class="border-r border-gray-100"></div>
                            <div class="border-r border-gray-100"></div>
                            <div></div>
                        </div>

                        <!-- Conteneur des événements -->
                        <div id="events-container" class="absolute inset-0 ml-20">
                            <!-- Les cartes de cours seront injectées ici par JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar droite (Calendrier + Requêtes) -->
        <div class="w-full lg:w-1/4 flex flex-col gap-6">
            <!-- Calendrier Mensuel -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
                <h3 class="font-bold text-[#17203A] mb-4 flex items-center">
                    <i data-lucide="calendar" class="w-5 h-5 mr-2 text-blue-500"></i> Calendrier Mensuel
                </h3>
                <!-- Simple mock pour le calendrier mensuel, un plugin réel comme Pikaday ou FullCalendar (vue mois) pourrait être utilisé -->
                <div class="text-center">
                    <div class="flex justify-between items-center mb-2">
                        <button class="text-gray-500 hover:text-black"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                        <span class="font-semibold text-sm">Juillet 2026</span>
                        <button class="text-gray-500 hover:text-black"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
                    </div>
                    <div class="grid grid-cols-7 gap-1 text-xs text-gray-400 mb-1">
                        <div>L</div><div>M</div><div>M</div><div>J</div><div>V</div><div>S</div><div>D</div>
                    </div>
                    <div class="grid grid-cols-7 gap-1 text-sm">
                        <!-- Mock dates -->
                        <div class="text-gray-300">29</div><div class="text-gray-300">30</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">1</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">2</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">3</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">4</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">5</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">6</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">7</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">8</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">9</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">10</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">11</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer bg-blue-100 text-blue-700 font-bold">12</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">13</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">14</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">15</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">16</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">17</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">18</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">19</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">20</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">21</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">22</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">23</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">24</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">25</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">26</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">27</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">28</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">29</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">30</div>
                        <div class="p-1 hover:bg-gray-100 rounded cursor-pointer">31</div>
                        <div class="text-gray-300">1</div><div class="text-gray-300">2</div>
                    </div>
                </div>
            </div>

            <!-- Requêtes de modification -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex-1">
                <h3 class="font-bold text-[#17203A] mb-4 flex items-center">
                    <i data-lucide="bell" class="w-5 h-5 mr-2 text-yellow-500"></i> Vos Requêtes
                </h3>
                <div id="requests-list" class="space-y-3">
                    <!-- Requêtes mockées ou dynamiques -->
                    <div class="p-3 bg-gray-50 border rounded-lg text-sm">
                        <div class="flex justify-between items-start mb-1">
                            <span class="font-semibold text-[#17203A]">Déplacement CM Algo</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-yellow-100 text-yellow-800">EN ATTENTE</span>
                        </div>
                        <p class="text-xs text-gray-500">Salle 402 - L3 Info</p>
                    </div>
                    <div class="p-3 bg-gray-50 border rounded-lg text-sm">
                        <div class="flex justify-between items-start mb-1">
                            <span class="font-semibold text-[#17203A]">Annulation TP BDD</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-800">VALIDÉE</span>
                        </div>
                        <p class="text-xs text-gray-500">Salle Machine 2 - L2 Info</p>
                    </div>
                </div>
                <a href="/Home/Requetes" class="mt-4 flex items-center justify-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
                    Voir toutes les requêtes <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    let currentDate = new Date();
    // Set to Monday of the current week
    currentDate.setDate(currentDate.getDate() - (currentDate.getDay() || 7) + 1);

    async function chargerDonneesFiltres() {
        try {
            const [classes, profs, salles] = await Promise.all([
                fetch('/api/Classe').then(r => r.json()),
                fetch('/api/Professeur').then(r => r.json()),
                fetch('/api/Salle').then(r => r.json())
            ]);

            const classeFilter = document.getElementById('classeFilter');
            classes.forEach(c => classeFilter.innerHTML += `<option value="${c.idClasse || c.IdClasse}">${c.nomClasse || c.NomClasse}</option>`);
            
            const profFilter = document.getElementById('profFilter');
            profs.forEach(p => profFilter.innerHTML += `<option value="${p.idProfesseur || p.IdProfesseur}">${p.nom || p.Nom} ${p.prenom || p.Prenom}</option>`);
            
            const salleFilter = document.getElementById('salleFilter');
            salles.forEach(s => salleFilter.innerHTML += `<option value="${s.idSalle || s.IdSalle}">${s.nomSalle || s.NomSalle}</option>`);

        } catch (e) {
            console.error("Erreur lors du chargement des filtres", e);
        }
    }

    function updateWeekDisplay() {
        const startOfWeek = new Date(currentDate);
        const endOfWeek = new Date(currentDate);
        endOfWeek.setDate(endOfWeek.getDate() + 5); // Samedi

        const formatOptions = { day: '2-digit', month: 'short' };
        document.getElementById('currentWeekDisplay').textContent = 
            `Semaine du ${startOfWeek.toLocaleDateString('fr-FR', formatOptions)} au ${endOfWeek.toLocaleDateString('fr-FR', formatOptions)}`;

        const jours = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
        for (let i = 0; i < 6; i++) {
            const d = new Date(currentDate);
            d.setDate(d.getDate() + i);
            document.getElementById(`date-${jours[i]}`).textContent = d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        }
    }

    function changeWeek(offset) {
        currentDate.setDate(currentDate.getDate() + (offset * 7));
        updateWeekDisplay();
        loadEDT();
    }

    function timeToMinutes(timeStr) {
        const [hours, minutes] = timeStr.split(':').map(Number);
        return hours * 60 + minutes;
    }

    function loadEDT() {
        const loader = document.getElementById('loader');
        if (loader) {
            loader.classList.remove('hidden');
            loader.classList.add('flex');
        }

        const classe = document.getElementById('classeFilter').value;
        const prof = document.getElementById('profFilter').value;
        const salle = document.getElementById('salleFilter').value;
        
        const params = new URLSearchParams();
        if (classe) params.append('classeId', classe);
        if (prof) params.append('profId', prof);
        if (salle) params.append('salleId', salle);
        
        // In a real app, you would also pass start/end dates of the week to fetch only relevant data
        
        fetch(`/api/EDT?${params.toString()}`)
            .then(res => res.json())
            .then(data => {
                const container = document.getElementById('events-container');
                container.innerHTML = '';
                
                const dayMap = { 'MON': 0, 'TUE': 1, 'WED': 2, 'THU': 3, 'FRI': 4, 'SAT': 5 };
                
                // Helper to get time string from TimeSpan format 'hh:mm:ss'
                const getTimeString = (ts) => {
                    if(!ts) return "00:00";
                    return ts.substring(0, 5);
                };

                data.forEach(seance => {
                    const dayIndex = dayMap[seance.jourSemaine || seance.JourSemaine];
                    if (dayIndex === undefined) return; // Ignore Sunday or invalid

                    const startStr = getTimeString(seance.startTime || seance.StartTime || seance.heureDebut || seance.HeureDebut);
                    const endStr = getTimeString(seance.endTime || seance.EndTime || seance.heureFin || seance.HeureFin);
                    
                    const startMins = timeToMinutes(startStr);
                    const endMins = timeToMinutes(endStr);
                    
                    const gridStartMins = 8 * 60; // 08:00
                    const gridEndMins = 18 * 60; // 18:00
                    
                    if (startMins < gridStartMins || endMins > gridEndMins) return; // Out of grid bounds

                    const topPercent = ((startMins - gridStartMins) / (10 * 60)) * 100;
                    const heightPercent = ((endMins - startMins) / (10 * 60)) * 100;
                    
                    const course = seance.course || seance.Cours || {};
                    const matiere = course.matiere || course.Matiere || { nomMatiere: 'N/A' };
                    const professeur = course.professeur || course.Professeur || { nom: 'N/A' };
                    const salleInfo = seance.salle || seance.Salle || { nomSalle: 'N/A' };
                    const typeCours = course.typeCours || course.TypeCours || 'CM';
                    
                    let bgColor = 'bg-blue-100 border-blue-400 text-blue-800'; // CM default
                    if (typeCours.includes('TP') || typeCours.includes('TD')) bgColor = 'bg-green-100 border-green-400 text-green-800';
                    if (typeCours.toLowerCase().includes('examen')) bgColor = 'bg-red-100 border-red-400 text-red-800';

                    // Mock current time for "pulsing effect" demo
                    const now = new Date();
                    const nowMins = now.getHours() * 60 + now.getMinutes();
                    const isCurrent = (new Date().getDay() === (dayIndex + 1)) && (nowMins >= startMins && nowMins <= endMins);
                    const pulseHtml = isCurrent ? `<span class="absolute top-2 right-2 flex h-3 w-3"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span><span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span></span>` : '';

                    const card = document.createElement('div');
                    card.className = `absolute left-[calc(${(dayIndex / 7) * 100}%+4px)] w-[calc((100%/7)-8px)] rounded-md border-l-4 shadow-sm hover:shadow-md transition-all p-2 cursor-pointer overflow-hidden ${bgColor} ${isCurrent ? 'ring-2 ring-red-400 ring-offset-1' : ''}`;
                    card.style.top = `${topPercent}%`;
                    card.style.height = `calc(${heightPercent}% - 2px)`;
                    
                    // Construct a payload to show in modal
                    const modalPayload = encodeURIComponent(JSON.stringify({
                        matiere: matiere.nomMatiere || matiere.NomMatiere,
                        prof: professeur.nom || professeur.Nom,
                        salle: salleInfo.nomSalle || salleInfo.NomSalle,
                        type: typeCours,
                        horaire: `${startStr} - ${endStr}`,
                        capacity: course.capacity || course.Capacity || 'N/A',
                        objectives: course.objectives || course.Objectives || 'N/A'
                    }));

                    card.innerHTML = `
                        ${pulseHtml}
                        <div class="font-bold text-xs truncate" title="${matiere.nomMatiere || matiere.NomMatiere}">${matiere.nomMatiere || matiere.NomMatiere}</div>
                        <div class="text-[10px] opacity-90 font-medium">${startStr} - ${endStr}</div>
                        <div class="text-[10px] mt-1 font-semibold truncate">${professeur.nom || professeur.Nom}</div>
                        <div class="text-[10px] font-semibold opacity-75 truncate">${salleInfo.nomSalle || salleInfo.NomSalle}</div>
                    `;
                    
                    card.onclick = () => showCourseModal(modalPayload);
                    
                    container.appendChild(card);
                });
                
                if (loader) {
                    loader.classList.add('hidden');
                    loader.classList.remove('flex');
                }
            })
            .catch(err => {
                if (loader) {
                    loader.classList.add('hidden');
                    loader.classList.remove('flex');
                }
                console.error(err);
            });
    }
    
    function showCourseModal(payloadStr) {
        try {
            const data = JSON.parse(decodeURIComponent(payloadStr));
            Swal.fire({
                title: data.matiere,
                html: `
                    <div class="text-left space-y-3 mt-4 text-sm">
                        <p class="flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4 text-gray-500"></i> <strong>Horaire:</strong> ${data.horaire}</p>
                        <p class="flex items-center gap-2"><i data-lucide="tag" class="w-4 h-4 text-gray-500"></i> <strong>Type:</strong> ${data.type}</p>
                        <p class="flex items-center gap-2"><i data-lucide="user" class="w-4 h-4 text-gray-500"></i> <strong>Enseignant:</strong> ${data.prof}</p>
                        <p class="flex items-center gap-2"><i data-lucide="map-pin" class="w-4 h-4 text-gray-500"></i> <strong>Salle:</strong> ${data.salle}</p>
                        <div class="mt-4 p-3 bg-gray-50 rounded-lg">
                            <p class="text-xs text-gray-500 uppercase font-bold tracking-wider mb-1">Capacité Prévue</p>
                            <p>${data.capacity} étudiants</p>
                        </div>
                    </div>
                `,
                confirmButtonText: 'Fermer',
                confirmButtonColor: '#5C8ABF'
            }).then(() => {
                if(window.lucide) lucide.createIcons();
            });
            if(window.lucide) lucide.createIcons();
        } catch(e) { console.error(e); }
    }

    function exportEDT(format) {
        const classe = document.getElementById('classeFilter').value;
        const prof = document.getElementById('profFilter').value;
        const salle = document.getElementById('salleFilter').value;
        
        const params = new URLSearchParams();
        if (classe) params.append('classeId', classe);
        if (prof) params.append('profId', prof);
        if (salle) params.append('salleId', salle);

        const url = format === 'pdf' ? `/api/EDT/ExportPdf?${params.toString()}` : `/api/EDT/ExportExcel?${params.toString()}`;
        window.open(url, '_blank');
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
        updateWeekDisplay();
        chargerDonneesFiltres().then(() => loadEDT());
    });
</script>