@{
    ViewData["Title"] = "Accueil";
}

<div class="relative min-h-screen overflow-hidden bg-[#17203A] text-white selection:bg-[#73A5D4]/30">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#17203A]/95 backdrop-blur-lg">
        <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 no-underline">
                <div class="flex h-12 w-28 items-center justify-center rounded-2xl bg-white p-2 shadow-lg shadow-[#0f172a]/20">
                    <img src="~/images/emit-logo.png" asp-append-version="true" alt="EMIT" class="max-h-full max-w-full object-contain" />
                </div>
                <div class="space-y-1 text-sm">
                    <p class="m-0 font-semibold uppercase tracking-[0.45em] text-[#73A5D4]">Portail</p>
                    <p class="m-0 text-xs text-gray-300">EMIT Gestion EDT</p>
                </div>
            </a>
            <div class="flex items-center gap-3">
                <a asp-controller="Home" asp-action="Planification" class="rounded-full border border-white/15 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:border-[#73A5D4]/40 hover:bg-white/15">Planification</a>
                <a asp-controller="Home" asp-action="Connexion" class="group inline-flex items-center gap-2 rounded-full bg-[#73A5D4] px-6 py-3 text-sm font-bold text-white shadow-lg shadow-[#73A5D4]/25 transition hover:bg-[#5C8ABF] button-hero">Connexion <i data-lucide="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="relative overflow-hidden py-24 sm:py-32">
            <div class="pointer-events-none absolute -left-24 top-12 h-72 w-72 rounded-full bg-[#73A5D4]/20 blur-3xl" data-parallax-speed="0.16"></div>
            <div class="pointer-events-none absolute right-0 top-14 h-64 w-64 rounded-full bg-[#5C8ABF]/20 blur-3xl" data-parallax-speed="0.08"></div>
            <div class="pointer-events-none absolute bottom-0 left-10 h-72 w-72 rounded-full bg-[#73A5D4]/10 blur-3xl" data-parallax-speed="0.12"></div>

            <div class="mx-auto max-w-7xl px-6">
                <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
                    <div class="lg:col-span-7">
                        <div class="space-y-6">
                            <p class="text-sm font-semibold uppercase tracking-[0.4em] text-[#73A5D4] scroll-appear">Assistant de Planification</p>
                            <h1 class="scroll-appear text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">Gestion intelligente des emplois du temps, <span class="text-[#73A5D4]">simplifiée</span>.</h1>
                            <p class="scroll-appear max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">Planifiez vos cours, gérez les salles et suivez les conflits depuis une interface moderne qui met l'expérience admin au cœur de l'établissement.</p>
                            <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                                <a asp-controller="Home" asp-action="Planification" class="button-hero inline-flex items-center justify-center rounded-full bg-[#73A5D4] px-8 py-4 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#5C8ABF]">Commencer la planification</a>
                                <a href="#features" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-8 py-4 text-base font-semibold text-white transition hover:bg-white/15">Voir les fonctionnalités</a>
                            </div>
                            <div class="grid gap-3 sm:grid-cols-3 text-sm text-slate-300">
                                <div class="flex items-center gap-2"><i data-lucide="check-circle" class="h-4 w-4 text-green-400"></i> Réservations fluides</div>
                                <div class="flex items-center gap-2"><i data-lucide="check-circle" class="h-4 w-4 text-[#73A5D4]"></i> Analyse rapide</div>
                                <div class="flex items-center gap-2"><i data-lucide="check-circle" class="h-4 w-4 text-blue-300"></i> Interface responsive</div>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-5">
                        <div class="relative overflow-hidden rounded-[40px] border border-white/10 bg-[#0f172a]/90 p-8 shadow-2xl shadow-slate-950/40 scroll-appear">
                            <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-[#73A5D4]/15 to-transparent blur-3xl"></div>
                            <div class="absolute right-6 top-10 h-10 w-10 rounded-full bg-[#73A5D4]/30 blur-2xl"></div>
                            <div class="relative z-10 grid gap-6">
                                <div class="rounded-[32px] border border-white/5 bg-[#11203b]/90 p-6 shadow-inner shadow-slate-900/20">
                                    <div class="flex items-center justify-between gap-3">
                                        <div>
                                            <p class="text-xs uppercase tracking-[0.35em] text-slate-400">Planning</p>
                                            <p class="mt-3 text-xl font-black text-white">A101 disponible</p>
                                        </div>
                                        <span class="rounded-full bg-[#73A5D4]/15 px-3 py-1 text-xs font-semibold text-[#cbe7ff]">75% occupé</span>
                                    </div>
                                </div>
                                <div class="rounded-[32px] border border-white/5 bg-[#0f172a]/90 p-6 shadow-inner shadow-slate-900/20">
                                    <p class="text-xs uppercase tracking-[0.35em] text-slate-400">Salles</p>
                                    <p class="mt-3 text-xl font-black text-white">18 salles optimisées</p>
                                    <p class="mt-2 text-sm text-slate-400">Sélection automatique de la meilleure salle selon la capacité et la localisation.</p>
                                </div>
                            </div>
                            <div class="animate-float absolute -bottom-6 left-1/2 w-[320px] -translate-x-1/2 rounded-3xl bg-[#173358]/95 p-4 shadow-2xl shadow-slate-950/20">
                                <div class="grid grid-cols-3 gap-4 text-center text-white">
                                    <div><span class="block text-2xl font-black">24</span><span class="text-xs text-slate-400">Professeurs</span></div>
                                    <div><span class="block text-2xl font-black">3</span><span class="text-xs text-slate-400">Conflits</span></div>
                                    <div><span class="block text-2xl font-black">12</span><span class="text-xs text-slate-400">Cours</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="features" class="border-t border-white/10 bg-[#12192B] py-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mx-auto mb-16 max-w-2xl space-y-4 text-center">
                    <h2 class="text-xs font-bold uppercase tracking-[0.4em] text-[#73A5D4]">Une Gestion Optimisée</h2>
                    <p class="text-3xl font-extrabold tracking-tight text-white md:text-4xl">Fonctionnalités clés du portail</p>
                </div>
                <div class="grid gap-8 md:grid-cols-3">
                    <article class="rounded-[32px] border border-white/10 bg-[#17203A] p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#73A5D4]/40 hover:shadow-lg">
                        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-3xl bg-[#73A5D4]/15 text-[#73A5D4]"><i data-lucide="door-open" class="h-6 w-6"></i></div>
                        <h3 class="mb-3 text-lg font-bold text-white">Disponibilité des salles</h3>
                        <p class="text-sm leading-relaxed text-slate-400">Suivez en temps réel l’occupation de chaque salle et sécurisez vos créneaux.</p>
                    </article>
                    <article class="rounded-[32px] border border-white/10 bg-[#17203A] p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#73A5D4]/40 hover:shadow-lg">
                        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-3xl bg-[#73A5D4]/15 text-[#73A5D4]"><i data-lucide="calendar" class="h-6 w-6"></i></div>
                        <h3 class="mb-3 text-lg font-bold text-white">Emploi du temps interactif</h3>
                        <p class="text-sm leading-relaxed text-slate-400">Visualisation et modification des créneaux en quelques clics.</p>
                    </article>
                    <article class="rounded-[32px] border border-white/10 bg-[#17203A] p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#73A5D4]/40 hover:shadow-lg">
                        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-3xl bg-[#73A5D4]/15 text-[#73A5D4]"><i data-lucide="shield-check" class="h-6 w-6"></i></div>
                        <h3 class="mb-3 text-lg font-bold text-white">Validation centralisée</h3>
                        <p class="text-sm leading-relaxed text-slate-400">Validez ou rejetez les demandes en tenant compte des conflits horaires.</p>
                    </article>
                </div>
            </div>
        </section>

        <footer class="border-t border-white/15 bg-[#12192B] pb-8 pt-16 text-white">
            <div class="mx-auto mb-16 grid max-w-7xl grid-cols-1 gap-12 px-6 md:grid-cols-4">
                <div>
                    <h3 class="mb-6 text-lg font-bold">Navigation</h3>
                    <ul class="space-y-4 text-gray-400">
                        <li><a href="#features" class="text-gray-400 hover:text-[#73A5D4]">Formations</a></li>
                        <li><a href="#features" class="text-gray-400 hover:text-[#73A5D4]">Projets</a></li>
                        <li><a href="#features" class="text-gray-400 hover:text-[#73A5D4]">Recherche</a></li>
                        <li><a href="#features" class="text-gray-400 hover:text-[#73A5D4]">Partenaires</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="mb-6 text-lg font-bold">Contact</h3>
                    <ul class="space-y-6 text-gray-400">
                        <li class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white"><i data-lucide="mail" class="h-[18px] w-[18px]"></i></span>renseignement@emit.mg</li>
                        <li class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white"><i data-lucide="phone" class="h-[18px] w-[18px]"></i></span>+261 33 70 470 00</li>
                        <li class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white"><i data-lucide="map-pin" class="h-[18px] w-[18px]"></i></span>Fianarantsoa, Madagascar</li>
                    </ul>
                </div>
                <div>
                    <h3 class="mb-6 text-lg font-bold">Rejoignez-nous</h3>
                    <p class="mb-6 leading-relaxed text-gray-400">Découvrez nos formations et commencez votre parcours vers l'excellence.</p>
                    <a href="#features" class="inline-flex rounded-full bg-[#73A5D4] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#5C8ABF]">Nos formations</a>
                </div>
                <div>
                    <h3 class="mb-6 text-lg font-bold">Réseaux sociaux</h3>
                    <div class="flex items-center gap-3">
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white hover:bg-[#73A5D4]">Fb</a>
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white hover:bg-[#73A5D4]">Ig</a>
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white hover:bg-[#73A5D4]">In</a>
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 text-white hover:bg-[#73A5D4]">X</a>
                    </div>
                </div>
            </div>
            <div class="mx-auto mb-8 flex max-w-7xl items-center justify-center px-6">
                <div class="h-px flex-1 bg-white/10"></div><div class="h-3 w-3 rounded-full bg-[#73A5D4]"></div><div class="h-px flex-1 bg-white/10"></div>
            </div>
            <div class="mx-auto max-w-7xl px-6 text-sm text-gray-500">&copy; @DateTime.Now.Year École de Management et d'Innovation Technologique</div>
        </footer>
    </main>
</div>
