@model Gestion_SalleClasseEDT.Models.Cours
@{
    ViewBag.Title = "Détails du Cours - " + (Model.Matiere?.NomMatiere ?? "N/A");
}

<div class="space-y-6">
    <div class="flex flex-col md:flex-row justify-between md:items-end gap-4 bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <div>
            <h1 class="text-2xl font-bold text-[#17203A] mb-1">@(Model.Matiere?.NomMatiere ?? "Cours")</h1>
            <p class="text-gray-500 m-0">@Model.Matiere?.NomMatiere - @Model.TypeCours</p>
        </div>
        <div class="flex items-center gap-3">
            @{
                var badgeClass = Model.Statut == "Planifie" || Model.Statut == "EnCours" ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800";
            }
            <span class="px-3 py-1 rounded-full text-sm font-medium @badgeClass">@Model.Statut</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-bold text-[#17203A] mb-4">Progression</h2>
                
                <div class="flex justify-between text-sm text-gray-500 mb-2">
                    <span>Réalisé : @Model.RealizedHours h</span>
                    <span>Restant : @Model.RemainingHours h</span>
                    <span>Total : @Model.VolumeHours h</span>
                </div>
                
                <div class="w-full bg-gray-200 rounded-full h-4">
                    <div class="bg-blue-600 h-4 rounded-full" style="width: @Math.Round(Model.Progression)%"></div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-bold text-[#17203A] mb-4">Séances (@Model.Seances.Count)</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-600">
                        <thead class="text-xs uppercase bg-gray-50 text-gray-500">
                            <tr>
                                <th class="px-4 py-3">Date</th>
                                <th class="px-4 py-3">Heure</th>
                                <th class="px-4 py-3">Salle</th>
                                <th class="px-4 py-3">Heures Validées</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Seances.OrderByDescending(x => x.Date))
                            {
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="px-4 py-3">@s.Date.ToShortDateString()</td>
                                    <td class="px-4 py-3">@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                                    <td class="px-4 py-3">@(s.Salle?.NomSalle ?? "N/A")</td>
                                    <td class="px-4 py-3 font-medium text-[#17203A]">@s.RealizedHours h</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-bold text-[#17203A] mb-4">Informations</h2>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-start gap-3">
                        <i data-lucide="user" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                        <div>
                            <span class="block text-gray-500">Professeur</span>
                            <span class="font-medium text-gray-900">@(Model.Professeur?.Nom ?? "N/A") @(Model.Professeur?.Prenom)</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <i data-lucide="users" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                        <div>
                            <span class="block text-gray-500">Classe</span>
                            <span class="font-medium text-gray-900">@(Model.Classe?.NomClasse ?? "N/A")</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <i data-lucide="monitor-play" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                        <div>
                            <span class="block text-gray-500">Mode d'enseignement</span>
                            <span class="font-medium text-gray-900">@Model.Mode</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <i data-lucide="users" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                        <div>
                            <span class="block text-gray-500">Capacité</span>
                            <span class="font-medium text-gray-900">@Model.Capacity étudiants</span>
                        </div>
                    </li>
                </ul>
            </div>
            
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-bold text-[#17203A] mb-4">Planifier une Séance</h2>
                <form id="planSeanceForm" class="space-y-3">
                    <input type="hidden" id="courseId" value="@Model.IdCours" />
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Date</label>
                        <input type="date" id="sDate" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Début</label>
                            <input type="time" id="sStart" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Fin</label>
                            <input type="time" id="sEnd" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Salle (ID)</label>
                        <input type="number" id="sSalle" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" placeholder="Optionnel" />
                    </div>
                    <button type="submit" class="w-full bg-[#17203A] hover:bg-[#12192b] text-white py-2 rounded-md text-sm font-medium transition-colors">
                        Ajouter Séance
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('planSeanceForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.textContent = 'En cours...';

            const courseId = document.getElementById('courseId').value;
            const payload = {
                Date: document.getElementById('sDate').value,
                StartTime: document.getElementById('sStart').value + ":00",
                EndTime: document.getElementById('sEnd').value + ":00",
                SalleId: document.getElementById('sSalle').value ? parseInt(document.getElementById('sSalle').value) : null
            };

            try {
                const res = await fetch(`/api/Cours/${courseId}/Seance`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if(res.ok) {
                    alert('Séance planifiée !');
                    window.location.reload();
                } else {
                    const err = await res.json();
                    alert("Erreur: " + err.Message);
                }
            } catch (err) {
                alert("Erreur réseau");
            } finally {
                btn.disabled = false;
                btn.textContent = 'Ajouter Séance';
            }
        });
    </script>
}