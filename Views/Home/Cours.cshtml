@model Gestion_SalleClasseEDT.Models.ViewModels.CoursListViewModel
@{
    ViewBag.Title = "Cours";
    var mentions = ViewBag.Mentions as List<Gestion_SalleClasseEDT.Models.Mention> ?? new List<Gestion_SalleClasseEDT.Models.Mention>();
    var niveaux = ViewBag.Niveaux as List<Gestion_SalleClasseEDT.Models.Niveau> ?? new List<Gestion_SalleClasseEDT.Models.Niveau>();
    var statuts = ViewBag.Statuts as List<string> ?? new List<string>();
}

<div class="space-y-6 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Gestion des Cours</h1>
            <p class="text-gray-500 mt-1">Filtrez, recherchez et gérez tous les cours de l'établissement.</p>
        </div>
        <div class="flex gap-2">
            <!-- Bouton de création supprimé car la création de cours se fait automatiquement via la matière -->
        </div>
    </div>

    <!-- Filtres -->
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
        <form method="get" action="@Url.Action("Cours")" id="filterForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Mention</label>
                <select name="mention" id="filterMention" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Toutes les mentions</option>
                    @foreach (var m in mentions)
                    {
                        <option value="@m.NomMention" selected="@(Model?.FilterMention == m.NomMention)">
                            @m.NomMention
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Cycle</label>
                <select name="cycle" id="filterCycle" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les cycles</option>
                    <option value="Licence">Licence</option>
                    <option value="Master">Master</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Niveau</label>
                <select name="niveau" id="filterNiveau" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les niveaux</option>
                    @foreach (var n in niveaux.OrderBy(n => n.Ordre))
                    {
                        <option value="@n.CodeNiveau" selected="@(Model?.FilterNiveau == n.CodeNiveau)">
                            @n.CodeNiveau
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Filière / Parcours</label>
                <select name="parcours" id="filterParcours" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les parcours</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Statut</label>
                <select name="statut" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les statuts</option>
                    @foreach (var s in statuts)
                    {
                        <option value="@s" selected="@(Model?.FilterStatut == s)">
                            @s
                        </option>
                    }
                </select>
            </div>

            <div class="md:col-span-3">
                <label class="block text-xs font-medium text-gray-700 mb-1">Recherche</label>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                    <input type="text" name="search" value="@Model?.SearchTerm" placeholder="Rechercher par matière, code, enseignant..." 
                           class="w-full pl-9 pr-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="w-full bg-[#17203A] hover:bg-[#12192B] text-white px-4 py-2 rounded-lg transition-colors font-medium">
                    <i data-lucide="filter" class="w-4 h-4 inline mr-1"></i> Filtrer
                </button>
                <button type="reset" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors" onclick="resetFilters()">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Résumé des filtres actifs -->
    @if (!string.IsNullOrEmpty(Model?.FilterMention) || !string.IsNullOrEmpty(Model?.FilterNiveau) || !string.IsNullOrEmpty(Model?.FilterParcours))
    {
        <div class="flex flex-wrap gap-2 items-center text-sm text-gray-600 bg-gray-50 p-3 rounded-lg">
            <span class="font-medium text-gray-700">Filtres actifs :</span>
            @if (!string.IsNullOrEmpty(Model.FilterMention))
            {
                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs">
                    Mention : @Model.FilterMention
                    <a href="@Url.Action("Cours", new { niveau = Model.FilterNiveau, parcours = Model.FilterParcours, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-blue-600 hover:text-blue-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterNiveau))
            {
                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs">
                    Niveau : @Model.FilterNiveau
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, parcours = Model.FilterParcours, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-green-600 hover:text-green-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterParcours))
            {
                <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-xs">
                    Parcours : @Model.FilterParcours
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, niveau = Model.FilterNiveau, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-purple-600 hover:text-purple-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-xs">
                    Recherche : "@Model.SearchTerm"
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, niveau = Model.FilterNiveau, parcours = Model.FilterParcours, statut = Model.FilterStatut })" class="ml-1 text-gray-600 hover:text-gray-800">×</a>
                </span>
            }
        </div>
    }

    <!-- Table des cours -->
    <partial name="_CoursTable" model="Model" />

    

                    @section Scripts {
    <script>
        function openCreateCourseModal() {
            document.getElementById('createCourseModal').classList.remove('hidden');
        }

        function closeCreateCourseModal() {
            document.getElementById('createCourseModal').classList.add('hidden');
        }

        function resetFilters() {
            window.location.href = '@Url.Action("Cours")';
        }

        // Configuration des parcours par mention et niveau
        const parcoursConfig = {
            "Informatique": {
                "Licence": ["DA2I"],
                "Master": ["M2I", "SDIA", "SIGD"]
            },
            "Management": {
                "Licence": ["AES"],
                "Master": ["AE", "MEAS"]
            },
            "Multimédia": {
                "Licence": ["ICM"],
                "Master": ["RPO", "RCPO"]
            }
        };

        // --- Filtres dépendants ---
        document.addEventListener('DOMContentLoaded', function() {
            const mentionSelect = document.getElementById('filterMention');
            const cycleSelect = document.getElementById('filterCycle');
            const niveauSelect = document.getElementById('filterNiveau');
            const parcoursSelect = document.getElementById('filterParcours');

            // Set current cycle from URL if available
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('cycle')) {
                cycleSelect.value = urlParams.get('cycle');
            }

            function updateNiveauOptions() {
                const cycle = cycleSelect.value;
                Array.from(niveauSelect.options).forEach(opt => {
                    if (opt.value === "") return;
                    if (cycle === "Licence" && opt.value.startsWith("L")) opt.style.display = "block";
                    else if (cycle === "Master" && opt.value.startsWith("M")) opt.style.display = "block";
                    else if (cycle) opt.style.display = "none";
                    else opt.style.display = "block";
                });
                updateParcoursOptions();
            }

            function updateParcoursOptions() {
                const mention = mentionSelect.value;
                const cycle = cycleSelect.value;
                
                parcoursSelect.innerHTML = '<option value="">Tous les parcours</option>';
                
                if (mention && cycle) {
                    const parcours = parcoursConfig[mention]?.[cycle] || [];
                    
                    parcours.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p;
                        opt.textContent = p;
                        parcoursSelect.appendChild(opt);
                    });

                    // Sélectionner le parcours actuel s'il existe
                    const currentParcours = '@Model?.FilterParcours';
                    if (currentParcours) {
                        parcoursSelect.value = currentParcours;
                    }
                }
            }

            mentionSelect.addEventListener('change', updateParcoursOptions);
            cycleSelect.addEventListener('change', updateNiveauOptions);
            niveauSelect.addEventListener('change', updateParcoursOptions);

            // Initialiser
            updateNiveauOptions();
            if (mentionSelect.value && cycleSelect.value) {
                updateParcoursOptions();
            }
        });

        
        // --- Soumission du formulaire de création ---
        document.getElementById('createCourseForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const matSelect = document.getElementById('courseMatiereId');
            const affId = parseInt(matSelect.value);
            if (!affId) return;

            const typeSelect = document.getElementById('courseType');
            const type = typeSelect.value || 'CM';

            const payload = {
                IdAffectation: affId,
                TypeCours: type,
                Mode: 'Presentiel',
                Statut: 'Cree'
            };

            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin inline mr-1"></i> Création...';

            try {
                const response = await fetch('/api/Cours', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const createdCourse = await response.json();
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Cours créé avec succès !',
                        text: 'Passage à l\'étape de planification...',
                        timer: 1500,
                        showConfirmButton: false
                    });

                    closeCreateCourseModal();

                    setTimeout(() => {
                        const courseId = createdCourse.idCours || createdCourse.IdCours || createdCourse.id;
                        if (typeof openNewPlanificationModal === 'function') {
                            openNewPlanificationModal(courseId);
                        } else {
                            window.location.href = '/Planification?courseId=' + courseId;
                        }
                    }, 1500);
                } else {
                    const error = await response.json();
                    throw new Error(error.Message || 'Erreur lors de la création');
                }
            } catch (err) {
                Swal.fire('Erreur', err.message, 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Créer et Planifier';
            }
        });

        async function handleNiveauChangeForCreation() {
            const niveauId = document.getElementById('courseNiveauId').value;
            const mentionSel = document.getElementById('courseMentionId');
            const mentionNom = mentionSel.options[mentionSel.selectedIndex]?.getAttribute('data-nom') || mentionSel.options[mentionSel.selectedIndex]?.text;
            const cycleSel = document.getElementById('courseCycle').value;
            const selFil = document.getElementById('courseFiliereId');
            
            selFil.innerHTML = '<option value="">Sélectionnez une filière</option>';
            selFil.disabled = true;
            document.getElementById('courseMatiereId').innerHTML = '<option value="">Sélectionnez d\'abord mention, cycle, niveau et filière</option>';
            document.getElementById('courseMatiereId').disabled = true;

            if (!niveauId) return;

            try {
                // Utiliser la configuration stricte (parcoursConfig)
                const parcoursAutorises = parcoursConfig[mentionNom]?.[cycleSel] || [];
                
                if (parcoursAutorises.length > 0) {
                    // Si on a une configuration locale, on l'utilise directement
                    // sans se fier à l'API qui ramène peut-être tout
                    const resFil = await fetch(`/api/Matiere/Filieres`);
                    if (resFil.ok) {
                        const filieres = await resFil.json();
                        filieres.forEach(f => {
                            const nomF = f.nomFiliere || f.NomFiliere;
                            if (parcoursAutorises.includes(nomF)) {
                                selFil.innerHTML += `<option value="${f.idFiliere || f.IdFiliere}">${nomF}</option>`;
                            }
                        });
                        selFil.disabled = false;
                    }
                } else {
                    const mentionId = mentionSel.value;
                    const resFil = await fetch(`/api/Matiere/Filieres?niveauId=${niveauId}&mentionId=${mentionId}`);
                    if (resFil.ok) {
                        const filieres = await resFil.json();
                        filieres.forEach(f => {
                            selFil.innerHTML += `<option value="${f.idFiliere || f.IdFiliere}">${f.nomFiliere || f.NomFiliere}</option>`;
                        });
                        selFil.disabled = false;
                    }
                }
            } catch(e) {
                console.error(e);
            }
            
            loadMatieresNonPlanifiees();
        }

        function updateCycleOptions() {
            const mentionSel = document.getElementById('courseMentionId');
            const cycleSel = document.getElementById('courseCycle');
            const nivSel = document.getElementById('courseNiveauId');
            const filSel = document.getElementById('courseFiliereId');
            const matSel = document.getElementById('courseMatiereId');
            
            if (!mentionSel.value) {
                cycleSel.disabled = true; cycleSel.value = "";
                nivSel.disabled = true; nivSel.innerHTML = '<option value="">Sélectionnez</option>';
                filSel.disabled = true; filSel.innerHTML = '<option value="">Sélectionnez</option>';
                matSel.disabled = true; matSel.innerHTML = '<option value="">Sélectionnez d\'abord mention, cycle, niveau et filière</option>';
                return;
            }
            cycleSel.disabled = false;
            cycleSel.value = "";
            nivSel.disabled = true; nivSel.innerHTML = '<option value="">Sélectionnez d\'abord le cycle</option>';
            filSel.disabled = true; filSel.innerHTML = '<option value="">Sélectionnez d\'abord le cycle</option>';
            matSel.disabled = true; matSel.innerHTML = '<option value="">Sélectionnez d\'abord mention, cycle, niveau et filière</option>';
        }

        async function loadNiveauxAndFilieresForCreation() {
            const mentionSel = document.getElementById('courseMentionId');
            const cycleSel = document.getElementById('courseCycle');
            const mentionId = mentionSel.value;
            const mentionNom = mentionSel.options[mentionSel.selectedIndex]?.getAttribute('data-nom');
            const cycle = cycleSel.value;
            
            const selNiv = document.getElementById('courseNiveauId');
            const selFil = document.getElementById('courseFiliereId');
            const matSel = document.getElementById('courseMatiereId');
            
            selNiv.innerHTML = '<option value="">Sélectionnez un niveau</option>';
            selFil.innerHTML = '<option value="">Sélectionnez une filière</option>';
            matSel.innerHTML = '<option value="">Sélectionnez d\'abord mention, cycle, niveau et filière</option>';
            
            selNiv.disabled = true;
            selFil.disabled = true;
            matSel.disabled = true;
            
            if (!mentionId || !cycle) return;

            try {
                // Récupérer les niveaux spécifiques à cette MENTION
                const resNiv = await fetch(`/api/Niveau`);
                if (resNiv.ok) {
                    const tousNiveaux = await resNiv.json();
                    
                    tousNiveaux.forEach(n => {
                        const code = n.codeNiveau || n.CodeNiveau;
                        const idMent = n.idMention || n.IdMention;
                        
                        // On ne garde que les niveaux de la mention sélectionnée
                        if (idMent == mentionId) {
                            if ((cycle === 'Licence' && code.startsWith('L')) || (cycle === 'Master' && code.startsWith('M'))) {
                                selNiv.innerHTML += `<option value="${n.idNiveau || n.IdNiveau}">${code}</option>`;
                            }
                        }
                    });
                    
                    selNiv.disabled = false;
                }
                
                // Note : Les filières seront chargées par handleNiveauChangeForCreation 
                // une fois qu'un niveau sera sélectionné.
            } catch (e) {
                console.error(e);
            }
        }

        let currentMatieresOptions = [];

        async function loadMatieresNonPlanifiees() {
            const niveauId = document.getElementById('courseNiveauId').value;
            const filiereId = document.getElementById('courseFiliereId').value;
            const filiereNom = document.getElementById('courseFiliereId').options[document.getElementById('courseFiliereId').selectedIndex]?.text;
            const mentionId = document.getElementById('courseMentionId').value;
            
            const sel = document.getElementById('courseMatiereId');
            
            if (!niveauId || !filiereId) {
                sel.disabled = true;
                sel.innerHTML = '<option value="">Sélectionnez d\'abord mention, cycle, niveau et filière</option>';
                return;
            }

            sel.innerHTML = '<option value="">Recherche des matières...</option>';
            sel.disabled = true;

            try {
                // Essayer l'API existante (peut-être qu'elle a besoin d'un id filiere, mais on a un texte)
                // Donc, on va appeler l'API de base et si la filiereId n'est pas un nombre, on utilise une route alternative si elle existe.
                const res = await fetch(`/api/Matiere/NonPlanifiees?filiereId=${filiereId}&niveauId=${niveauId}&mentionId=${mentionId}`);
                if (!res.ok) throw new Error("API call failed");
                const data = await res.json();
                currentMatieresOptions = data;

                if (data.length === 0) {
                    sel.innerHTML = '<option value="">Aucune matière disponible pour cette sélection</option>';
                    return;
                }

                sel.innerHTML = '<option value="">Sélectionnez une matière à créer en cours</option>';
                data.forEach(m => {
                    sel.innerHTML += `<option value="${m.idAffectation || m.IdAffectation}">${m.nomMatiere || m.NomMatiere} - Prof: ${m.professeurNom || m.ProfesseurNom}</option>`;
                });
                sel.disabled = false;
            } catch(e) {
                sel.innerHTML = '<option value="">Sélectionnez une matière (Vérifiez les données)</option>';
                // If API fails because filiereId is a string instead of ID, we might need a better endpoint, 
                // but we enable it anyway to let the user see the problem or we show error.
            }
        }

        function updateCreationSummary() {
            const matSelect = document.getElementById('courseMatiereId');
            const typeSelect = document.getElementById('courseType');
            
            if (!matSelect.value) {
                document.getElementById('creationSummary').innerHTML = 'Veuillez sélectionner une matière.';
                return;
            }

            const affId = parseInt(matSelect.value);
            const m = currentMatieresOptions.find(x => (x.idAffectation || x.IdAffectation) === affId);
            const type = typeSelect.value || 'CM';
            
            if (m) {
                let vol = 0;
                if (type === 'CM') vol = m.heuresCm || m.HeuresCm;
                else if (type === 'TD') vol = m.heuresTd || m.HeuresTd;
                else if (type === 'TP') vol = m.heuresTp || m.HeuresTp;
                
                document.getElementById('creationSummary').innerHTML = `
                    Matière : <strong class="text-indigo-700">${m.nomMatiere || m.NomMatiere} (${type})</strong> <br/>
                    Volume récupéré : <strong class="text-indigo-700">${vol}h</strong> <br/>
                    Enseignant assigné par admin : <strong class="text-indigo-700">${m.professeurNom || m.ProfesseurNom}</strong>
                `;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Niveaux and Filieres are now loaded based on Mention selection
        });

    </script>
}   






