@model IEnumerable<Gestion_SalleClasseEDT.Models.Cours>
@{
    ViewBag.Title = "Planification des Cours";
}

<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Planification des Cours</h1>
            <p class="text-gray-500 mt-1">Gérez la planification et l'attribution des salles (A-D) aux cours.</p>
        </div>
    </div>

    <!-- Filter Partial -->
    <partial name="_Filter" />

    <!-- Table Partial -->
    <partial name="_CoursTable" model="Model" />

    <!-- CRUD Modal -->
    <div id="crud-modal" tabindex="-1" aria-hidden="true" class="hidden fixed inset-0 z-[100] w-full h-full bg-black/50 backdrop-blur-sm overflow-y-auto overflow-x-hidden justify-center items-start pt-10 transition-opacity">
        <div class="relative p-4 w-full max-w-2xl max-h-full mx-auto">
            <div class="relative bg-white rounded-xl shadow-2xl">
                <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t">
                    <h3 class="text-xl font-bold text-gray-900">
                        Créer un nouveau cours
                    </h3>
                    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-toggle="crud-modal">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <!-- Formulaire de Création -->
                <form class="p-4 md:p-5" id="planificationForm">
                    <div class="grid gap-6 mb-6 grid-cols-2">
                        <div class="col-span-2">
                            <label for="idMatiere" class="block mb-2 text-sm font-medium text-gray-900">Matière</label>
                            <select id="idMatiere" name="idMatiere" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" required>
                                <option value="">Chargement...</option>
                            </select>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="idClasse" class="block mb-2 text-sm font-medium text-gray-900">Classe</label>
                            <select id="idClasse" name="idClasse" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="">Chargement...</option>
                            </select>
                        </div>
                        
                        <div class="col-span-2 sm:col-span-1">
                            <label for="idProfesseur" class="block mb-2 text-sm font-medium text-gray-900">Professeur</label>
                            <select id="idProfesseur" name="idProfesseur" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="">Chargement...</option>
                            </select>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="idSemestre" class="block mb-2 text-sm font-medium text-gray-900">Semestre</label>
                            <select id="idSemestre" name="idSemestre" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="">Chargement...</option>
                            </select>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label for="volumeHours" class="block mb-2 text-sm font-medium text-gray-900">Volume Horaire</label>
                            <input type="number" name="volumeHours" id="volumeHours" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Ex: 60" required="">
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="capacity" class="block mb-2 text-sm font-medium text-gray-900">Capacité (Etudiants)</label>
                            <input type="number" name="capacity" id="capacity" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Ex: 50" required="">
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label for="typeCours" class="block mb-2 text-sm font-medium text-gray-900">Type de Cours</label>
                            <select id="typeCours" name="typeCours" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="CM">Cours Magistral (CM)</option>
                                <option value="TD">Travaux Dirigés (TD)</option>
                                <option value="TP">Travaux Pratiques (TP)</option>
                                <option value="Seminaire">Séminaire</option>
                            </select>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="mode" class="block mb-2 text-sm font-medium text-gray-900">Mode d'enseignement</label>
                            <select id="mode" name="mode" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="Presentiel">Présentiel</option>
                                <option value="EnLigne">En ligne</option>
                                <option value="Hybride">Hybride</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-3 border-t pt-4 border-gray-100">
                        <button type="button" data-modal-toggle="crud-modal" class="text-gray-600 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900">
                            Annuler
                        </button>
                        <button type="submit" class="text-white inline-flex items-center bg-[#17203A] hover:bg-[#12192B] focus:ring-4 focus:outline-none focus:ring-[#17203A]/50 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                            <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                            Créer le Cours
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Modal Toggles
            const modalToggles = document.querySelectorAll('[data-modal-toggle]');
            modalToggles.forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = document.getElementById(btn.getAttribute('data-modal-toggle'));
                    if(target) {
                        target.classList.toggle('hidden');
                        target.classList.toggle('flex');
                        
                        if(target.classList.contains('hidden')) {
                            target.setAttribute('aria-hidden', 'true');
                        } else {
                            target.removeAttribute('aria-hidden');
                        }
                    }
                });
            });

            // Form Submit for Auto Planification
            const form = document.getElementById('planificationForm');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 mr-2 animate-spin"></i> Traitement...';
                if (window.lucide) lucide.createIcons();

                const payload = {
                    IdMatiere: parseInt(document.getElementById('idMatiere').value),
                    IdProfesseur: document.getElementById('idProfesseur').value ? parseInt(document.getElementById('idProfesseur').value) : null,
                    IdClasse: document.getElementById('idClasse').value ? parseInt(document.getElementById('idClasse').value) : null,
                    IdSemestre: document.getElementById('idSemestre').value ? parseInt(document.getElementById('idSemestre').value) : null,
                    VolumeHours: parseInt(document.getElementById('volumeHours').value),
                    Capacity: parseInt(document.getElementById('capacity').value),
                    TypeCours: document.getElementById('typeCours').value,
                    Mode: document.getElementById('mode').value,
                    Statut: "Cree"
                };

                try {
                    const response = await fetch(`/api/Cours`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if(response.ok) {
                        alert("Cours créé avec succès !");
                        window.location.reload();
                    } else {
                        let errorMsg = "Erreur Inconnue";
                        try {
                            const err = await response.json();
                            errorMsg = err.Message || "Erreur Inconnue";
                            if (err.errors) {
                                errorMsg = Object.entries(err.errors).map(([k, v]) => `${k}: ${v.join(', ')}`).join('\\n');
                            }
                        } catch (e) {
                            errorMsg = "Erreur serveur : " + response.statusText;
                        }
                        alert("Erreur de planification: \\n" + errorMsg);
                    }
                } catch(err) {
                    console.error(err);
                    alert("Erreur réseau ou serveur.");
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="plus" class="w-4 h-4 mr-2"></i> Créer le Cours';
                    if (window.lucide) lucide.createIcons();
                }
            });

            if (window.lucide) lucide.createIcons();
            
            // Load dropdown data
            async function loadDropdownData() {
                try {
                    const [matieresRes, professeursRes, classesRes] = await Promise.all([
                        fetch('/api/Matiere'),
                        fetch('/api/Professeur'),
                        fetch('/api/Classe')
                    ]);
                    
                    if(matieresRes.ok) {
                        const matieres = await matieresRes.json();
                        const select = document.getElementById('idMatiere');
                        select.innerHTML = '<option value="">Sélectionnez une matière</option>';
                        matieres.forEach(m => {
                            select.innerHTML += `<option value="${m.IdMatiere}">${m.NomMatiere} (${m.CodeMatiere})</option>`;
                        });
                    }
                    
                    if(professeursRes.ok) {
                        const profs = await professeursRes.json();
                        const select = document.getElementById('idProfesseur');
                        select.innerHTML = '<option value="">Sélectionnez un professeur</option>';
                        profs.forEach(p => {
                            select.innerHTML += `<option value="${p.IdProfesseur}">${p.Nom} ${p.Prenom}</option>`;
                        });
                    }
                    
                    if(classesRes.ok) {
                        const classes = await classesRes.json();
                        const select = document.getElementById('idClasse');
                        select.innerHTML = '<option value="">Sélectionnez une classe</option>';
                        classes.forEach(c => {
                            select.innerHTML += `<option value="${c.IdClasse}">${c.NomClasse}</option>`;
                        });
                    }
                    
                    const selectSemestre = document.getElementById('idSemestre');
                    selectSemestre.innerHTML = '<option value="">Sélectionnez un semestre</option>';
                    for (let i = 1; i <= 10; i++) {
                        selectSemestre.innerHTML += `<option value="${i}">S${i}</option>`;
                    }
                } catch(e) {
                    console.error("Erreur de chargement des filtres", e);
                }
            }
            
            loadDropdownData();
        });
    </script>
}