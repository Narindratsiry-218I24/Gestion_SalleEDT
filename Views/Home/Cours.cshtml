@model IEnumerable<Gestion_SalleClasseEDT.Models.Cours>
@{
    ViewBag.Title = "Planification des Cours";
}

<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Planification des Cours</h1>
            <p class="text-gray-500 mt-1">Gérez la planification et l'attribution des salles (A-D) aux cours.</p>
        </div>
    </div>

    <!-- Filter Partial -->
    <partial name="_Filter" />

    <!-- Table Partial -->
    <partial name="_CoursTable" model="Model" />

    <!-- CRUD Modal -->
    <div id="crud-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full bg-black/50 backdrop-blur-sm transition-opacity">
        <div class="relative p-4 w-full max-w-md max-h-full m-auto mt-20">
            <div class="relative bg-white rounded-xl shadow-2xl">
                <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t">
                    <h3 class="text-lg font-semibold text-gray-900">
                        Planifier un cours
                    </h3>
                    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-toggle="crud-modal">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <!-- Formulaire de Planification -->
                <form class="p-4 md:p-5" id="planificationForm">
                    <div class="grid gap-4 mb-4 grid-cols-2">
                        <div class="col-span-2">
                            <label for="idMatiere" class="block mb-2 text-sm font-medium text-gray-900">Matière</label>
                            <input type="number" name="idMatiere" id="idMatiere" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="ID de la matière" required="">
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="idProfesseur" class="block mb-2 text-sm font-medium text-gray-900">Professeur</label>
                            <input type="number" name="idProfesseur" id="idProfesseur" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="ID Professeur" required="">
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label for="idClasse" class="block mb-2 text-sm font-medium text-gray-900">Classe</label>
                            <input type="number" name="idClasse" id="idClasse" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="ID Classe" required="">
                        </div>
                        <div class="col-span-2">
                            <label for="debut" class="block mb-2 text-sm font-medium text-gray-900">Date et Heure de Début</label>
                            <input type="datetime-local" name="debut" id="debut" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" required="">
                        </div>
                        <div class="col-span-2">
                            <label for="fin" class="block mb-2 text-sm font-medium text-gray-900">Date et Heure de Fin</label>
                            <input type="datetime-local" name="fin" id="fin" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" required="">
                        </div>
                    </div>
                    <button type="submit" class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                        <i data-lucide="calendar" class="w-4 h-4 mr-2"></i>
                        Planifier avec Auto-Attribution
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Modal Toggles
            const modalToggles = document.querySelectorAll('[data-modal-toggle]');
            modalToggles.forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = document.getElementById(btn.getAttribute('data-modal-toggle'));
                    if(target) {
                        target.classList.toggle('hidden');
                        target.classList.toggle('flex');
                    }
                });
            });

            // Form Submit for Auto Planification
            const form = document.getElementById('planificationForm');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 mr-2 animate-spin"></i> Traitement...';
                if (window.lucide) lucide.createIcons();

                const payload = {
                    IdMatiere: parseInt(document.getElementById('idMatiere').value),
                    IdProfesseur: parseInt(document.getElementById('idProfesseur').value),
                    IdClasse: parseInt(document.getElementById('idClasse').value),
                    TypeCours: "CM",
                    Statut: "planifié",
                    IdSemestre: 1
                };

                const debut = document.getElementById('debut').value;
                const fin = document.getElementById('fin').value;

                try {
                    const response = await fetch(`/api/Cours/PlanifierAuto?debut=${encodeURIComponent(debut)}&fin=${encodeURIComponent(fin)}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if(response.ok) {
                        alert("Cours planifié avec succès ! La salle a été attribuée.");
                        window.location.reload();
                    } else {
                        const err = await response.json();
                        alert("Erreur de planification: " + (err.Message || "Inconnue"));
                    }
                } catch(err) {
                    console.error(err);
                    alert("Erreur réseau ou serveur.");
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="calendar" class="w-4 h-4 mr-2"></i> Planifier avec Auto-Attribution';
                    if (window.lucide) lucide.createIcons();
                }
            });

            if (window.lucide) lucide.createIcons();
        });
    </script>
}