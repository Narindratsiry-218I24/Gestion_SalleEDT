@model Gestion_SalleClasseEDT.Models.ViewModels.CoursListViewModel
@{
    ViewBag.Title = "Cours";
    var mentions = ViewBag.Mentions as List<Gestion_SalleClasseEDT.Models.Mention> ?? new List<Gestion_SalleClasseEDT.Models.Mention>();
    var niveaux = ViewBag.Niveaux as List<Gestion_SalleClasseEDT.Models.Niveau> ?? new List<Gestion_SalleClasseEDT.Models.Niveau>();
    var statuts = ViewBag.Statuts as List<string> ?? new List<string>();
}

<div class="space-y-6 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Gestion des Cours</h1>
            <p class="text-gray-500 mt-1">Filtrez, recherchez et gérez tous les cours de l'établissement.</p>
        </div>
        <div class="flex gap-2">
            <button class="flex items-center gap-2 bg-[#17203A] hover:bg-[#12192B] text-white px-4 py-2 rounded-lg transition-colors font-medium" onclick="openCreateCourseModal()">
                <i data-lucide="plus" class="w-4 h-4"></i> Nouveau Cours
            </button>
        </div>
    </div>

    <!-- Filtres -->
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
        <form method="get" action="@Url.Action("Cours")" id="filterForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Mention</label>
                <select name="mention" id="filterMention" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Toutes les mentions</option>
                    @foreach (var m in mentions)
                    {
                        <option value="@m.NomMention" selected="@(Model?.FilterMention == m.NomMention)">
                            @m.NomMention
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Niveau</label>
                <select name="niveau" id="filterNiveau" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les niveaux</option>
                    <option value="Licence 1" selected="@(Model?.FilterNiveau == "Licence 1")">Licence 1</option>
                    <option value="Licence 2" selected="@(Model?.FilterNiveau == "Licence 2")">Licence 2</option>
                    <option value="Licence 3" selected="@(Model?.FilterNiveau == "Licence 3")">Licence 3</option>
                    <option value="Master 1" selected="@(Model?.FilterNiveau == "Master 1")">Master 1</option>
                    <option value="Master 2" selected="@(Model?.FilterNiveau == "Master 2")">Master 2</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Parcours</label>
                <select name="parcours" id="filterParcours" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les parcours</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Statut</label>
                <select name="statut" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">Tous les statuts</option>
                    @foreach (var s in statuts)
                    {
                        <option value="@s" selected="@(Model?.FilterStatut == s)">
                            @s
                        </option>
                    }
                </select>
            </div>

            <div class="md:col-span-3">
                <label class="block text-xs font-medium text-gray-700 mb-1">Recherche</label>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                    <input type="text" name="search" value="@Model?.SearchTerm" placeholder="Rechercher par matière, code, enseignant..." 
                           class="w-full pl-9 pr-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="w-full bg-[#17203A] hover:bg-[#12192B] text-white px-4 py-2 rounded-lg transition-colors font-medium">
                    <i data-lucide="filter" class="w-4 h-4 inline mr-1"></i> Filtrer
                </button>
                <button type="reset" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors" onclick="resetFilters()">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Résumé des filtres actifs -->
    @if (!string.IsNullOrEmpty(Model?.FilterMention) || !string.IsNullOrEmpty(Model?.FilterNiveau) || !string.IsNullOrEmpty(Model?.FilterParcours))
    {
        <div class="flex flex-wrap gap-2 items-center text-sm text-gray-600 bg-gray-50 p-3 rounded-lg">
            <span class="font-medium text-gray-700">Filtres actifs :</span>
            @if (!string.IsNullOrEmpty(Model.FilterMention))
            {
                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs">
                    Mention : @Model.FilterMention
                    <a href="@Url.Action("Cours", new { niveau = Model.FilterNiveau, parcours = Model.FilterParcours, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-blue-600 hover:text-blue-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterNiveau))
            {
                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs">
                    Niveau : @Model.FilterNiveau
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, parcours = Model.FilterParcours, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-green-600 hover:text-green-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterParcours))
            {
                <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-xs">
                    Parcours : @Model.FilterParcours
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, niveau = Model.FilterNiveau, search = Model.SearchTerm, statut = Model.FilterStatut })" class="ml-1 text-purple-600 hover:text-purple-800">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-xs">
                    Recherche : "@Model.SearchTerm"
                    <a href="@Url.Action("Cours", new { mention = Model.FilterMention, niveau = Model.FilterNiveau, parcours = Model.FilterParcours, statut = Model.FilterStatut })" class="ml-1 text-gray-600 hover:text-gray-800">×</a>
                </span>
            }
        </div>
    }

    <!-- Table des cours -->
    <partial name="_CoursTable" model="Model" />

    <!-- Modal de création de cours -->
    <div id="createCourseModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm">
        <div class="fixed inset-0 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
                <div class="sticky top-0 z-10 flex items-center justify-between p-4 border-b bg-white rounded-t-xl">
                    <h3 class="text-xl font-bold text-[#17203A]">Créer un nouveau cours</h3>
                    <button onclick="closeCreateCourseModal()" class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="p-6">
                    <form id="createCourseForm" class="space-y-4">
                        @Html.AntiForgeryToken()
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Matière <span class="text-red-500">*</span></label>
                                <select id="courseMatiereId" name="IdMatiere" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Sélectionnez une matière</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Professeur</label>
                                <select id="courseProfesseurId" name="IdProfesseur" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Non assigné</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Classe</label>
                                <select id="courseClasseId" name="IdClasse" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Non assignée</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Groupe</label>
                                <select id="courseGroupeId" name="IdGroupe" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Aucun groupe</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Semestre</label>
                                <select id="courseSemestreId" name="IdSemestre" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Sélectionnez un semestre</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Volume Horaire <span class="text-red-500">*</span></label>
                                <input type="number" id="courseVolumeHours" name="VolumeHours" required min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Ex: 60" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Capacité</label>
                                <input type="number" id="courseCapacity" name="Capacity" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Ex: 50" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Type de cours</label>
                                <select id="courseType" name="TypeCours" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="CM">Cours Magistral (CM)</option>
                                    <option value="TD">Travaux Dirigés (TD)</option>
                                    <option value="TP">Travaux Pratiques (TP)</option>
                                    <option value="Projet">Projet</option>
                                    <option value="Seminaire">Séminaire</option>
                                    <option value="Examen">Examen</option>
                                    <option value="Soutenance">Soutenance</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Mode d'enseignement</label>
                                <select id="courseMode" name="Mode" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="Presentiel">Présentiel</option>
                                    <option value="EnLigne">En ligne</option>
                                    <option value="Hybride">Hybride</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Langue</label>
                                <select id="courseLanguage" name="LanguageStr" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="Francais">Français</option>
                                    <option value="Anglais">Anglais</option>
                                    <option value="Malagasy">Malagasy</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 pt-4 border-t">
                            <button type="button" onclick="closeCreateCourseModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                                Annuler
                            </button>
                            <button type="submit" class="px-4 py-2 bg-[#17203A] text-white rounded-lg hover:bg-[#12192B] transition-colors font-medium">
                                <i data-lucide="plus" class="w-4 h-4 inline mr-1"></i> Créer le cours
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Configuration des parcours par mention et niveau
        const parcoursConfig = {
            "Informatique": {
                "Licence": ["DA2I"],
                "Master": ["M2I", "SDIA", "SIGD"]
            },
            "Management": {
                "Licence": ["AES"],
                "Master": ["AE", "MEAS"]
            },
            "Multimédia": {
                "Licence": ["ICM"],
                "Master": ["RPO", "RCPO"]
            }
        };

        // --- Filtres dépendants ---
        document.addEventListener('DOMContentLoaded', function() {
            const mentionSelect = document.getElementById('filterMention');
            const niveauSelect = document.getElementById('filterNiveau');
            const parcoursSelect = document.getElementById('filterParcours');

            function updateParcoursOptions() {
                const mention = mentionSelect.value;
                const niveau = niveauSelect.value;
                
                parcoursSelect.innerHTML = '<option value="">Tous les parcours</option>';
                
                if (mention && niveau) {
                    const niveauType = niveau.startsWith("Licence") ? "Licence" : "Master";
                    const parcours = parcoursConfig[mention]?.[niveauType] || [];
                    
                    parcours.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p;
                        opt.textContent = p;
                        parcoursSelect.appendChild(opt);
                    });

                    // Sélectionner le parcours actuel s'il existe
                    const currentParcours = '@Model?.FilterParcours';
                    if (currentParcours) {
                        parcoursSelect.value = currentParcours;
                    }
                }
            }

            mentionSelect.addEventListener('change', updateParcoursOptions);
            niveauSelect.addEventListener('change', updateParcoursOptions);

            // Initialiser les parcours si mention et niveau sont déjà sélectionnés
            if (mentionSelect.value && niveauSelect.value) {
                updateParcoursOptions();
            }
        });

        // --- Reset des filtres ---
        function resetFilters() {
            document.getElementById('filterMention').value = '';
            document.getElementById('filterNiveau').value = '';
            document.getElementById('filterParcours').innerHTML = '<option value="">Tous les parcours</option>';
            document.querySelector('input[name="search"]').value = '';
            document.querySelector('select[name="statut"]').value = '';
            document.getElementById('filterForm').submit();
        }

        // --- Modal de création de cours ---
        function openCreateCourseModal() {
            document.getElementById('createCourseModal').classList.remove('hidden');
            loadFormData();
        }

        function closeCreateCourseModal() {
            document.getElementById('createCourseModal').classList.add('hidden');
            document.getElementById('createCourseForm').reset();
        }

        async function loadFormData() {
            try {
                const [matieres, professeurs, classes, semestres] = await Promise.all([
                    fetch('/api/Matiere').then(r => r.json()),
                    fetch('/api/Professeur').then(r => r.json()),
                    fetch('/api/Classe').then(r => r.json()),
                    fetch('/api/RefSemestre').then(r => r.json())
                ]);

                const matiereSelect = document.getElementById('courseMatiereId');
                matiereSelect.innerHTML = '<option value="">Sélectionnez une matière</option>';
                matieres.forEach(m => {
                    matiereSelect.innerHTML += `<option value="${m.IdMatiere}">${m.NomMatiere} (${m.CodeMatiere})</option>`;
                });

                const profSelect = document.getElementById('courseProfesseurId');
                profSelect.innerHTML = '<option value="">Non assigné</option>';
                professeurs.forEach(p => {
                    profSelect.innerHTML += `<option value="${p.IdProfesseur}">${p.Prenom} ${p.Nom}</option>`;
                });

                const classeSelect = document.getElementById('courseClasseId');
                classeSelect.innerHTML = '<option value="">Non assignée</option>';
                classes.forEach(c => {
                    classeSelect.innerHTML += `<option value="${c.IdClasse}">${c.NomClasse}</option>`;
                });

                const semestreSelect = document.getElementById('courseSemestreId');
                semestreSelect.innerHTML = '<option value="">Sélectionnez un semestre</option>';
                semestres.forEach(s => {
                    semestreSelect.innerHTML += `<option value="${s.IdRefSemestre}">${s.CodeSemestre}</option>`;
                });

                // Charger les groupes pour la classe sélectionnée
                document.getElementById('courseClasseId').addEventListener('change', async function() {
                    const classeId = this.value;
                    const groupeSelect = document.getElementById('courseGroupeId');
                    groupeSelect.innerHTML = '<option value="">Aucun groupe</option>';
                    
                    if (classeId) {
                        try {
                            const groupes = await fetch(`/api/Groupe/ByClasse/${classeId}`).then(r => r.json());
                            groupes.forEach(g => {
                                groupeSelect.innerHTML += `<option value="${g.Id}">${g.Name}</option>`;
                            });
                        } catch (e) {
                            console.warn('Erreur chargement groupes:', e);
                        }
                    }
                });

                // Valeurs par défaut
                document.getElementById('courseVolumeHours').value = '';
                document.getElementById('courseCapacity').value = '';
            } catch (e) {
                console.error('Erreur chargement données:', e);
            }
        }

        // --- Soumission du formulaire de création ---
        document.getElementById('createCourseForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const payload = {
                IdMatiere: parseInt(formData.get('IdMatiere')),
                IdProfesseur: formData.get('IdProfesseur') ? parseInt(formData.get('IdProfesseur')) : null,
                IdClasse: formData.get('IdClasse') ? parseInt(formData.get('IdClasse')) : null,
                IdGroupe: formData.get('IdGroupe') ? parseInt(formData.get('IdGroupe')) : null,
                IdSemestre: formData.get('IdSemestre') ? parseInt(formData.get('IdSemestre')) : null,
                VolumeHours: parseInt(formData.get('VolumeHours')),
                Capacity: formData.get('Capacity') ? parseInt(formData.get('Capacity')) : 0,
                TypeCours: formData.get('TypeCours') || 'CM',
                Mode: formData.get('Mode') || 'Presentiel',
                LanguageStr: formData.get('LanguageStr') || 'Francais',
                Statut: 'Cree'
            };

            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin inline mr-1"></i> Création...';

            try {
                const response = await fetch('/api/Cours', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert('✅ Cours créé avec succès !');
                    window.location.reload();
                } else {
                    const error = await response.json();
                    alert('❌ Erreur: ' + (error.Message || 'Erreur inconnue'));
                }
            } catch (err) {
                alert('❌ Erreur réseau: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="plus" class="w-4 h-4 inline mr-1"></i> Créer le cours';
            }
        });

        // --- Initialisation des icônes ---
        if (window.lucide) {
            lucide.createIcons();
        }
    </script>
}   