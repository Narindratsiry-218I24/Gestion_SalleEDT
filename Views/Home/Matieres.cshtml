@{
    ViewBag.Title = "Matières";
}

<div class="space-y-8 animate-in fade-in zoom-in-95 duration-500 relative h-full flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#17203A] tracking-tight">Gestion des Matières</h1>
            <p class="text-gray-500 mt-1">Gérez le catalogue des matières, crédits et volumes horaires.</p>
        </div>
        <div class="flex gap-2">
            <button type="button" onclick="app.exportTablePdf('Matieres')" class="h-10 inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-red-600 shadow-sm hover:bg-red-50" title="Exporter PDF">
                <i data-lucide="file-text" class="h-4 w-4"></i> PDF
            </button>
            <button type="button" onclick="app.exportTableExcel('Matieres')" class="h-10 inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white px-4 text-sm font-medium text-green-600 shadow-sm hover:bg-green-50" title="Exporter Excel">
                <i data-lucide="file-spreadsheet" class="h-4 w-4"></i> Excel
            </button>
            <button type="button" class="flex items-center gap-2 bg-[#17203A] hover:bg-[#12192B] text-white px-4 py-2 rounded-lg transition-colors font-medium h-10" onclick="openCreateModal()">
                <i data-lucide="plus" class="w-4 h-4"></i> Ajouter une Matière
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex-1 flex flex-col">
        <div class="p-6 border-b border-gray-50 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <h3 class="font-bold text-lg text-[#17203A] m-0">Catalogue</h3>
            <div class="relative w-full md:w-[300px]">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                <input type="text" id="searchMatieres" oninput="filterMatieres()" placeholder="Rechercher par nom ou code..." class="w-full pl-9 pr-3 h-10 bg-gray-50 border border-gray-200 text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-[#17203A]/20" />
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100">
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Code</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Nom de la Matière</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm">Filière / Semestre</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm text-center">Crédits</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm text-center">Volume (h)</th>
                        <th class="py-4 px-6 font-bold text-gray-500 text-sm text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100" id="matieresTableBody">
                    <tr><td colspan="6" class="text-center py-8 text-gray-500"><i data-lucide="loader-2" class="w-5 h-5 animate-spin mx-auto"></i></td></tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-gray-500" id="paginationInfo">
                Affichage de <span id="startItem">0</span> à <span id="endItem">0</span> sur <span id="totalItems">0</span> matières
            </div>
            <div class="flex items-center gap-2" id="paginationControls">
                <button id="prevPageBtn" onclick="changePage(-1)" disabled class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-medium text-gray-500 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    Précédent
                </button>
                <span class="text-sm font-medium text-gray-700" id="currentPageDisplay">Page 1</span>
                <button id="nextPageBtn" onclick="changePage(1)" disabled class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-medium text-gray-500 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    Suivant
                </button>
            </div>
            <div class="flex items-center gap-2">
                <label for="pageSizeSelect" class="text-sm text-gray-500">Lignes par page :</label>
                <select id="pageSizeSelect" onchange="changePageSize()" class="border border-gray-300 rounded-md text-sm h-9 px-2 bg-white focus:outline-none focus:ring-2 focus:ring-[#17203A]/20">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Modal pour ajouter/modifier une matière -->
    <div id="matiere-modal" tabindex="-1" aria-hidden="true" class="fixed inset-0 z-[100] hidden overflow-y-auto">
        <!-- Overlay de fond -->
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" onclick="closeMatiereModal()"></div>

        <!-- Conteneur du modal - centré -->
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto">
                <!-- En-tête -->
                <div class="sticky top-0 z-10 flex items-center justify-between p-4 md:p-5 border-b rounded-t bg-white">
                    <h3 class="text-xl font-bold text-gray-900" id="modalTitle">
                        Ajouter une Matière
                    </h3>
                    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 inline-flex justify-center items-center flex-shrink-0" onclick="closeMatiereModal()">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- Corps du modal -->
                <div class="p-4 md:p-5">
                    <partial name="_MatiereForm" />
                </div>
            </div>
        </div>
    </div>
</div>  

@section Scripts {
    <script>
        let allMatieres = [];
        let filteredMatieres = [];
        let currentPage = 1;
        let pageSize = 10;

        async function loadMatieres() {
            try {
                const matieres = await app.apiGet('/api/Matiere');
                allMatieres = matieres || [];
                filteredMatieres = [...allMatieres];
                currentPage = 1;
                renderMatieres();
            } catch (err) {
                document.getElementById("matieresTableBody").innerHTML = `<tr><td colspan="6" class="text-center py-8 text-red-600 font-bold">Erreur: ${app.escapeHtml(err.message)}</td></tr>`;
                updatePaginationInfo(0);
            }
        }

        function renderMatieres() {
            const tbody = document.getElementById("matieresTableBody");
            tbody.innerHTML = "";

            if (filteredMatieres.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">Aucune matière trouvée.</td></tr>';
                updatePaginationInfo(0);
                return;
            }

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, filteredMatieres.length);
            const pageData = filteredMatieres.slice(startIndex, endIndex);

            pageData.forEach(function(m) {
                const id = m.IdMatiere;
                const nom = app.escapeHtml(m.NomMatiere || "N/A");
                const code = app.escapeHtml(m.CodeMatiere || "N/A");
                const credit = m.Credit || 0;
                const volume = m.VolumeHoraire || 0;
                
                const filiereStr = app.escapeHtml(m.Filiere?.NomFiliere || "Non assignée");
                const semestreStr = app.escapeHtml(m.RefSemestre?.CodeSemestre || "");

                const tr = document.createElement("tr");
                tr.className = "hover:bg-gray-50/50 transition-colors group";
                tr.innerHTML = `
                    <td class="py-4 px-6"><span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider">${code}</span></td>
                    <td class="py-4 px-6 font-semibold text-[#17203A]">${nom}</td>
                    <td class="py-4 px-6 text-sm text-gray-600">
                        <div class="flex flex-col">
                            <span>${filiereStr}</span>
                            <span class="text-xs text-gray-400">${semestreStr}</span>
                        </div>
                    </td>
                    <td class="py-4 px-6 text-center font-medium">${credit}</td>
                    <td class="py-4 px-6 text-center font-medium">${volume}h</td>
                    <td class="py-4 px-6 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button class="p-1.5 text-blue-600 hover:bg-blue-50 rounded transition-colors" onclick="openEditModal(${id})" title="Modifier">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </button>
                            <button class="p-1.5 text-red-600 hover:bg-red-50 rounded transition-colors" onclick="deleteMatiere(${id})" title="Supprimer">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updatePaginationInfo(filteredMatieres.length);
            
            if (window.lucide) lucide.createIcons();
        }

        function updatePaginationInfo(total) {
            const totalItems = total || filteredMatieres.length;
            const startItem = totalItems === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            const endItem = Math.min(currentPage * pageSize, totalItems);
            
            document.getElementById('startItem').textContent = startItem;
            document.getElementById('endItem').textContent = endItem;
            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('currentPageDisplay').textContent = `Page ${currentPage}`;
            
            const totalPages = Math.ceil(totalItems / pageSize) || 1;
            document.getElementById('prevPageBtn').disabled = currentPage <= 1;
            document.getElementById('nextPageBtn').disabled = currentPage >= totalPages || totalItems === 0;
        }

        function changePage(delta) {
            const totalPages = Math.ceil(filteredMatieres.length / pageSize) || 1;
            const newPage = currentPage + delta;
            if (newPage >= 1 && newPage <= totalPages) {
                currentPage = newPage;
                renderMatieres();
            }
        }

        function changePageSize() {
            pageSize = parseInt(document.getElementById('pageSizeSelect').value);
            currentPage = 1;
            renderMatieres();
        }

        function filterMatieres() {
            const query = document.getElementById("searchMatieres").value.toLowerCase().trim();
            if (!query) {
                filteredMatieres = [...allMatieres];
            } else {
                filteredMatieres = allMatieres.filter(m => {
                    const nom = (m.NomMatiere || "").toLowerCase();
                    const code = (m.CodeMatiere || "").toLowerCase();
                    return nom.includes(query) || code.includes(query);
                });
            }
            currentPage = 1;
            renderMatieres();
        }

        // --- Modals Logic ---
        function toggleModal(show) {
            const modal = document.getElementById('matiere-modal');
            if (show) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        function closeMatiereModal() {
            toggleModal(false);
            const form = document.getElementById('matiereForm');
            if (form) form.reset();
            document.getElementById('idMatiere').value = "0";
        }

        async function openCreateModal() {
            document.getElementById('modalTitle').innerText = "Ajouter une Matière";
            document.getElementById('idMatiere').value = "0";
            const form = document.getElementById('matiereForm');
            if (form) form.reset();
            await loadMatiereFormData();
            toggleModal(true);
        }

        async function openEditModal(id) {
            document.getElementById('modalTitle').innerText = "Modifier la Matière";
            const matiere = allMatieres.find(m => m.IdMatiere === id);
            if (!matiere) return;

            await loadMatiereFormData();

            document.getElementById('idMatiere').value = matiere.IdMatiere;
            document.getElementById('codeMatiere').value = matiere.CodeMatiere || "";
            document.getElementById('nomMatiere').value = matiere.NomMatiere || "";
            
            // Remplir Mention et Niveau
            const idF = matiere.IdFiliere;
            const filiereObj = filieresList.find(f => f.IdFiliere === idF);
            if(filiereObj && filiereObj.Mention) {
                const nomMention = filiereObj.Mention.NomMention || "";
                let mentionStatic = "";
                if(nomMention.toLowerCase().includes("informatique")) mentionStatic = "Informatique";
                else if(nomMention.toLowerCase().includes("management")) mentionStatic = "Management";
                else if(nomMention.toLowerCase().includes("multim")) mentionStatic = "Multimédia";
                if (mentionStatic) {
                    document.getElementById('mentionStatic').value = mentionStatic;
                }
            }
            
            const idRS = matiere.IdRefSemestre;
            const semestreObj = semestresList.find(s => s.IdRefSemestre === idRS);
            if(semestreObj && semestreObj.Niveau) {
                const codeNiv = (semestreObj.Niveau.CodeNiveau || "").trim().toUpperCase();
                let nivStatic = "";
                if(codeNiv === "L1") nivStatic = "Licence 1";
                else if(codeNiv === "L2") nivStatic = "Licence 2";
                else if(codeNiv === "L3") nivStatic = "Licence 3";
                else if(codeNiv === "M1") nivStatic = "Master 1";
                else if(codeNiv === "M2") nivStatic = "Master 2";
                if (nivStatic) {
                    document.getElementById('niveauStatic').value = nivStatic;
                }
            }

            updateParcoursOptions();
            
            document.getElementById('idFiliere').value = idF || "";
            document.getElementById('idRefSemestre').value = idRS || "";
            document.getElementById('credit').value = matiere.Credit || "";
            document.getElementById('volumeHoraire').value = matiere.VolumeHoraire || "";
            document.getElementById('idProfesseurResponsable').value = matiere.IdProfesseurResponsable || "";

            toggleModal(true);
        }

        async function deleteMatiere(id) {
            if (!confirm("Êtes-vous sûr de vouloir supprimer cette matière ?")) return;
            try {
                await app.apiDelete(`/api/Matiere/${id}`);
                loadMatieres();
            } catch (err) {
                alert("Erreur lors de la suppression : " + err.message);
            }
        }

        function onMatiereSaved(res) {
            loadMatieres();
            closeMatiereModal();
        }

        document.addEventListener("DOMContentLoaded", function() {
            loadMatieres();
        });
    </script>
}