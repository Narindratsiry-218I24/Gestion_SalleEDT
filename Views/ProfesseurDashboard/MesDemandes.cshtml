@model Gestion_SalleClasseEDT.Controllers.ProfesseurDashboardViewModel
@{
    ViewData["Title"] = "Mes Demandes";
    var email = Context.Request.Query["email"].ToString();
    var prof = Model.Professeur;
}

<div class="prof-dash">
    <div class="section-header">
        <h2 class="section-title-h2">Mes Demandes d'Emploi du Temps</h2>
        <a href="@Url.Action("NouvelleDemande", "ProfesseurDashboard", new { email })" class="btn btn-primary" style="background:#17203A; color:white; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-decoration: none;">
            + Nouvelle demande
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: #d1fae5; color: #065f46; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-weight: 600;">
            @TempData["Success"]
        </div>
    }

    <div class="card-base">
        @if (Model.MesDemandes != null && Model.MesDemandes.Any())
        {
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #f1f5f9; text-align: left;">
                        <th style="padding: 1rem 0; font-size: 0.85rem; color: #64748b;">Type</th>
                        <th style="padding: 1rem 0; font-size: 0.85rem; color: #64748b;">Matière / Cours</th>
                        <th style="padding: 1rem 0; font-size: 0.85rem; color: #64748b;">Date Souhaitée</th>
                        <th style="padding: 1rem 0; font-size: 0.85rem; color: #64748b;">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var demande in Model.MesDemandes)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 1rem 0; font-weight: 600; font-size: 0.9rem; color: #17203A;">@demande.TypeDemande</td>
                            <td style="padding: 1rem 0; font-size: 0.9rem;">
                                @(demande.Matiere?.NomMatiere ?? demande.Cours?.Matiere?.NomMatiere ?? "Non spécifié")
                            </td>
                            <td style="padding: 1rem 0; font-size: 0.9rem; color: #64748b;">
                                @(demande.DateSouhaitee?.ToString("dd/MM/yyyy") ?? "Aucune") <br/>
                                <small>@(demande.HeureDebutSouhaitee?.ToString(@"hh\:mm") ?? "") - @(demande.HeureFinSouhaitee?.ToString(@"hh\:mm") ?? "")</small>
                            </td>
                            <td style="padding: 1rem 0;">
                                <span style="display:inline-block; padding:3px 10px; border-radius:20px; font-size:0.75rem; font-weight:700; background:@(demande.Statut=="en_attente_admin"?"#fef3c7":(demande.Statut=="acceptee"?"#d1fae5":"#fee2e2")); color:@(demande.Statut=="en_attente_admin"?"#92400e":(demande.Statut=="acceptee"?"#065f46":"#991b1b"));">
                                    @demande.Statut.Replace("_", " ")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state" style="padding: 3rem 1rem;">
                <i data-lucide="inbox" class="h-12 w-12" style="margin: 0 auto 1rem; opacity: 0.4;"></i>
                <h3 style="font-weight: 700; color: #475569;">Aucune demande en cours</h3>
                <p style="font-size: 0.9rem; color: #94a3b8; margin-top: 0.5rem;">Vous n'avez soumis aucune demande de modification d'emploi du temps.</p>
            </div>
        }
    </div>
</div>
