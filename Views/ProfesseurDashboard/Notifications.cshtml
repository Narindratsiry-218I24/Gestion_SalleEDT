@model Gestion_SalleClasseEDT.Controllers.ProfesseurDashboardViewModel
@{
    ViewData["Title"] = "Mes Notifications";
    var email = Context.Request.Query["email"].ToString();
    var notifications = ViewBag.ToutesNotifications as List<Gestion_SalleClasseEDT.Models.Notification>;
}

<div class="px-4 py-6 max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-[#17203A]">Centre de Notifications</h1>
            <p class="text-gray-500 text-sm mt-1">Gérez vos messages, alertes et historiques</p>
        </div>
        <button id="markAllReadPageBtn" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-semibold hover:bg-gray-200 transition-colors flex items-center gap-2">
            <i data-lucide="check-square" class="w-4 h-4"></i>
            Tout marquer comme lu
        </button>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        @if (notifications != null && notifications.Any())
        {
            <div class="divide-y divide-gray-100" id="pageNotifList">
                @foreach (var n in notifications)
                {
                    string bgClass = n.EstLue ? "bg-white" : "bg-blue-50/30";
                    string icon = "info";
                    string colorClass = "text-blue-500 bg-blue-50";

                    var typeStr = (n.Type ?? "").ToLower();
                    if (typeStr == "success" || typeStr == "succes") { icon = "check-circle"; colorClass = "text-green-500 bg-green-50"; }
                    else if (typeStr == "warning") { icon = "alert-triangle"; colorClass = "text-orange-500 bg-orange-50"; }
                    else if (typeStr == "danger" || typeStr == "erreur") { icon = "alert-circle"; colorClass = "text-red-500 bg-red-50"; }

                    <div class="p-5 flex gap-4 transition-colors hover:bg-gray-50 @bgClass group">
                        <div class="flex-shrink-0 mt-1 w-10 h-10 rounded-full @colorClass flex items-center justify-center">
                            <i data-lucide="@icon" class="w-5 h-5"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between">
                                <h3 class="text-base font-bold text-gray-900 @(n.EstLue ? "text-opacity-80" : "")">
                                    @n.Titre
                                    @if (!n.EstLue)
                                    {
                                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800 uppercase">Nouveau</span>
                                    }
                                </h3>
                                <div class="text-xs text-gray-400 font-medium whitespace-nowrap ml-4">
                                    @n.DateCreation.ToString("dd MMM yyyy, HH:mm")
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 mt-1 @(n.EstLue ? "text-opacity-80" : "")">@n.Message</p>
                            
                            @if (!string.IsNullOrEmpty(n.Lien))
                            {
                                <div class="mt-3">
                                    <a href="@n.Lien" class="inline-flex items-center gap-1 text-sm font-semibold text-[#5C8ABF] hover:text-[#4d7daf] bg-blue-50 px-3 py-1.5 rounded-lg transition-colors">
                                        Voir les détails <i data-lucide="arrow-right" class="w-4 h-4"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="flex-shrink-0 flex items-start ml-4">
                            @if (!n.EstLue)
                            {
                                <button onclick="markNotifReadPage(@n.IdNotification, this)" class="text-gray-400 hover:text-[#5C8ABF] p-2 rounded-lg hover:bg-blue-50 transition-colors" title="Marquer comme lu">
                                    <i data-lucide="check" class="w-5 h-5"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-12 text-center flex flex-col items-center">
                <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mb-4">
                    <i data-lucide="inbox" class="w-8 h-8 text-gray-300"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-700">Aucune notification</h3>
                <p class="text-gray-500 mt-1 max-w-sm">Vous êtes à jour. Tous vos messages et alertes s'afficheront ici.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.lucide) {
                lucide.createIcons();
            }

            document.getElementById('markAllReadPageBtn')?.addEventListener('click', async () => {
                try {
                    await fetch(`/api/Notification/mark-all-read?email=${encodeURIComponent('@email')}`, { method: 'POST' });
                    window.location.reload();
                } catch(err) { console.error(err); }
            });
        });

        async function markNotifReadPage(id, btn) {
            try {
                await fetch(`/api/Notification/mark-read/${id}`, { method: 'POST' });
                const row = btn.closest('.flex.gap-4');
                row.classList.remove('bg-blue-50/30');
                row.classList.add('bg-white');
                const badge = row.querySelector('.bg-blue-100');
                if (badge) badge.remove();
                btn.remove();
            } catch(err) { console.error(err); }
        }
    </script>
}