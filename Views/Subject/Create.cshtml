@model Gestion_SalleClasseEDT.Models.Subject
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mentionOptions = new[] {
        new { Id = 1, Name = "Informatique" },
        new { Id = 2, Name = "Management" },
        new { Id = 3, Name = "Multimédia" }
    };
    var niveauOptions = new[] {
        new { Id = 1, Name = "Licence 1" },
        new { Id = 2, Name = "Licence 2" },
        new { Id = 3, Name = "Licence 3" },
        new { Id = 4, Name = "Master 1" },
        new { Id = 5, Name = "Master 2" }
    };
}

<h2>Créer une matière</h2>

<form method="post" action="/api/Subject">
    <div>
        <label>Code *</label>
        <input name="Code" required />
    </div>
    <div>
        <label>Label *</label>
        <input name="Label" required />
    </div>
    <div>
        <label>Credits *</label>
        <input name="Credits" type="number" required />
    </div>
    <div>
        <label>Hours *</label>
        <input name="Hours" type="number" required />
    </div>
    <div>
        <label>Mention *</label>
        <select name="MentionId" id="mentionSelect" required>
            <option value="">-- Sélectionner --</option>
            @foreach (var m in mentionOptions)
            {
                <option value="@m.Id">@m.Name</option>
            }
        </select>
    </div>
    <div>
        <label>Niveau *</label>
        <select name="NiveauId" id="niveauSelect" required>
            <option value="">-- Sélectionner --</option>
            @foreach (var n in niveauOptions)
            {
                <option value="@n.Id">@n.Name</option>
            }
        </select>
    </div>
    <div>
        <label>Parcours *</label>
        <select name="Parcours" id="parcoursSelect" required>
            <option value="">-- Sélectionner --</option>
        </select>
    </div>
    <div>
        <label>Semestre *</label>
        <select name="SemestreId" id="semestreSelect" required>
            <option value="">-- Sélectionner --</option>
        </select>
    </div>
    <div>
        <button type="submit">Créer</button>
    </div>
</form>

<script>
    const parcoursMap = {
        1: { licence: ["DA2I"], master: ["M2I", "SDIA", "SIGD"] },
        2: { licence: ["AES"], master: ["AE", "MEAS"] },
        3: { licence: ["ICM"], master: ["RPO", "RCPO"] }
    };
    const licenceIds = [1, 2, 3];
    const masterIds = [4, 5];
    function updateParcours() {
        const mentionId = parseInt(document.getElementById('mentionSelect').value);
        const niveauId = parseInt(document.getElementById('niveauSelect').value);
        const select = document.getElementById('parcoursSelect');
        select.innerHTML = '<option value="">-- Sélectionner --</option>';
        if (!mentionId || !niveauId) return;
        const map = parcoursMap[mentionId];
        if (!map) return;
        const type = licenceIds.includes(niveauId) ? 'licence' : (masterIds.includes(niveauId) ? 'master' : null);
        if (!type) return;
        const options = map[type] || [];
        options.forEach(o => {
            const opt = document.createElement('option');
            opt.value = o;
            opt.text = o;
            select.appendChild(opt);
        });
    }
    document.getElementById('mentionSelect').addEventListener('change', updateParcours);
    document.getElementById('niveauSelect').addEventListener('change', updateParcours);

    // Load semestres via API (assumes /api/Semestre returns [{id, label}])
    fetch('/api/Semestre')
        .then(r => r.json())
        .then(data => {
            const semSelect = document.getElementById('semestreSelect');
            data.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.text = s.label;
                semSelect.appendChild(opt);
            });
        })
        .catch(() => console.warn('Unable to load semestres'));
</script>
