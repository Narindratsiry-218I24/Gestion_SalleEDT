@model Gestion_SalleClasseEDT.Models.Subject
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Créer une matière";
}

<div class="max-w-2xl mx-auto py-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Créer une matière</h1>
            <p class="text-sm text-gray-500 mt-2">Ajoutez une nouvelle matière au système.</p>
        </div>
        <a href="/Subject" class="inline-flex items-center gap-2 rounded-xl bg-white border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 hover:text-blue-600 transition-all">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Retour
        </a>
    </div>

    <form method="post" action="/api/Subject" class="bg-white rounded-3xl shadow-xl shadow-gray-200/40 border border-gray-100 overflow-hidden p-8 space-y-6">
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Code de la matière</label>
            <input name="Code" class="w-full rounded-xl bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all" placeholder="Ex: INFO-101" required />
        </div>
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Libellé</label>
            <input name="Label" class="w-full rounded-xl bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all" placeholder="Ex: Algorithmique et Structures de données" required />
        </div>
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Crédits ECTS</label>
            <input name="Credits" type="number" min="1" max="30" class="w-full rounded-xl bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all" placeholder="Ex: 5" required />
        </div>
        
        <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
            <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-8 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/30 transition-all hover:bg-blue-700">
                <i data-lucide="save" class="h-4 w-4 mr-2"></i> Créer la matière
            </button>
        </div>
    </form>
</div>
